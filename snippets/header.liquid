<div class="header-mobile d-md-none">
  <div class="d-flex align-items-center">
    <div class="btn-mobile_vertical_menu"><i class="zmdi zmdi-sort-amount-asc"></i></div>

    <div class="mobile_logo text-center">
      {% if section.settings.logo_mobile %}
        <a href="/" class="site-header__logo-image img-fluid">
          {% capture logo_alt %}{{ section.settings.logo_mobile.alt | default: shop.name }}{% endcapture %}
          <img class="lazyload js" data-src="{{ section.settings.logo_mobile | img_url: '300x' }}" alt="{{ logo_alt | escape }}" style="max-width: {{ section.settings.logo_max_width }}px">
        </a>
      {% else %}
        <a class="site-header__logo-link" href="/" itemprop="url">{{ shop.name }}</a>
      {% endif %}
    </div>

    <div id="mobile_search">
      {% include 'nov-formsearch-inline' %}
    </div>

    <div class="d-flex justify-content-end">
      <div id="show-megamenu" class="item-mobile-top"><i class="zmdi zmdi-view-headline"></i></div>
    </div>
  </div>
</div>

<div class="header-template d-none d-md-block">
  {% if section.settings.show_header_top == true %}
    <div class="header_top">
      <div class="container">
        <div class="d-flex align-items-center justify-content-between">
          <div class="group-account d-flex align-items-center">
            <i class="zmdi zmdi-account"></i>
            <div class="header_myaccount">
              <a class="register" href="{{ shop.secure_url }}/account/register" rel="nofollow" title="{{ 'customer.register.submit_register' | t }}">
                <span>{{ 'customer.register.submit_register' | t }}</span>
              </a>
              {{ 'layout.customer.or' | t }}
              <a class="login" href="{{ shop.secure_url }}/account/login" rel="nofollow" title="{{ 'customer.login.log_in' | t }}">
                <span>{{ 'customer.login.log_in' | t }}</span>
              </a>
            </div>
          </div>
          <div class="dropdown_currency">
            {% if settings.show_multiple_currencies == true %}
              {% include "nov-block-currency" type: 'dropdown' %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="site-header_items">
    <div class="container">
      <div class="site-hd">
        <div class="row align-items-center">
          <div class="contentsticky_logo col-xl-3 col-lg-3 col-md-3">
            {% if template.name == 'index' %}
              <h1 class="h2 site-header__logo" itemscope itemtype="http://schema.org/Organization">
            {% else %}
              <div class="h2 site-header__logo" itemscope itemtype="http://schema.org/Organization">
            {% endif %}
          
            {% if section.settings.logo %}
              <a href="/" itemprop="url" class="site-header__logo-image" style="max-width: {{ section.settings.logo_max_width }}px">
                {% capture logo_alt %}{{ section.settings.logo.alt | default: shop.name }}{% endcapture %}
                <img class="lazyload js img-fluid" data-src="{{ section.settings.logo | img_url: '300x' }}" alt="{{ logo_alt | escape }}">
              </a>
            {% else %}
              <a class="site-header__logo-link" href="/" itemprop="url">{{ shop.name }}</a>
            {% endif %}
          
            {% if template.name == 'index' %}
              </h1>
            {% else %}
              </div>
            {% endif %}
          </div>
          <div class="contentsticky_group col-xl-9 col-lg-9 col-md-9">
            <div class="site-header__icons-wrapper style_2">
              <div class="d-flex align-items-center">
                <div class="search_inline">
                  <div class="site_search d-flex align-items-center justify-content-end">
                    <div class="site-header__search">
                      <div id="search_widget" class="site_header__search">
                        {% include 'nov-formsearch-inline' %}
                        {% include 'nov-search-autocomplete' %}
                      </div>
                    </div>
                  </div>
                </div>
                <div class="block_hotline d-flex align-items-center justify-content-end justify-content-md-start">
                  {% if section.settings.phone_icon != blank %}
                    <div class="phone_icon">
                      <img class="lazyload" data-src="{{ section.settings.phone_icon | img_url: '100x' }}" alt="Phone Support">
                    </div>
                  {% endif %}
                  {% if section.settings.phone_number != blank %}
                    <div class="content">
                      {% if section.settings.phone_number != blank %}
                        <p class="phone_number">{{ section.settings.phone_number }}</p>
                      {% endif %}
                      {% if section.settings.phone_support != blank %}
                        <p class="phone_support">{{ section.settings.phone_support }}</p>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
                <div class="group_items">
                  <div id="swym-anchor" class="swym-swym-heart">
                    <a href="/pages/page-wishlist">
                      <i class="swym-icon"></i>
                    </a>
                  </div>
                  <div id="cart_block">
                    <div class="site-header__cart style_2 d-flex align-items-center">
                      <span class="site-header__cart-icon"></span>
                      <div class="site-header__cart-count">
                        <span id="CartCount">{{ cart.item_count }}</span>
                      </div>
                    </a>
                    <div id="_desktop_cart"><div id="cart-info"></div></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="site-header_menu">
    <div class="container">
      <div class="site-hm d-flex align-items-center">
        <div class="ver_fro">
          <div class="vertical_dropdown{% if template.name == 'index' %} active{% endif %}">
            <div class="title_vertical position-relative d-flex align-items-center{% if template.name != 'index' %} template-{% endif %}">
              <i class="zmdi zmdi-format-subject"></i>
              <span class="sidebar-menu_title">{{ 'layout.header.sidebarmenu_title' | t }}</span>
            </div>
          </div>
          <div id="_desktop_vertical_menu" class="vertical_menu has-showmore"
            data-count_showmore="{{ section.settings.show_more }}"
            data-count_showmore_tablet="{{ section.settings.show_more_tablet }}"
            data-textshowmore="{{ 'layout.verticalmenu.show_more' | t }}"
            data-textless="Show Less">
            <ul class="site-nav" id="SiteNav">
              {% assign count_showmore = section.settings.show_more | plus: 0 %}
              {% for link in linklists[section.settings.vertical_menu].links %}
                {% assign isMega = false %}
                {% assign isIcon = false %}
                {% assign class_hidden = '' %}
                {%- assign three_level_nav = false -%}
                {%- assign child_list_handle = link.title | handleize -%}

                {% if linklists[child_list_handle].links != blank %}
                  {% for childlink in linklists[child_list_handle].links %}
                    {% assign grand_child_list_handle = childlink.title | handleize %}
                    {% if linklists[grand_child_list_handle].links != blank %}
                      {%- assign three_level_nav = true -%}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% if section.settings.novmenu_enable %}
                  {% if section.settings.show_icons %}
                    {% for block in section.blocks %}
                      {% assign menuItem = link.title %}
                      {% if block.settings.novmenu_item contains menuItem %}
                        {% include 'nov-megamenu', class_hidden: class_hidden %}
                        {% assign isMega = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                {% endif %}

                {% if section.settings.show_icons %}
                  {% for block in section.blocks %}
                    {% assign menuItem = link.title %}
                    {% if block.settings.name_item contains menuItem %}
                      {% include 'nov-iconmenu', class_hidden: class_hidden %}
                      {% assign isIcon = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% if isMega == false and isIcon == false %}
                  {% if linklists[child_list_handle].links != blank %}
                    <li class="site-nav--has-dropdown {% if link.active %} site-nav--active{% endif %}{{ class_hidden }}" aria-controls="SiteNavLabel-{{ child_list_handle }}">
                      <a href="{{ link.url }}" class="site-nav__link site-nav__link--main">
                        {{ link.title }}
                        <span class="d-lg-none show_sub"><i class="zmdi zmdi-plus-square"></i></span>
                      </a>
                      <div class="site-nav__dropdown" id="SiteNavLabel-{{ child_list_handle }}" aria-expanded="false" role="main">
                        {% if three_level_nav %}
                          <div class="site-nav__childlist">
                            <div class="site-nav__childlist-grid">
                              {% if linklists[child_list_handle].links != blank %}
                                {% for childlink in linklists[child_list_handle].links %}
                                  {% assign grand_child_list_handle = childlink.title | handle %}
                                  <div class="site-nav__childlist-item">
                                    <a href="{{ childlink.url }}" class="site-nav__link site-nav__child-link site-nav__child-link--parent">{{ childlink.title | escape }}</a>
                                    <div class="site-nav__dropdown_three">
                                      <ul class="sub-menu">
                                        {% for grandchildlink in linklists[grand_child_list_handle].links %}
                                          <li>
                                            <a href="{{ grandchildlink.url }}" class="site-nav__link site-nav__child-link">{{ grandchildlink.title | escape }}</a>
                                          </li>
                                        {% endfor %}
                                      </ul>
                                    </div>
                                  </div>
                                {% endfor %}
                              {% endif %}
                            </div>
                          </div>
                        {% else %}
                          <ul>
                            {% for childlink in linklists[child_list_handle].links %}
                              <li {% if childlink.active %}class="site-nav--active"{% endif %}>
                                <a href="{{ childlink.url }}" class="site-nav__link site-nav__child-link{% if forloop.last %} site-nav__link--last{% endif %}">{{ childlink.title | escape }}</a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>
                    </li>
                  {% else %}
                    <li class="{{ class_hidden }}{% if link.active %} site-nav--active{% endif %}">
                      <a href="{{ link.url }}" class="site-nav__link site-nav__link--main">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endif %}
                {% endif %}
              {% endfor %}
              {% if condition %}
                what to do
              {% endif %}
            </ul>
          </div>
        </div>
        <div class="contentsticky_menu d-flex align-items-center justify-content-between w-100">
          <nav id="AccessibleNav">
            {% include 'site-nav' %}
          </nav>
          <div class="social_hd">
            {% include 'nov-social' %}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="sidebar-vertical"></div>
</div>

<div class="contentsticky_search lg_search d-none">
  {% include 'nov-formsearch-inline' %}
</div>