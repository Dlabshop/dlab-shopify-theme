<div class="distance" style="padding-top: {{ section.settings.distance_top }}; padding-bottom: {{ section.settings.distance_bottom }}">
  <div id="MapSection--{{ section.id }}"
       class="map-section {% if display_map %}map-section--display-map{% endif %} {% if onboarding == true %}map-section--onboarding{% endif %} {{ section.settings.class }}"
       data-section-id="{{ section.id }}"
       data-section-type="map"
       {% if bg_image != blank %}
       data-bgset="{% include 'bgset', image: bg_image %}"
       style="background-image: url('{{ bg_image | img_url: '1920x' }});"
       {% endif %}>
    <div class="page-width map-section__wrapper">
      {% if section.settings.has_fullwidth == false %} 
      <div class="container">
      {% endif %}
        <div class="row no-gutters">
          <div class="map-section__background-wrapper col-map-1">
            <div class="map-section__container">
              <iframe src="{{ section.settings.iframe_map }}" width="100%" height="100%" frameborder="0" style="border:0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
            </div>
          </div>
          <div class="map-section__content-wrapper col-map-2">
            <div class="map-section__content">
              {% if section.settings.heading != blank %}
                <h3 class="h4"><span>{{ section.settings.heading | escape }}</span></h3>
              {% endif %}
              <div class="rte-setting mb-30">
                {% if section.settings.map_address != blank %}
                  <div class="address"><span class="text-uppercase font-weight-bold"><i class="icon_address_ft"></i></span>{{ section.settings.map_address | nofilter }}</div>
                {% endif %}
                {% if section.settings.hotline != blank %}
                  <div class="hotline d-flex">
                    <span class="text-uppercase font-weight-bold"><i class="icon_hotline_ft"></i></span><div>{{ section.settings.hotline }}</div>
                  </div>
                {% endif %}
                {% if section.settings.email != blank %}
                  <div class="email d-flex">
                    <span class="text-uppercase font-weight-bold"><i class="icon_email_ft"></i>&nbsp;</span><div>{{ section.settings.email }}</div>
                  </div>
                {% endif %}
                {% if section.settings.open_hours != blank %}
                  <div class="open mt-20">
                    <span class="title_block">{{ 'sections.map.open' | t }}</span>
                    <div>{{ section.settings.open_hours }}</div>
                  </div>
                {% endif %}
              </div>
              {% if section.settings.map_address != blank and section.settings.button_text != blank %}
                <a href="https://maps.google.com?daddr={{ section.settings.map_address | escape }}"
                  class="btn map_section__directions-btn"
                  target="_blank">
                  <span>{{ section.settings.button_text | escape }}</span>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% if section.settings.has_fullwidth == false %}
      </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Vinova Map",
    "class": "index-section section-maps",
    "settings": [
      {
        "type": "header",
        "content": "Maps"
      },
      {
        "type": "text",
        "id": "iframe_map",
        "label": "Google Maps Iframe",
        "info": "You’ll need to embed the code on google map",
        "default": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4082.7742465747338!2d-79.38287617561478!3d43.64905556573276!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x882b34d2a57d767f%3A0x935ab2eb9fd5fb31!2sFirst%20Canadian%20Place!5e0!3m2!1svi!2s!4v1591603052999!5m2!1svi!2s"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "checkbox",
        "id": "has_fullwidth",
        "label": "Full Width",
        "default":   false
      },
      {
        "type": "header",
        "content": "Section Distance"
      },
      {
        "type": "text",
        "id": "distance_top",
        "label": "Top Distance Section",
        "default": "30px"
      },
      {
        "type": "text",
        "id": "distance_bottom",
        "label": "Bottom Distance Section",
        "default": "30px"
      }
    ],
    "presets": [
      {
        "name": "Vinova Map",
        "category": "Store information"
      }
    ]
  }
{% endschema %}
