{%- assign bg_image = section.settings.background_image -%}
{% if section.settings.background_color != blank or bg_image.src != blank %}
<style>
  #shopify-section-{{ section.id }} .page-width {
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if bg_image.src != blank %}
      background-image: url("{{ bg_image | img_url: '1920x1920' }}");
    {% endif %}
  }
</style>
{% endif %}

<div class="distance" style="padding-bottom: {{ section.settings.distance_bottom }}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="page-width{% if section.settings.class %} {{ section.settings.class }}{% endif %}">
    {% if section.settings.has_fullwidth == false %}
      <div class="container">
    {% endif %}
      {% if section.settings.title != blank %}
        <div class="section-header {{ section.settings.title_alignment }}">
          <div class="title_block">
            <span>{{ section.settings.title | escape }}</span>
          </div>
        </div>
      {% endif %}
      <div class="block_customs">
        <div class="custom-content row">
          {% for block in section.blocks %}

            {%- assign bg_newsletter = block.settings.background_newsletter -%}
            {% if block.settings.background_color != blank or bg_newsletter.src != blank %}
              <style>
                #shopify-section-{{ section.id }} .custom_newsletter {
                  {% if bg_newsletter.src != blank %}
                    background-image: url("{{ bg_newsletter | img_url: '1920x1920' }} ");
                  {% endif %}
                }
              </style>
            {% endif %}
            <div class="custom__item {{ block.settings.width }} {{ block.settings.width_lg }} {{ block.settings.width_md }}{% if block.settings.class != blank %} {{ block.settings.class }}{% endif %}{% if block.settings.alignment != blank %} {{ block.settings.alignment }}{% endif %}">
              <div class="custom_{{ block.type }}">
                <div class="custom__item-inner">
                  {% case block.type %}
                    {% when 'image' %}
                      {% if block.settings.image != blank %}
                        <img class="img-fluid" src="{{ block.settings.image | img_url: '1200x' }}" alt="image">
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    {% when 'text' %}
                      <div class="text">
                        {% if block.settings.title != blank %}
                        <div class="title_block">{{ block.settings.title | escape }}</div>
                        {% endif %}
                        {% if block.settings.text != blank %}
                        <div class="rte-setting">{{ block.settings.text }}</div>
                        {% endif %}
                      </div>
                    {% when 'html' %}
                      {% if block.settings.code != blank %}
                        {{ block.settings.code }}
                      {% endif %}
                    {% when 'newsletter' %}
                      {% if block.settings.title != blank %}
                        <div class="title_block text-center">
                          {{ block.settings.title }}
                          <div class="sub_title">{{ block.settings.sub_title }}</div>
                        </div>
                      {% endif %}
                      {% form 'customer' %}
                        {{ form.errors | default_errors }}
                        {% if form.posted_successfully? %}
                          <p class="form--success text-center mb-25">{{ 'general.newsletter_form.confirmation' | t }}</p>
                        {% else %}
                          <div class="input-group">
                            <input type="hidden" name="contact[tags]" value="newsletter">
                            <input type="email"
                              name="contact[email]"
                              id="Email_custom"
                              class="input-group__field newsletter__input"
                              value="{% if customer %}{{ customer.email }}{% endif %}"
                              placeholder="{{ 'general.newsletter_form.email_newsletter' | t }}">
                            <span class="input-group__btn">
                              <button type="submit" class="btn newsletter__submit" name="commit" id="Subscribe_custom">
                                <span class="newsletter__submit-text--large">
                                  <i class="icon-subscribe"></i>
                                </span>
                              </button>
                            </span>
                          </div>
                        {% endif %}
                      {% endform %}
                    {% when 'social' %}
                      {% include 'nov-social' %}
                    {% when 'policy' %}
                      <div class="block_content row">
                        <div class="block_item col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                          <div class="d-flex align-items-center">
                            <div class="policy-icon">
                              <img src="{{ block.settings.policy_icon_1 | img_url: '40x' }}" alt="Icon Policy 1">
                            </div>
                            <div class="policy-info media-body">
                              <div class="title-policy">{{ block.settings.title_policy_1 }}</div>
                              <div class="desc-policy">{{ block.settings.desc_policy_1 }}</div>
                            </div>
                          </div>
                        </div>
                        <div class="block_item col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                          <div class="d-flex align-items-center">
                            <div class="policy-icon">
                              <img src="{{ block.settings.policy_icon_2 | img_url: '40x' }}" alt="Icon Policy 1">
                            </div>
                            <div class="policy-info media-body">
                              <div class="title-policy">{{ block.settings.title_policy_2 }}</div>
                              <div class="desc-policy">{{ block.settings.desc_policy_2 }}</div>
                            </div>
                          </div>
                        </div>
                        <div class="block_item col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                          <div class="d-flex align-items-center">
                            <div class="policy-icon">
                              <img src="{{ block.settings.policy_icon_3 | img_url: '40x' }}" alt="Icon Policy 3">
                            </div>
                            <div class="policy-info media-body">
                              <div class="title-policy">{{ block.settings.title_policy_3 }}</div>
                              <div class="desc-policy">{{ block.settings.desc_policy_3 }}</div>
                            </div>
                          </div>
                        </div>
                        <div class="block_item col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                          <div class="d-flex align-items-center">
                            <div class="policy-icon">
                              <img src="{{ block.settings.policy_icon_4 | img_url: '40x' }}" alt="Icon Policy 4">
                            </div>
                            <div class="policy-info media-body">
                              <div class="title-policy">{{ block.settings.title_policy_4 }}</div>
                              <div class="desc-policy">{{ block.settings.desc_policy_4 }}</div>
                            </div>
                          </div>
                        </div>
                      </div>
                    {% when 'image_slider' %}
                      <div class="img_slider nov-slick-carousel">
                        <div class="item_image gallery-image__item">
                          <a href="{{ block.settings.link_img_1 }}"><img class="img-fluid" src="{{ block.settings.img_1 | img_url: '300x' }}" alt="image"></a>
                        </div>
                        <div class="item_image gallery-image__item">
                          <a href="{{ block.settings.link_img_2 }}"><img class="img-fluid" src="{{ block.settings.img_2 | img_url: '300x' }}" alt="image"></a>
                        </div>
                        <div class="item_image gallery-image__item">
                          <a href="{{ block.settings.link_img_3 }}"><img class="img-fluid" src="{{ block.settings.img_3 | img_url: '300x' }}" alt="image"></a>
                        </div>
                        <div class="item_image gallery-image__item">
                          <a href="{{ block.settings.link_img_4 }}"><img class="img-fluid" src="{{ block.settings.img_4 | img_url: '300x' }}" alt="image"></a>
                        </div>
                        <div class="item_image gallery-image__item">
                          <a href="{{ block.settings.link_img_5 }}"><img class="img-fluid" src="{{ block.settings.img_5 | img_url: '300x' }}" alt="image"></a>
                        </div>
                      </div>
                    {% when 'collection_tab' %}
                      <div class="nov-collection-tabs{% if block.settings.class != blank %} {{ block.settings.class }}{% endif %} nov-collection-tabs-slider">
                        <div id="product-tabs-categories-{{ block.id }}" class="block product-tabs-categories">
                          {% if block.settings.title != blank %}
                            <div class="title_block {{ block.settings.title_alignment }}
                              {% if 
                                block.settings.tab_title_1 == blank and 
                                block.settings.tab_title_2 == blank and 
                                block.settings.tab_title_3 == blank %} 
                                no_tab
                              {% endif %}">
                              <span>{{ block.settings.title | escape }}</span>
                            </div>
                          {% endif %}
                          {% if block.settings.sub_title != blank %}
                            <div class="sub_title">{{ block.settings.sub_title | escape }}</div>
                          {% endif %}

                          <ul id="collection_tab" class="nav nav-tabs {% if block.settings.tab_align == 'center' %} justify-content-center{% elsif block.settings.tab_align == 'right' %} justify-content-end{% else %}{% endif %} flex-nowrap" role="tablist">
                            {% if block.settings.tab_title_1 != blank %}
                              <li class="nav-item">
                                <a class="nav-link active" href="#producttab1" role="tab" data-toggle="tab" data-collection="{{ block.settings.collection_handle_1 }}">
                                  {% if block.settings.image_icon != blank %}
                                    <div class="content-nav">
                                  {% endif %}
                                    {% if block.settings.image_icon_1 != blank %}
                                      <img class="nav-imageicon" src="{{ block.settings.image_icon_1 | img_url: '150x' }}" alt="{{ block.settings.tab_title_1 }}">
                                    {% endif %}
                                      <span>{{ block.settings.tab_title_1 }}</span>
                                  {% if block.settings.image_icon != blank %}
                                    </div>
                                  {% endif %}
                                </a>
                              </li>
                            {% endif %}
                            {% if block.settings.tab_title_2 != blank %}
                              <li class="nav-item">
                                <a class="nav-link" href="#producttab2" role="tab" data-toggle="tab" data-collection="{{ block.settings.collection_handle_2 }}">
                                  {% if block.settings.image_icon != blank %}
                                    <div class="content-nav">
                                  {% endif %}
                                    {% if block.settings.image_icon_2 != blank %}
                                      <img class="nav-imageicon" src="{{ block.settings.image_icon_2 | img_url: '150x' }}" alt="{{ block.settings.tab_title_2 }}">
                                    {% endif %}
                                      <span>{{ block.settings.tab_title_2 }}</span>
                                  {% if block.settings.image_icon != blank %}
                                    </div>
                                  {% endif %}
                                </a>
                              </li>
                            {% endif %}
                            {% if block.settings.tab_title_3 != blank %}
                              <li class="nav-item">
                                <a class="nav-link" href="#producttab3" role="tab" data-toggle="tab" data-collection="{{ block.settings.collection_handle_3 }}">
                                  {% if block.settings.image_icon != blank %}
                                    <div class="content-nav">
                                  {% endif %}
                                    {% if block.settings.image_icon_3 != blank %}
                                      <img class="nav-imageicon" src="{{ block.settings.image_icon_3 | img_url: '150x' }}" alt="{{ block.settings.tab_title_3 }}">
                                    {% endif %}
                                      <span>{{ block.settings.tab_title_3 }}</span>
                                  {% if block.settings.image_icon != blank %}
                                    </div>
                                  {% endif %}
                                </a>
                              </li>
                            {% endif %}
                          </ul>
                        </div>
        
                        {%- assign img_size = settings.img_size_large -%}
                        {% if block.settings.grid_number == '5' %}
                          {%- assign grid_item_width = 'col-lg-cus-5' -%}
                        {% else %}
                          {%- assign grid_item_width = 12 | divided_by: block.settings.grid_number | prepend: 'col-lg-' -%}
                        {% endif %}
        
                        {% if block.settings.grid_number_tablet == '5' %}
                          {%- assign col_tablet = 'col-md-cus-5' -%}
                        {% else %}
                          {%- assign col_tablet = 12 | divided_by: block.settings.grid_number_tablet | prepend: 'col-md-' -%}
                        {% endif %}
        
                        {%- assign col_mobile = 12 | divided_by: block.settings.grid_number_mobile | prepend: 'col-xs-' -%}
        
                        {%- assign limit = block.settings.limit  -%}
                        <div class="product_tab_content tab-content">
                          {% if block.settings.collection_handle_1 != blank %}
                            {%- assign category = block.settings.collection_handle_1 -%}
                            <div id="producttab1" class="tab-pane fade show active" role="tabpanel">
                              <div class="grid--view-items nov-slick-carousel"
                                data-items="{{ block.settings.grid_number }}"
                                data-items_lg_tablet="{{ block.settings.grid_number_lg_tablet }}"
                                data-items_tablet="{{ block.settings.grid_number_tablet }}"
                                data-items_mobile="{{ block.settings.grid_number_mobile }}"
                                data-items_mobiles="{{ block.settings.grid_number_mobiles }}"
                                data-row="{{ block.settings.row_number }}"
                                data-loop="true"
                                data-dots="{{ block.settings.show_dots }}"
                                data-nav="{{ block.settings.show_nav }}"
                                data-autoplay="false"
                                data-autoplayTimeout="6000">
                              {% for product in collections[category].products limit:limit %}
                                <div class="item">
                                  {% include 'product-card-grid', img_size: img_size, mr_bottom: 'mb-30' %}
                                </div>
                              {% endfor %}
                              </div>
                            </div>
                          {% endif %}
                          {% if block.settings.collection_handle_2 != blank %}
                            {%- assign category = block.settings.collection_handle_2 -%}
                            <div id="producttab2" class="tab-pane fade" role="tabpanel">
                              <div class="grid--view-items nov-slick-carousel"
                                data-items="{{ block.settings.grid_number }}"
                                data-items_lg_tablet="{{ block.settings.grid_number_lg_tablet }}"
                                data-items_tablet="{{ block.settings.grid_number_tablet }}"
                                data-items_mobile="{{ block.settings.grid_number_mobile }}"
                                data-items_mobiles="{{ block.settings.grid_number_mobiles }}"
                                data-row="{{ block.settings.row_number }}"
                                data-loop="true"
                                data-dots="{{ block.settings.show_dots }}"
                                data-nav="{{ block.settings.show_nav }}"
                                data-autoplay="false"
                                data-autoplayTimeout="6000">
                                {% for product in collections[category].products limit:limit %}
                                  <div class="item">
                                    {% include 'product-card-grid', img_size: img_size, mr_bottom: 'mb-30' %}
                                  </div>
                                {% endfor %}
                              </div>
                            </div>
                          {% endif %}
                          {% if block.settings.collection_handle_3 != blank %}
                            {%- assign category = block.settings.collection_handle_3 -%}
                            <div id="producttab3" class="tab-pane fade" role="tabpanel">
                              <div class="grid--view-items nov-slick-carousel"
                                data-items="{{ block.settings.grid_number }}"
                                data-items_lg_tablet="{{ block.settings.grid_number_lg_tablet }}"
                                data-items_tablet="{{ block.settings.grid_number_tablet }}"
                                data-items_mobile="{{ block.settings.grid_number_mobile }}"
                                data-items_mobiles="{{ block.settings.grid_number_mobiles }}"
                                data-row="{{ block.settings.row_number }}"
                                data-loop="true"
                                data-dots="{{ block.settings.show_dots }}"
                                data-nav="{{ block.settings.show_nav }}"
                                data-autoplay="false"
                                data-autoplayTimeout="6000">
                                {% for product in collections[category].products limit:limit %}
                                  <div class="item">
                                    {% include 'product-card-grid', img_size: img_size, mr_bottom: 'mb-30' %}
                                  </div>
                                {% endfor %}
                              </div>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    {% when 'product_deals' %}
                        {% if block.settings.title != blank %}
                          <div class="title_block {{ block.settings.title_alignment }}">
                            <span>{{ block.settings.title }}</span>
                          </div>
                        {% endif %}

                        {% if block.settings.sub_title != blank %}
                          <div class="sub_title">{{ block.settings.sub_title }}</div>
                        {% endif %}

                        <div class="nv-slick-slider row"
                          data-items="{{ block.settings.grid_number }}"
                          data-items_tablet="{{ block.settings.grid_number_tablet }}"
                          data-items_lg_tablet="{{ block.settings.grid_number_lg_tablet }}"
                          data-items_mobile="{{ block.settings.grid_number_mobile }}"
                          data-row="{{ block.settings.row_number }}"
                          data-loop="false"
                          data-dots="{{ block.settings.show_dots }}"
                          data-nav="{{ block.settings.show_nav }}"
                          data-autoplay="false"
                          data-autoplayTimeout="6000">
                          {% if block.settings.product_handle_1 != blank %}
                            {% assign product = all_products[block.settings.product_handle_1] %}
                            <div class="item col">
                              {% if block.settings.style_product == 'style_1' %}
                                {%- if block.settings.countdown_timeend_1 != blank -%}
                                  {%- assign countdownTime = block.settings.countdown_timeend_1 -%}
                                  <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                                {%- endif -%}
                              {% endif %}

                              {% include 'product-card-grid', img_size: img_size %}
                            </div>
                          {% endif %}
                          {% if block.settings.product_handle_2 != blank %}
                            {% assign product = all_products[block.settings.product_handle_2] %}
                            <div class="item col">
                              {% if block.settings.style_product == 'style_1' %}
                                {%- if block.settings.countdown_timeend_1 != blank -%}
                                  {%- assign countdownTime = block.settings.countdown_timeend_1 -%}
                                  <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                                {%- endif -%}
                              {% endif %}
                              
                              {% include 'product-card-grid', img_size: img_size %}
                            </div>
                          {% endif %}
                          {% if block.settings.product_handle_3 != blank %}
                            {% assign product = all_products[block.settings.product_handle_3] %}
                            <div class="item col">
                              {% if block.settings.style_product == 'style_1' %}
                                {%- if block.settings.countdown_timeend_1 != blank -%}
                                  {%- assign countdownTime = block.settings.countdown_timeend_1 -%}
                                  <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                                {%- endif -%}
                              {% endif %}
                              
                              {% include 'product-card-grid', img_size: img_size %}
                            </div>
                          {% endif %}
                          {% if block.settings.product_handle_4 != blank %}
                            {% assign product = all_products[block.settings.product_handle_4] %}
                            <div class="item col">
                              {% if block.settings.style_product == 'style_1' %}
                                {%- if block.settings.countdown_timeend_1 != blank -%}
                                  {%- assign countdownTime = block.settings.countdown_timeend_1 -%}
                                  <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                                {%- endif -%}
                              {% endif %}
                              
                              {% include 'product-card-grid', img_size: img_size %}
                            </div>
                          {% endif %}
                          {% if block.settings.product_handle_5 != blank %}
                            {% assign product = all_products[block.settings.product_handle_5] %}
                            <div class="item col">
                              {% if block.settings.style_product == 'style_1' %}
                                {%- if block.settings.countdown_timeend_1 != blank -%}
                                  {%- assign countdownTime = block.settings.countdown_timeend_1 -%}
                                  <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                                {%- endif -%}
                              {% endif %}
                              
                              {% include 'product-card-grid', img_size: img_size %}
                            </div>
                          {% endif %}
                          {% if block.settings.product_handle_6 != blank %}
                            {% assign product = all_products[block.settings.product_handle_6] %}
                            <div class="item col">
                              {% if block.settings.style_product == 'style_1' %}
                                {%- if block.settings.countdown_timeend_1 != blank -%}
                                  {%- assign countdownTime = block.settings.countdown_timeend_1 -%}
                                  <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                                {%- endif -%}
                              {% endif %}
                              
                              {% include 'product-card-grid', img_size: img_size %}
                            </div>
                          {% endif %}
                        </div>
                    {% when 'product_thumb' %}
                      <div class="box-margin product_thumb">
                        <div class="box-padding">
                          {% if block.settings.title != blank %}
                            <div class="title_block {{ 'block.settings.title_alignment' }}">
                              {{ block.settings.title }}
                              <div class="sub_title">{{ block.settings.sub_title }}</div>
                            </div>
                          {% endif %}
                          <div class="nv-owl-carousel owl-carousel owl-theme"
                            data-items="1"
                            data-items_tablet="1"
                            data-items_lg_tablet="1"
                            data-items_mobile="1"
                            data-loop="true"
                            data-dots="false"
                            data-nav="true"
                            data-autoplay="false">
                            {% if block.settings.product_handle_1 != blank %}
                              {% assign product = all_products[block.settings.product_handle_1] %}

                              {%- if block.settings.countdown_timeend_1 != blank -%}
                                {%- assign countdownTime = block.settings.countdown_timeend_1 -%}
                                <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                              {%- endif -%}

                              {% include 'product-card-grid', img_size: img_size %}
                            {% endif %}
                            {% if block.settings.product_handle_2 != blank %}
                              {% assign product = all_products[block.settings.product_handle_2] %}

                              {%- if block.settings.countdown_timeend_2 != blank -%}
                                {%- assign countdownTime = block.settings.countdown_timeend_2 -%}
                                <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                              {%- endif -%}

                              {% include 'product-card-grid', img_size: img_size %}
                            {% endif %}
                            {% if block.settings.product_handle_3 != blank %}
                              {% assign product = all_products[block.settings.product_handle_3] %}

                              {%- if block.settings.countdown_timeend_3 != blank -%}
                                {%- assign countdownTime = block.settings.countdown_timeend_3 -%}
                                <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                              {%- endif -%}

                              {% include 'product-card-grid', img_size: img_size %}
                            {% endif %}
                            {% if block.settings.product_handle_4 != blank %}
                              {% assign product = all_products[block.settings.product_handle_4] %}

                              {%- if block.settings.countdown_timeend_4 != blank -%}
                                {%- assign countdownTime = block.settings.countdown_timeend_4 -%}
                                <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                              {%- endif -%}

                              {% include 'product-card-grid', img_size: img_size %}
                            {% endif %}
                            {% if block.settings.product_handle_5 != blank %}
                              {% assign product = all_products[block.settings.product_handle_5] %}

                              {%- if block.settings.countdown_timeend_5 != blank -%}
                                {%- assign countdownTime = block.settings.countdown_timeend_5 -%}
                                <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                              {%- endif -%}

                              {% include 'product-card-grid', img_size: img_size %}
                            {% endif %}
                            {% if block.settings.product_handle_6 != blank %}
                              {% assign product = all_products[block.settings.product_handle_6] %}

                              {%- if block.settings.countdown_timeend_6 != blank -%}
                                {%- assign countdownTime = block.settings.countdown_timeend_6 -%}
                                <div class="countdownfree" data-countdown="{{ countdownTime }}"></div>
                              {%- endif -%}

                              {% include 'product-card-grid', img_size: img_size %}
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    {% when 'product_list' %}
                      <div class="nov-group-product-list">
                        {% if block.settings.title != blank %}
                          <div class="title_block">
                            {{ block.settings.title }}
                            <div class="sub_title">{{ block.settings.sub_title }}</div>
                          </div>
                        {% endif %}
                
                        <div class="nv-slick-slider row"
                          data-items="{{ block.settings.grid_number }}"
                          data-items_tablet="{{ block.settings.grid_number_tablet }}"
                          data-items_lg_tablet="{{ block.settings.grid_number_lg_tablet }}"
                          data-items_mobile="{{ block.settings.grid_number_mobile }}"
                          data-row="{{ block.settings.row_number }}"
                          data-loop="true"
                          data-dots="{{ block.settings.show_dots }}"
                          data-nav="{{ block.settings.show_nav }}"
                          data-autoplay="false"
                          data-autoplayTimeout="6000">
                            {%- assign category = block.settings.collection -%}
                            {% for product in collections[category].products limit:block.settings.limit %}
                              <div class="item col wow zoomIn animated" data-wow-delay="0.2s">
                                <div class="item-product d-flex{% if forloop.last == false %} mb-10{% endif %}">
                
                                  <div class="thumbnail-container{% if product.images.size > 2 %} has-multiimage{% endif %}">
                                    <a href="{{ product.url | within: collection }}">
                                      <img class="img-fluid product__thumbnail lazyload" src="{{ product.featured_image | product_img_url: '153x' }}" alt="{{ product.featured_image.alt | escape }}">
                                    </a>
                                  </div>
                
                                  <div class="product__info ml-15 ml-md-10">
                                    <div class="product__title"><a href="{{ product.url | within: collection }}">{{ product.title }}</a></div>
                                    <div class="product__review">
                                      <div class="rating"><span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span></div>
                                    </div>
                                    <div class="product__price">
                                      {% include 'product-price' %}
                                    </div>
                                    {% include 'group_buttons' %}
                                  </div>
                                </div>
                              </div>
                            {% endfor %}
                        </div>
                      </div>
                  {% endcase %}
                </div>
              </div>
            </div>

          {% endfor %}
        </div>
      </div>
      {% if section.blocks.size == 0 %}
        {% include 'no-blocks' %}
      {% endif %}
    {% if section.settings.has_fullwidth == false %}
      </div>
    {% endif %}
  </div>
