{% if section.settings.title != blank %}
    <div class="block-testimonial">
        <div class="title_block">
            <span>{{ section.settings.title | escape }}</span>
        </div>
        {% if section.settings.subheading != blank %}
            <span class="sub_title">{{ section.settings.subheading | escape }}</span>
        {% endif %}
    </div>
{% endif %}

<div class="testimonial">
    <div class="testimonial_grid">
        <div class="row spacing-{{ section.settings.spacing }}">
            {% for block in section.blocks %}
            <div class="{{ section.settings.width }} {{ section.settings.width_tablet }} {{ section.settings.width_mobile }}">
                <div class="testimonial_grid_column {{ section.settings.class }}" {{ block.shopify_attributes }}>
                    <div class="testimonial__item">
                        <div class="testimonial-author">
                            {% if block.settings.avatar != blank %}
                                <img class="testimonial-avatar" src="{{ block.settings.avatar | img_url: '270x' }}" alt="{% if block.settings.author != blank %}{{ block.settings.author }}{% else %}Avatar image{% endif %}">
                            {% else %}
                                {{ 'image' | placeholder_svg_tag: 'testimonial-item__avatar' }}
                            {% endif %}
                        </div>
                        <div class="content-info">
                            <div class="testimonial_you">
                                {% if block.settings.author != blank %}
                                    <div class="testimonial-item__name">{{ block.settings.author }}</div>
                                {% endif %}
                                {% if block.settings.job != blank %}
                                    <div class="testimonial-item__info">{{ block.settings.job }}</div>
                                {% endif %}
                            </div>
                            {% if block.settings.decs != blank %}
                              <div class="testimonial-item__text">{{ block.settings.decs }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

