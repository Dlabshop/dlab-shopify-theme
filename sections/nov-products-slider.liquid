{%- assign bg_image = section.settings.background_image -%}
{% if section.settings.background_color != blank or bg_image.src != blank %}
  <style>
    .section-product-slider {
      {% if section.settings.background_color != blank %}
        background-color: {{ section.settings.background_color }};
      {% endif %}
      {% if bg_image.src != blank %}
        background-image: url("{{ bg_image | img_url: '1920x' }}");
        background-repeat: no-repeat;
        background-position: center;
      {% endif %}
    }
  </style>
{% endif %}
<div class="distance" style="padding-top: {{ section.settings.distance_top }}; padding-bottom: {{ section.settings.distance_bottom }}">
  <div data-section-id="{{ section.id }}" data-section-type="nov-slick">
    {% if section.settings.has_fullwidth == false %}
      <div class="container">
    {% endif %}
      <div class="{{ section.settings.title_alignment }}">
        {% if section.settings.title != blank %}
          <div class="title_block">
            <span>{{ section.settings.title }}</span>
          </div>
          {% if section.settings.subheading != blank %}
            <span class="sub_title">{{ section.settings.subheading | escape }}</span>
          {% endif %}
        {% endif %}
      </div>
      {%- assign collection = collections[section.settings.collection] -%}

      {% case section.settings.grid_number %}
      {% when '2' %}
        {%- assign img_size = settings.img_size_large -%}
      {% when '3' %}
        {%- assign img_size = settings.img_size_large -%}
      {% when '4' %}
        {%- assign img_size = settings.img_size -%}
      {% when '5' %}
        {%- assign img_size = settings.img_size -%}
      {% when '6' %}
        {%- assign img_size = settings.img_size -%}
      {% endcase %}

      {%- assign product_limit = section.settings.limit -%}
      <div class="block_content{% if section.settings.class != blank %} {{ section.settings.class }}{% endif %}">
        <div class="grid--view-items row nov-slick-carousel nav_center" 
          data-autoplay="false" 
          data-autoplayTimeout="6000" 
          data-loop="false"
          data-margin="{{ section.settings.spacing }}" 
          data-dots="{{ section.settings.show_dots }}" 
          data-nav="{{ section.settings.show_nav }}" 
          data-row="{{ section.settings.number_row }}" 
          data-items="{{ section.settings.grid_number }}" 
          data-items_lg_desktop="{{ section.settings.items_lg_desktop }}" 
          data-items_lg_tablet="{{ section.settings.grid_number_lg_tablet }}" 
          data-items_tablet="{{ section.settings.items_tablet }}" 
          data-items_mobile="{{ section.settings.items_mobile }}"
          data-items_mobiles="{{ section.settings.items_mobiles }}">
          {% for product in collection.products limit: product_limit %}
            <div class="item col{% if section.settings.number_row != '1' %}{% endif %}">
              <div class="item-product item-animate{% unless product.available %} product-price--sold-out{% endunless %}{% unless mr_bottom %} {{ mr_bottom }}{% endunless %} {% if section.settings.number_row != '1' %}mb-30{% endif %}">
                {% assign variantCount = product.variants | size %}
                <div class="thumbnail-container{% if product.images.size > 2 %} has-multiimage{% endif %}">
                  <a href="{{ product.url | within: collection }}">
                    <img class="img-fluid product__thumbnail lazyload" data-src="{{ product.featured_image | product_img_url: '270x270' }}" alt="">
                    {% for image in product.images %}
                      {% if forloop.first != true %}
                        <img class="img-fluid product__thumbnail-second lazyload" data-src="{{ image.src | product_img_url: '270x270' }}" alt="">
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  </a>
                  {% if product.compare_at_price > product.price %}
                    <div class="badge_sale">
                      <div class="badge badge--sale-rt">{{ 'products.product.new' | t }}</div>
                      <span class="badge badge--sale-pt">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round: 4 }}%</span>
                    </div>
                  {% endif %}
                  <div class="group-buttons d-flex">
                    {% if settings.wishlist_enable %}
                      {% include 'nov-wishlist' %}
                    {% endif %}
                    {% if settings.quickview_enable %}
                      {% include 'nov-quickview' %} 
                    {% endif %}
                  </div>
                </div>
                <div class="product__info">
                  <div class="block_product">
                    <div class="product__title">
                      <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
                    </div>
                    {% if settings.show_rating %}
                      <div class="product__review">
                        <div class="rating"><span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span></div>
                      </div>
                    {% endif %}
                    <div class="product__price">
                      {% include 'product-price' %}
                    </div>
                    <div class="group-buttons d-flex{% if justify.size > 0 %} {{ justify }}{% endif %} justify-content-center">
                      {% assign variantCount = product.variants | size %}
                      <form class="formAddToCart" action="/cart/add" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ product.variants.first.id }}"/>
                        {% if sold_out %}
                          <button class="btn btnAddToCart disabled" type="submit" value="Submit" 
                            data-handle="{{ product.handle }}"
                            {% if settings.tooltip_enable %} 
                              data-toggle="tooltip" 
                              data-placement="top" 
                            {% endif %}
                            title="" tabindex="0" disabled >
                            <i class="zmdi zmdi-block-alt"></i>
                          </button>
                        {% else %}
                          {% if variantCount > 1 %}
                            <a class="btn btnAddToCart btnChooseVariant" 
                              href="javascript:void(0);" 
                              data-url="/products/{{ product.handle }}?view=json"
                              {% if settings.tooltip_enable %} 
                                data-toggle="tooltip" 
                                data-placement="top" 
                              {% endif %}
                              title="" tabindex="0">
                              <i class="zmdi zmdi-check"></i>
                              <span>{{ 'products.product.select_options' | t }}</span>
                            </a>
                          {% else %}
                            <button class="btn btnAddToCart" type="submit" value="Submit" 
                              data-handle="{{ product.handle }}"
                              data-pid="{{ product.variants.first.id }}"
                              {% if settings.tooltip_enable %} 
                                data-toggle="tooltip" 
                                data-placement="top" 
                              {% endif %}
                              title="" tabindex="0">
                              <i class="icon_cart"></i>
                              <span>{{ 'products.product.add_to_cart' | t }}</span>
                            </button>
                          {% endif %}
                        {% endif %}
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% else %}
            {% for i in (1..product_limit) %}
              <div class="item col{% if section.settings.number_row != '1' %}{% endif %}">
                <div class="item-product mb-20">
                  <div class="thumbnail-container">
                    <a href="{{ collection.url }}">
                      {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                      {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    </a>
                  </div>
                  <div class="product__info text-center">
                    <div class="product__title"><a href="{{ collection.url }}">{{ 'homepage.onboarding.product_title' | t }}</a></div>
                    <div class="product__price">
                      {% include 'product-price' %}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endfor %}
        </div>

        {% if section.settings.show_view_all %}
          <div class="text-center show_all">
            <a href="{{ collection.url }}" class="btn">
              {{ 'collections.general.view_more' | t }}
            </a>
          </div>
        {% endif %}
      </div>
    {% if section.settings.has_fullwidth == false %}
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Products Slider",
    "class": "index-section section-product-slider wow fadeIn animated",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Vinova Products Slider"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Sub Heading",
        "default": "Subtitle from happy customers"
      },
      {
        "type": "select",
        "id": "title_alignment",
        "label": "Title alignment",
        "default": "text-left",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "id": "collection",
        "type": "collection",
        "label": "Collection"
      },
      {
        "type": "range",
        "id": "grid_number",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Products per row",
        "default": 4
      },
      {
        "type": "range",
        "id": "items_lg_desktop",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Products per 1440px row (Desktop)",
        "default": 4
      },
      {
        "type": "range",
        "id": "grid_number_lg_tablet",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Products per row (Desktop)",
        "default": 3
      },
      {
        "type": "range",
        "id": "items_tablet",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Items Tablet",
        "default": 3,
        "info": "Select number Items Tablet for slider"
      },
      {
        "type": "range",
        "id": "items_mobile",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Items Mobile",
        "default": 2,
        "info": "Select number Items Mobile for slider"
      },
      {
        "type": "range",
        "id": "items_mobiles",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Items Mobile 480",
        "default": 1,
        "info": "Select number Items Mobile for slider"
      },
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 30,
        "info": "Select number limit products"
      },
      {
        "type": "select",
        "id": "number_row",
        "label": "Number row",
        "default": "1",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show Navigation",
        "default": false
      },
      {
        "type":  "header",
        "content": "Design Option"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "checkbox",
        "id": "show_view_all",
        "label": "Show 'View all' button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "has_fullwidth",
        "label": "Full Width",
        "default":   false
      },
      {
        "type": "text",
        "id": "distance_top",
        "label": "Top Distance Section",
        "default": "30px"
      },
      {
        "type": "text",
        "id": "distance_bottom",
        "label": "Bottom Distance Section",
        "default": "30px"
      }
    ],
    "presets": [
      {
        "name": "Vinova Products Slider",
        "category": "Collection"
      }
    ]
  }
{% endschema %} 