{%- assign bg_image = section.settings.background_image -%}
{% if section.settings.background_color != blank or bg_image.src != blank %}
  <style>
    .section-policy {
      {% if section.settings.background_color != blank %}
        background-color: {{ section.settings.background_color }};
      {% endif %}
      {% if bg_image.src != blank %}
        background-image: url("{{ bg_image | img_url: '1920x' }}");
        background-repeat: no-repeat;
      {% endif %}
    }
  </style>
{% endif %}
<div class="distance" style="padding-top: {{ section.settings.distance_top }}; padding-bottom: {{ section.settings.distance_bottom }}">
  <div id="section-policy-{{ section.id }}" class="page-width{% if section.settings.class != blank %} {{ section.settings.class }}{% endif %}" data-section-id="{{ section.id }}">
    {% if section.settings.has_fullwidth == false %}
      <div class="container">
    {% endif %}
      {% if section.settings.title != blank %}
        <div class="bolck">
          <div class="title_block">
            <span>{{ section.settings.title | escape  }}</span>
          </div>
          <div class="sub-title">{{ section.settings.sub_title | escape }}</div>
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="nov-policy">
          <div class="row">
            {% for block in section.blocks %}
              <div class="nov-policy-item {{ section.settings.width }} {{ section.settings.width_tablet }} {{ section.settings.width_sm_mobile }} {{ section.settings.width_xs_mobile }}">
                <div class="block_content">
                  <div class="content-policy">
                    <div class="policy-icon">
                      <img src="{{ block.settings.policy_icon | img_url: '100x' }}" alt="icon_policy">
                    </div>
                    <div class="policy-info">
                      <div class="title-policy">{{ block.settings.title_policy }}</div>
                      <div class="desc-policy">{{ block.settings.desc_policy }}</div>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% if section.settings.has_fullwidth == false %}
      </div>
    {% endif %}
  </div>
</div>
