<style>
  @media (min-width: 1200px) {
    .slideshow .main-slider {
      height: {{ section.settings.height_slideshow }}px; 
    }
    .slideshow .slick-slide {
      height: {{ section.settings.height_slideshow }}px;
    }
  }
  @media (max-width: 1199px) {
    .slideshow .main-slider {
      height: {{ section.settings.height_slideshow_desktop }}px; 
    }
    .slideshow .slick-slide {
      height: {{ section.settings.height_slideshow_desktop }}px;
    }
  }
  @media (max-width: 991px) {
    .slideshow .main-slider {
      height: {{ section.settings.height_slideshow_tablet }}px; 
    }
    .slideshow .slick-slide {
      height: {{ section.settings.height_slideshow_tablet }}px;
    }
  }
  @media (max-width: 767px) {
    .slideshow .main-slider {
      height: {{ section.settings.height_slideshow_mobile }}px; 
    }
    .slideshow .slick-slide {
      height: {{ section.settings.height_slideshow_mobile }}px;
    }
  }
  @media (max-width: 475px) {
    .slideshow .main-slider {
      height: {{ section.settings.height_slideshow_mobile_475 }}px; 
    }
    .slideshow .slick-slide {
      height: {{ section.settings.height_slideshow_mobile_475 }}px;
    }
  }

  {% for block in section.blocks %}
    .content-{{ forloop.index }} {
      left: {{ block.settings.left_position }}%;
      width: {{ block.settings.width_position }}%;
      transform: translateX(-{{ block.settings.left_position }}%);
    }
    @media(max-width: 1199px) {
      .content-{{ forloop.index }} {
        left: {{ block.settings.left_position_desktop }}%;
        width: {{ block.settings.width_position_desktop }}%;
        transform: translateX(-{{ block.settings.left_position_desktop }}%);
      }
    }
    @media(max-width: 991px) {
      .content-{{ forloop.index }} {
        left: {{ block.settings.left_position_tablet }}%;
        width: {{ block.settings.width_position_tablet }}%;
        transform: translateX(-{{ block.settings.left_position_tablet }}%);
      }
    }
    @media(max-width: 767px) {
      .content-{{ forloop.index }} {
        left: {{ block.settings.left_position_mobile }}%;
        width: {{ block.settings.width_position_mobile }}%;
        transform: translateX(-{{ block.settings.left_position_mobile }}%);
      }
    }
    @media(max-width: 575px) {
      .content-{{ forloop.index }} {
        left: {{ block.settings.left_position_mobile_575 }}%;
        width: {{ block.settings.width_position_mobile_575 }}%;
        transform: translateX(-{{ block.settings.left_position_mobile_575 }}%);
      }
    }
  {% endfor %}


  /* =========================================================
     PULSANTE SLIDESHOW — SFONDO NERO E TESTO BIANCO
     Inserito per sovrascrivere gli stili rossi del tema.
     ========================================================= */

