<div class="distance" style="padding-top: {{ section.settings.distance_top }}; padding-bottom: {{ section.settings.distance_bottom }}">
  <div class="gallery-image-custom{% if section.settings.has_fullwidth == true %} full_width{% endif %}">
    {% if section.settings.has_fullwidth == false %}
      <div class="container">
    {% endif %}

    {% if section.settings.title != blank %}
      <div class="block">
        <div class="title_block {{ section.settings.title_alignment }}">
          {% if section.settings.subheading != blank %}
            <span class="sub_title{% if section.settings.inline == true %} d-inline{% endif %}">{{ section.settings.subheading | escape }}</span>
          {% endif %}
          <span>{{ section.settings.title | nofilter }}</span>
        </div>
      </div>
    {% endif %}

    <div class="row spacing-{{ section.settings.spacing }}">
      {% for block in section.blocks %}
        <div class="{{ block.settings.width_group_image }} {{ block.settings.width_group_image_tablet }} {{ block.settings.width_group_image_mobile }} {{ block.settings.width_group_image_mobile_575 }} {{ block.settings.class_group_image }}">
          <div class="row spacing-{{ section.settings.spacing }} spacing-sm-10">
            {% if block.settings.image_1 != blank %}
              <div class="{{ block.settings.width_image_1 }} {{ block.settings.width_image_1_tablet }} {{ block.settings.width_image_1_mobile }} {{ block.settings.width_image_1_mobile_575 }} {{ block.settings.class_1 }}">
                <div class="gallery-image__item{% if block.settings.title_2 != blank %} has_title{% endif %}">
                  {% if block.settings.link_1 != blank %}
                    <a href="{{ block.settings.link_1 }}">
                  {% endif %}
                    <img class="img-fluid lazyload" data-src="{{ block.settings.image_1 | img_url: '1920x' }}" alt="image">
                  {% if block.settings.link_1 != blank %}
                    </a>
                  {% endif %}
                  {% if block.settings.title_1 != blank %}
                    <div class="title-block text-uppercase">
                      <span>{{ block.settings.title_1 }}</span>
                      <a href="{{ block.settings.link_1 }}">{{ 'sections.img-group.shop_now' | t }}</a>
                    </div>
                  {% endif %}
                  {% if block.settings.link_1 != blank and block.settings.button_1 != blank %}
                    <div class="button">
                      <a href="{{ block.settings.link_1 }}">{{ block.settings.button_1 }}</a>                        
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            {% if block.settings.image_2 != blank %}
              <div class="{{ block.settings.width_image_2 }} {{ block.settings.width_image_2_tablet }} {{ block.settings.width_image_2_mobile }} {{ block.settings.width_image_2_mobile_575 }}">
                <div class="gallery-image__item{% if block.settings.title_2 != blank %} has_title{% endif %} {{ block.settings.class_2 }}">
                  {% if block.settings.link_2 != blank %}
                    <a href="{{ block.settings.link_2 }}">
                  {% endif %}
                    <img class="img-fluid lazyload" data-src="{{ block.settings.image_2 | img_url: '1920x' }}" alt="image">
                  {% if block.settings.link_2 != blank %}
                    </a>
                  {% endif %}
                  {% if block.settings.title_2 != blank %}
                    <div class="title-block text-uppercase">
                      <span>{{ block.settings.title_2 }}</span>
                      <a href="{{ block.settings.link_2 }}">{{ 'sections.img-group.shop_now' | t }}</a>
                    </div>
                  {% endif %}
                  {% if block.settings.link_2 != blank and block.settings.button_2 != blank %}
                    <div class="button">
                      <a href="{{ block.settings.link_2 }}">{{ block.settings.button_2 }}</a>                        
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            {% if block.settings.image_3 != blank %}
              <div class="{{ block.settings.width_image_3 }} {{ block.settings.width_image_3_tablet }} {{ block.settings.width_image_3_mobile }} {{ block.settings.width_image_3_mobile_575 }}">
                <div class="gallery-image__item{% if block.settings.title_3 != blank %} has_title{% endif %}">
                  {% if block.settings.link_3 != blank %}
                    <a href="{{ block.settings.link_3 }}">
                  {% endif %}
                    <img class="img-fluid lazyload" data-src="{{ block.settings.image_3 | img_url: '1920x' }}" alt="image">
                  {% if block.settings.link_3 != blank %}
                    </a>
                  {% endif %}
                  {% if block.settings.title_3 != blank %}
                    <div class="title-block text-uppercase">
                      <span>{{ block.settings.title_3 }}</span>
                      <a href="{{ block.settings.link_3 }}">{{ 'sections.img-group.shop_now' | t }}</a>
                    </div>
                  {% endif %}
                  {% if block.settings.link_3 != blank and block.settings.button_3 != blank %}
                    <div class="button">
                      <a href="{{ block.settings.link_3 }}">{{ block.settings.button_3 }}</a>                        
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            {% if block.settings.image_4 != blank %}
              <div class="{{ block.settings.width_image_4 }} {{ block.settings.width_image_4_tablet }} {{ block.settings.width_image_4_mobile }} {{ block.settings.width_image_4_mobile_575 }}">
                <div class="gallery-image__item{% if block.settings.title_4 != blank %} has_title{% endif %}">
                  {% if block.settings.link_4 != blank %}
                    <a href="{{ block.settings.link_4 }}">
                  {% endif %}
                    <img class="img-fluid lazyload" data-src="{{ block.settings.image_4 | img_url: '1920x' }}" alt="">
                  {% if block.settings.link_4 != blank %}
                    </a>
                  {% endif %}
                  {% if block.settings.title_3 != blank %}
                    <div class="title-block text-uppercase">
                      <span>{{ block.settings.title_3 }}</span>
                      <a href="{{ block.settings.link_3 }}">{{ 'sections.img-group.shop_now' | t }}</a>
                    </div>
                  {% endif %}
                  {% if block.settings.link_4 != blank and block.settings.button_4 != blank %}
                    <div class="button">
                      <a href="{{ block.settings.link_4 }}">{{ block.settings.button_4 }}</a>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.has_fullwidth == false %}
      </div>
    {% endif %}
  </div>
</div>
