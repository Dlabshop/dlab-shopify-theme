{%- assign bg_image = section.settings.background_image -%}
{% if section.settings.background_color != blank or bg_image.src != blank %}
  <style>
    .nov-footer {
      {% if section.settings.background_color != blank %}
        background-color: {{ section.settings.background_color }};
      {% endif %}
      {% if bg_image.src != blank %}
        background-image: url("{{ bg_image | img_url: '1920x' }}");
        background-repeat: no-repeat;
      {% endif %}
    }
  </style>
{% endif %}

{%- assign bg_newsletter = section.settings.background_newsletter -%}
{% if section.settings.background_color_newsletter != blank or bg_newsletter.src != blank %}
  <style>
    .newsletter {
      {% if section.settings.background_color_newsletter != blank %}
        background-color: {{ section.settings.background_color_newsletter }};
      {% endif %}
      {% if bg_newsletter.src != blank %}
        background-image: url("{{ bg_newsletter | img_url: '1920x' }}");
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
      {% endif %}
    }
  </style>
{% endif %}
<footer data-section-id="{{ section.id }}">
  <div class="footer-layout">
    <div class="container">
      {% if section.settings.show_newsletter_footer %}
        <div class="newsletter">
          <div class="row align-items-center justify-content-between">
            <div class="col-xl-5 col-lg-5 col-md-5 col-xs-12">
              <div class="bl_newletter d-flex align-items-center">
                <div class="image_newletter">
                  {% if section.settings.icon_newsletter != blank %}
                    <img src="{{ section.settings.icon_newsletter | img_url: '100x' }}" alt="Icon Newsletter">
                  {% endif %}
                </div>
                <div class=form_newletter>
                  {% if section.settings.title_newsletter != blank %}
                    <div class="title-block">
                      <span>{{ section.settings.title_newsletter }}</span>   
                    </div>
                  {% endif %}
                  
                  {% if section.settings.newsletter_des != blank %}
                    <div class="sub_title">{{ section.settings.newsletter_des }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
            <div class="col-xl-7 col-lg-7 col-md-7 col-xs-12 newsletter_group" data-wow-delay="0.2s">
              <div class="block-content">
                <div class="site-footer__newsletter">
                  {% form 'customer' %}
                    {{ form.errors | default_errors }}
                    {% if form.posted_successfully? %}
                      <p class="form--success text-center" style="color: #fff;">{{ 'general.newsletter_form.confirmation' | t }}</p>
                    {% else %}
                      <div class="input-group">
                        <input type="hidden" name="contact[tags]" value="newsletter">
                        <input type="email"
                          name="contact[email]"
                          id="Email_nov_footer"
                          class="input-group__field newsletter__input form-control pl-15"
                          value="{% if customer %}{{ customer.email }}{% endif %}"
                          placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}">
                      </div>
                      <div class="input-group__btn">
                        <button type="submit" class="btn newsletter__submit d-flex align-items-center" name="commit" id="Subscribe_ft">
                          {{ 'general.newsletter_form.submit' | t }}
                        </button>
                      </div>
                    {% endif %}
                  {% endform %}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
      <div class="block_footer">
        <div class="container">
          {% include 'footer' %}
        </div>
      </div>
    </div>
  </div>
  <div class="footer_copyright">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between d-xs-block text-xs-center">
        <div class="copyright mb-xs-20">{{ section.settings.copyright }}</div>
        <div class="payment_icons">
          {% if section.settings.payment_icons != blank %}
            <img src="{{ section.settings.payment_icons | img_url: '300x' }}" alt="img">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</footer>

<div id="_mobile_vertical_menu" class="vertical_menu"></div>

