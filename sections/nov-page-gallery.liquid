{% if section.settings.title != blank %}
    <div class="block-gallery">
        <div class="title_block">
            <span>{{ section.settings.title | escape }}</span>
        </div>
        {% if section.settings.subheading != blank %}
            <span class="sub_title">{{ section.settings.subheading | escape }}</span>
        {% endif %}
    </div>
{% endif %}

<div id="gallery">
    <div id="image-gallery">
        <div class="row spacing-{{ section.settings.spacing }}">
            {% case section.blocks.size %}
                {% when 1 %}
                    {%- assign column_size = 'col-lg-12 col-md-12 col-sm-12 col-xs-12' -%}
                {% when 2 %}
                    {%- assign column_size = 'col-lg-6 col-md-6 col-sm-6 col-xs-6' -%}
                {% when 3 %}
                    {%- assign column_size = 'col-lg-4 col-md-4 col-sm-6 col-xs-6' -%}
                {% else %}
                    {%- assign column_size = 'col-lg-3 col-md-4 col-sm-6 col-xs-6' -%}
            {% endcase %}
        
            {% for block in section.blocks %}
            <div class="{{ column_size }} image {{ section.settings.class }}" {{ block.shopify_attributes }}>
                <div class="gallery-image__item lazyload">
                    <div class="img-wrapper">
                        {% if block.settings.image != blank %}
                            <a href="{{ block.settings.image | img_url: '1200x' }}">
                                <img class="img-responsive" src="{{ block.settings.image | img_url: '1200x' }}" alt="Gallery Image">
                            </a>
                            <div class="img-overlay">
                                <div class="icon-link"></div>
                            </div>
                        {% else %}
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>

{% schema %}
   {
        "name": "Vinova Page Gallery",
        "class": "index-section page-gallery wow fadeIn animated",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Title"
            },
            {
                "type": "text",
                "id": "subheading",
                "label": "Sub Heading"
            },
            {
                "type": "select",
                "id": "spacing",
                "label": "Spacing Items",
                "default": "0",
                "options": [
                    {
                        "label": "0px",
                        "value": "0"
                    },
                    {
                        "label": "5px",
                        "value": "5"
                    },
                    {
                        "label": "10px",
                        "value": "10"
                    },
                    {
                        "label": "15px",
                        "value": "15"
                    },
                    {
                        "label": "20px",
                        "value": "20"
                    },
                    {
                        "label": "25px",
                        "value": "25"
                    },
                    {
                        "label": "30px",
                        "value": "30"
                    }
                ]
            },
            {
                "type": "text",
                "id": "class",
                "label": "Class"
            }
        ],
        "blocks": [
            {
                "type": "image",
                "name": "Image",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link",
                        "info": "Optional"
                    }
                ]
            }
        ]
    }
{% endschema %}