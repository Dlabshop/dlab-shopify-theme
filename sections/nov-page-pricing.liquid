{% if section.settings.title != blank %}
    <div class="block-pricing">
        <div class="title_block">
            <span>{{ section.settings.title | escape }}</span>
        </div>
        {% if section.settings.subheading != blank %}
            <span class="sub_title">{{ section.settings.subheading | escape }}</span>
        {% endif %}
    </div>
{% endif %}

<div class="pricing_grid">
    <div class="row spacing-{{ section.settings.spacing }}">
        {% case section.blocks.size %}
            {% when 1 %}
                {%- assign column_size = 'col-lg-12 col-md-12 col-sm-12 col-xs-12' -%}
            {% when 2 %}
                {%- assign column_size = 'col-lg-6 col-md-6 col-sm-6 col-xs-12' -%}
            {% when 3 %}
                {%- assign column_size = 'col-lg-4 col-md-4 col-sm-4 col-xs-12' -%}
            {% when 4 %}
                {%- assign column_size = 'col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12' -%}
            {% else %}
                {%- assign column_size = 'col-lg-cus-5 col-md-cus-5 col-xs-12' -%}
        {% endcase %}
    
        {% for block in section.blocks %}
            <div class="{{ column_size }} pricing_item mb-lg-30 {{ section.settings.class }}" {{ block.shopify_attributes }}>
                <div class="block_content">
                    {% if block.settings.pricing_title != blank %}
                        <div class="pricing-title">
                            <span>{{ block.settings.pricing_title | escape }}</span>
                        </div>
                    {% endif %}
                    <div class="pricing-info">
                        <div class="pricing_price">
                            <div class="price">{{ block.settings.price_pricing }}</div>
                            <div class="per_month">{{ 'general.pricing.per_month' | t }}</div>
                        </div>

                        <div class="desc-pricing">{{ block.settings.desc_pricing }}</div>

                        <div class="list_pricing">
                            {%- assign footer_linklist = block.settings.menu_pricing -%}

                            {% if linklists[footer_linklist].links.size > 0 %}
                                <ul class="pricing_linklist list-unstyled">
                                    {% for link in linklists[footer_linklist].links %}
                                        <li class="pricing_linklist-item">
                                            <a href="{{ link.url }}">{{ link.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>

                        {% if block.settings.link != blank %}
                            <a class="pricing_link" href="{{ block.settings.link }}">{{ 'general.pricing.sign_up' | t }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{% schema %}
   {
        "name": "vinova page pricing",
        "class": "index-section page-pricing wow fadeIn animated",
        "max_blocks": 6,
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Title"
            },
            {
                "type": "text",
                "id": "subheading",
                "label": "Sub Heading"
            },
            {
                "type": "select",
                "id": "spacing",
                "label": "Spacing Items",
                "default": "0",
                "options": [
                    {
                        "label": "0px",
                        "value": "0"
                    },
                    {
                        "label": "5px",
                        "value": "5"
                    },
                    {
                        "label": "10px",
                        "value": "10"
                    },
                    {
                        "label": "15px",
                        "value": "15"
                    },
                    {
                        "label": "20px",
                        "value": "20"
                    },
                    {
                        "label": "25px",
                        "value": "25"
                    },
                    {
                        "label": "30px",
                        "value": "30"
                    }
                ]
            },
            {
                "type": "text",
                "id": "class",
                "label": "Class"
            }
        ],
        "blocks": [
            {
                "type": "item_pricing",
                "name": "Pricing Item",
                "settings": [
                    {
                        "type": "text",
                        "id": "pricing_title",
                        "label": "Pricing Title"
                    },
                    {
                        "type": "text",
                        "id": "price_pricing",
                        "label": "Pricing Pricing",
                        "default": "$69.99"
                    },
                    {
                        "type": "text",
                        "id": "desc_pricing",
                        "label": "Desc Pricing",
                        "default": "Vitae adipiscing turpis. Aenean ligula nibh, molestie id vivide ligula ipsum dolor sit amet consectetur"
                    },
                    {
                        "type": "link_list",
                        "id": "menu_pricing",
                        "label": "Choose Menu",
                        "info": "Add new menu: Admin -> Navigation"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link",
                        "info": "Optional"
                    }
                ]
            }
        ]
    }
{% endschema %}