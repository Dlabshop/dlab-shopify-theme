{% if section.settings.background_color != blank %}
  <style>
    @media (min-width: 768px) {
      .site-hd {
        {% if section.settings.background_color != blank %}
          background-color: {{ section.settings.background_color }};
        {% endif %}
      }
    }
  </style>
{% endif %}
<div data-section-id="{{ section.id }}" data-section-type="header-section">
  <header class="site-header {% if section.settings.stickymenu == true %}sticky-menu{% endif %}">
    {% include 'header' %}
  </header>
  {% if section.settings.stickymenu == true %}
    <div id="header-sticky" {% if section.settings.background_color != blank %}style="background-color: {{ section.settings.background_color_sticky }};"{% endif %}>
      <div class="container">
        <div class="row align-items-center justify-content-between">
          <div class="contentstickynew_logo col-xl-3 col-lg-3 col-md-3"></div>
          <div class="contentstickynew_menu col-xl-6 col-lg-6 col-md-6 text-center"></div>
          <div class="contentstickynew_group col-xl-3 col-lg-3 col-md-3 d-flex justify-content-end"></div>
        </div>
      </div>
    </div>
  {% endif %}
</div>
