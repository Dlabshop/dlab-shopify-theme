<div class="distance" style="padding-bottom: {{ section.settings.distance_bottom }}">
  <div data-section-id="{{ section.id }}" data-section-type="nov-slick">
    {% if section.settings.has_fullwidth == false %}
    <div class="container">
    {% endif %}
      <div class="block">
        <div class="block_header">
          {% if section.settings.title != blank %}
            <div class="{{ section.settings.title_alignment }}">
              <div class="title_block">
                <span>{{ section.settings.title | escape }}</span>
              </div>
              {% if section.settings.subheading != blank %}
                <span class="sub_title">{{ section.settings.subheading | escape }}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>
        {% for block in section.blocks %}
          {% if block.type == 'product_logo' %}
