              <div class="block_content col-xl-pr-10 col-lg-pr-10 col-md-pr-10 col-sm-12">
                <div class="block_margin">
                  <div class="block_padding">
                    {%- assign collection = collections[block.settings.collection] -%}
                    {% case block.settings.grid_number %}
                    {% when '2' %}
                      {%- assign img_size = settings.img_size_large -%}
                    {% when '3' %}
                      {%- assign img_size = settings.img_size_large -%}
                    {% when '4' %}
                      {%- assign img_size = settings.img_size -%}
                    {% when '5' %}
                      {%- assign img_size = settings.img_size -%}
                    {% when '6' %}
                      {%- assign img_size = settings.img_size -%}
                    {% endcase %}
                    {%- assign product_limit = block.settings.limit -%}
                    <div class="grid--view-items row nov-slick-carousel"
                      data-autoplay="false"
                      data-autoplayTimeout="6000"
                      data-loop="false"
                      data-margin="{{ block.settings.spacing }}"
                      data-dots="{{ block.settings.show_dots }}"
                      data-nav="{{ block.settings.show_nav }}"
                      data-row="{{ block.settings.number_row }}"
                      data-items="{{ block.settings.grid_number }}"
                      data-items_lg_tablet="{{ block.settings.grid_number_lg_tablet }}"
                      data-items_tablet="{{ block.settings.items_tablet }}"
                      data-items_mobile="{{ block.settings.items_mobile }}"
                      data-items_mobiles="{{ block.settings.items_mobiles }}">

                      {% for product in collection.products limit: product_limit %}
                        <div class="item col{% if block.settings.number_row != '1' %} mb-0{% endif %}">
                          {% include 'product-card-grid', img_size: img_size, mr_bottom: 'mb-40' %}
                        </div>
                      {% else %}
                        {% for i in (1..product_limit) %}
                          <div class="item col{% if block.settings.number_row != '1' %} mb-0{% endif %}">
                            <div class="item-product mb-20">
                              <div class="thumbnail-container">
                                <a href="{{ collection.url }}">
                                  {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                                  {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                </a>
                              </div>
                              <div class="product__info text-center">
                                <div class="product__title">
                                  <a href="{{ collection.url }}">{{ 'homepage.onboarding.product_title' | t }}</a>
                                </div>
                                <div class="product__price">
                                  {% include 'product-price' %}
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endfor %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>
              {% if block.settings.show_view_all %}
                <div class="show_all">
                  <a href="{{ collection.url }}">
                    {{ 'sections.collection_grid.view_all' | t }}
                  </a>
                </div>
              {% endif %}
            </div>
          {% endif %}
          {% if block.type == 'product_grid' %}
            <div class="product_grid">
              <div class="row spacing-{{ block.settings.spacing }}">
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-xs-12">
                  <div class="product_one_left">
                    <div class="product_item_1">
                      {% assign product = all_products[block.settings.product_handle_left_1] %}
                      {% assign variantCount = product.variants | size %}
                      {% if product != empty %}
                        <div class="item">
                          <div class="item-product{% unless product.available %} product-price--sold-out{% endunless %}">
                            <div class="thumbnail-container{% if product.images.size > 2 %} has-multiimage{% endif %}">
                              <a href="{{ product.url | within: collection }}">
                                <img class="img-fluid product__thumbnail lazyload" src="{{ product.featured_image | product_img_url: '270x270' }}" alt="{{ product.featured_image.alt | escape }}">
                              </a>
                              {% if product.compare_at_price > product.price %}
                                <div class="badge_sale">
                                  <div class="badge badge--sale-rt">{{ 'products.product.new' | t }}</div>
                                  <span class="badge badge--sale-pt">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round: 4 }}%</span>
                                </div>
                              {% endif %}
                            </div>
                            <div class="product__info">
                              <div>
                                <div class="product__title">
                                  <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
                                </div>
                                {% if settings.show_rating %}
                                  <div class="product__review">
                                    <div class="rating"><span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span></div>
                                  </div>
                                {% endif %}
                                <div class="product__price">
                                  {% include 'product-price' %}
                                </div>
                                <div class="group-buttons d-flex{% if justify.size > 0 %} {{ justify }}{% endif %} justify-content-center">
                                  {% assign variantCount = product.variants | size %}
                                  <form class="formAddToCart" action="/cart/add" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                                    {% if sold_out %}
                                      <button class="btn btnAddToCart disabled" type="submit" value="Submit" 
                                        data-handle="{{ product.handle }}"
                                        {% if settings.tooltip_enable %} 
                                          data-toggle="tooltip" 
                                          data-placement="top" 
                                        {% endif %}
                                        title="" tabindex="0" disabled >
                                        <i class="zmdi zmdi-block-alt"></i>
                                      </button>
                                    {% else %}
                                      {% if variantCount > 1 %}
                                        <a class="btn btnAddToCart btnChooseVariant" 
                                          href="javascript:void(0);" 
                                          data-url="/products/{{ product.handle }}?view=json"
                                          {% if settings.tooltip_enable %} 
                                            data-toggle="tooltip" 
                                            data-placement="top" 
                                          {% endif %}
                                          title="" tabindex="0">
                                          <i class="zmdi zmdi-check"></i>
                                          <span>{{ 'products.product.select_options' | t }}</span>
                                        </a>
                                      {% else %}
                                        <button class="btn btnAddToCart" type="submit" value="Submit" 
                                          data-handle="{{ product.handle }}"
                                          data-pid="{{ product.variants.first.id }}"
                                          {% if settings.tooltip_enable %} 
                                            data-toggle="tooltip" 
                                            data-placement="top" 
                                          {% endif %}
                                          title="" tabindex="0">
                                          <i class="icon_cart"></i>
                                          <span>{{ 'products.product.add_to_cart' | t }}</span>
                                        </button>
                                      {% endif %}
                                    {% endif %}
                                  </form>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      {% endif %}
