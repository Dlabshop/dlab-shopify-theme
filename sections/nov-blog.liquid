<div class="distance" style="padding-top: {{ section.settings.distance_top }}; padding-bottom: {{ section.settings.distance_bottom }}">
  <div data-section-id="{{ section.id }}" class="{% if section.settings.class != blank %} {{ section.settings.class }}{% endif %}" {% if section.settings.type_option == 'slider' %}data-section-type="nov-slick"{% endif %}>
    {% if section.settings.has_fullwidth == false %}
    <div class="container"> 
    {% endif %}
      <div class="nov-blog">
        <div class="page-width">
          <div class="block">
            <div class="{{ section.settings.title_alignment }}">
              {% if section.settings.title != blank %}
                <div class="title_block">
                  <i class="zmdi zmdi-comments"></i>
                  <span>{{ section.settings.title | escape }}</span>
                </div>
              {% endif %}
              {% if section.settings.subheading != blank %}
                <div class="sub_title">{{ section.settings.subheading | escape }}</div>
              {% endif %}
            </div>

            {%- assign collection_blog = blogs[section.settings.blog] -%}
            {% case section.settings.grid_number %}
            {% when '2' %}
              {%- assign img_size = settings.img_size_large -%}
            {% when '3' %}
              {%- assign img_size = settings.img_size_large -%}
            {% when '4' %}
              {%- assign img_size = settings.img_size -%}
            {% when '5' %}
              {%- assign img_size = settings.img_size -%}
            {% when '6' %}
              {%- assign img_size = settings.img_size -%}
            {% endcase %}
            {%- assign blog_limit = section.settings.limit -%}

            {% if section.settings.type_option == 'grid' %}
              {% for article in collection_blog.articles limit: blog_limit %}
                <div class="item col">
                  <div class="article--listing">
                    {% if section.settings.show_image == true %}
                      {% if article.image %}
                        <a href="{{ article.url }}" class="article__list-image-container">
                          <img class="article__list-image lazyload" src="{{ article.image | img_url: '270x' }}" alt="{{ article.image.alt | escape }}">
                          {% if section.settings.blog_show_date %}
                            <div class="article__date text-uppercase">
                              <!-- <i class="icon-calendar"></i> -->
                              <div class="date_day">{{ article.published_at | date: "%d" }}</div>
                              <div class="date_month">{{ article.published_at | date: "%b" }}</div>
                            </div>
                          {% endif %}
                        </a>
                      {% endif %}
                    {% endif %}
                    <div class="media-body">
                      <div class="article__info">
                        <div class="article_cs">
                          {% if section.settings.blog_show_comments %}
                            <span class="article__countcomment text-uppercase">
                              <!-- <i class="zmdi zmdi-comments"></i> -->
                              {{ 'blogs.comments.comments_with_count' | t: count: article.comments_count }}
                            </span>
                          {% endif %}
                          
                          {% if section.settings.blog_show_author %}
                            <span class="article__author">
                              <i class="zmdi zmdi-account-o"></i>
                              by {{ 'blogs.article.by_author' | t: author: article.author }}
                            </span>
                          {% endif %}
                        </div>

                        {% if section.settings.enable_viewmore == true %}
                          <a href="{{ article.url }}" class="article__readmore">{{ 'blogs.article.readmore' | t }}</a>
                        {% endif %}
                      </div>
                      <div class="article__title">
                        <a href="{{ article.url }}">{{ article.title }}</a>
                      </div>
                      {% if section.settings.blog_show_excerpt %}
                        <div class="article__excerpt">
                          {% if article.excerpt.size > 0 %}
                            {{ article.excerpt | truncate: 90 }}
                          {% else %}
                            {{ article.content | strip_html | truncate: 84 }}
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="slider grid--view-items row nov-slick-carousel" 
                data-autoplay="false" 
                data-autoplayTimeout="6000" 
                data-loop="false" 
                data-margin="{{ section.settings.spacing }}" 
                data-dots="{{ section.settings.show_dots }}" 
                data-nav="{{ section.settings.show_nav }}" 
                data-row="{{ section.settings.number_row }}" 
                data-items="{{ section.settings.grid_number }}" 
                data-items_lg_tablet="{{ section.settings.grid_number_lg_tablet }}" 
                data-items_tablet="{{ section.settings.items_tablet }}" 
                data-items_mobile="{{ section.settings.items_mobile }}"
                data-items_mobiles="{{ section.settings.items_mobile_480 }}">
                {% for article in collection_blog.articles limit: blog_limit %}
                  <div class="item col">
                    <div class="article--listing">
                      {% if section.settings.show_image == true %}
                        {% if article.image %}
                          <a href="{{ article.url }}" class="article__list-image-container">
                            <img class="article__list-image lazyload" data-src="{{ article.image | img_url: '570x270' }}" alt="{{ article.image.alt | escape }}">
                            {% if section.settings.blog_show_date %}
                              <div class="article__date text-uppercase">
                                <!-- <i class="icon-calendar"></i> -->
                                <div class="date_day">{{ article.published_at | date: "%d" }}</div>
                                <div class="date_month">{{ article.published_at | date: "%b" }}</div>
                              </div>
                            {% endif %}
                          </a>
                        {% endif %}
                      {% endif %}
                      <div class="media-body">
                        <div class="article__info">
                          <div class="article_cs">
                            {% if section.settings.blog_show_comments %}
                              <span class="article__countcomment text-uppercase">
                                <!-- <i class="zmdi zmdi-comments"></i> -->
                                {{ 'blogs.comments.comments_with_count' | t: count: article.comments_count }}
                              </span>
                            {% endif %}
                            
                            {% if section.settings.blog_show_author %}
                              <span class="article__author">
                                <i class="zmdi zmdi-account-o"></i>
                                by {{ 'blogs.article.by_author' | t: author: article.author }}
                              </span>
                            {% endif %}
                          </div>

                          {% if section.settings.enable_viewmore == true %}
                            <a href="{{ article.url }}" class="article__readmore">{{ 'blogs.article.readmore' | t }}</a>
                          {% endif %}
                        </div>
                        <div class="article__title">
                          <a href="{{ article.url }}">{{ article.title }}</a>
                        </div>
                        {% if section.settings.blog_show_excerpt %}
                          <div class="article__excerpt">
                            {% if article.excerpt.size > 0 %}
                              {{ article.excerpt | truncate: 123 }}
                            {% else %}
                              {{ article.content | strip_html | truncate: 123 }}
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            {% if section.settings.show_view_all %}
              <div class="view_all text-center">
                <a href="{{ blogs.url }}" class="btn">
                  {{ 'collections.general.view_all' | t }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% if section.settings.has_fullwidth == false %}
    </div>
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Blog Slider",
    "class": "index-section nov-section-blog wow fadeIn animated",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Vinova Blog Slider"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Sub Heading",
        "default": "Subtitle from happy customers"
      },
      {
        "type": "select",
        "id": "title_alignment",
        "label": "Title alignment",
        "default": "text-left",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "blog",
        "id": "blog",
        "label": "Blog"
      },
      {
        "type": "select",
        "id": "type_option",
        "label": "Type Blog",
        "options": [
          {
            "value": "grid",
            "label": "Grid View"
          },
          {
            "value": "slider",
            "label": "Slider View"
          }
        ]
      },
      {
        "type": "range",
        "id": "grid_number",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Post per row (Large Desktop)",
        "default": 3,
        "info": "Select number Items Large Desktop for slider"
      },
      {
        "type": "range",
        "id": "grid_number_lg_tablet",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Items Desktop",
        "default": 3,
        "info": "Select number Items Desktop for slider"
      },
      {
        "type": "range",
        "id": "items_tablet",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Items Tablet",
        "default": 3,
        "info": "Select number Items Tablet for slider"
      },
      {
        "type": "range",
        "id": "items_mobile",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Items Mobile",
        "default": 2,
        "info": "Select number Items Mobile for slider"
      },
      {
        "type": "range",
        "id": "items_mobile_480",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Items Mobile",
        "default": 1,
        "info": "Select number Items Mobile 480 for slider"
      },
      {
        "type": "select",
        "id": "number_row",
        "label": "Number Row",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          }
        ]
      },
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 8,
        "info": "Select number limit post"
      },
      {
        "type":  "header",
        "content": "Slider Option"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 5,
        "max": 50,
        "step": 5,
        "label": "Spacing Item",
        "default": 30,
        "info": "Select number spacing for item slider"
      },
      {
        "type": "checkbox",
        "id": "show_image",
        "label": "Show Image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show Navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "blog_show_comments",
        "label": "Show Comments",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "blog_show_author",
        "label": "Show author",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "blog_show_date",
        "label": "Show Date",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "blog_show_excerpt",
        "label": "Show Excerpt",
        "default": true
      },
      {
        "type":  "header",
        "content": "Design Option"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "checkbox",
        "id": "show_view_all",
        "label": "Show 'View all' button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "has_fullwidth",
        "label": "Full Width",
        "default":   false
      },
      {
        "type": "text",
        "id": "distance_top",
        "label": "Top Distance Section",
        "default": "30px"
      },
      {
        "type": "text",
        "id": "distance_bottom",
        "label": "Bottom Distance Section",
        "default": "30px"
      }
    ],
    "presets": [
      {
        "name": "Vinova Blog Slider",
        "category": "Blog"
      }
    ]
  }
{% endschema %}