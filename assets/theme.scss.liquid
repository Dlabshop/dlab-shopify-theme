				@include display(none);
			}
			.thumbnail-container {
				background: #f5f5f5;
			}
			.product__info {
				padding: 15px 0 0;
				.product__title a {
					font-size: 13px;
					color: $color-heading-sub;
				}
				.product__review {
					margin-bottom: 5px;
				}
