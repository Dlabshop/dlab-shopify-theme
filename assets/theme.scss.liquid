// Swatch ========================================================================================================= */
.swatch {
	@include align-items(center);
	@include flexbox();
	.swatch-element {
		position: relative;
		&:not(:last-child) {
			@include rtl-margin-right(10px);
			margin-bottom: 10px;
		}
		&.soldout {
          	.crossed-out {
              	@include display(block);
              	cursor: no-drop;
          	}
        }
		.crossed-out {
			@include display(none);
		}
		&:not(.color) {
			input {
				@include display(none);
			}
			label {
				@include transition(all 0.2s linear);
				font-family: $font-family-primary;
				color: $color-heading-sub;
				font-size: 11px;
				font-weight: 400;
				text-transform: initial;
				border: 1px solid #ebebeb;
				@include border-radius(2px);
				min-width: 26px;
				min-height: 26px;
				line-height: 24px;
				margin-top: 25px;
				background: $color-white;
			}
			input:checked + label, label:hover {
				color: $color-white;
				background: #424242;
				border: 1px solid #424242;
				@include transition(all 0.35s ease);
			}
		}
		&.color {
			label {
				@include square(26px);
				min-width: 26px;
				@include transition(all 0.2s linear);
				@include border-radius(3px);
			}
			input:checked + label, label:hover {
				border: 2px solid $color-white;
				@include box-shadow(0 0 0 1px $color-black);
				@include transition(all 0.35s ease);
			}
		}
		&.white {
			label {
				border: 1px solid #d7d7d7;
			}
		}
	}
	input {
		@include opacity(0);
		visibility: hidden;
	}
	.header {
		font-size: 11px;
		font-family: $font-family-primary;
		font-weight: bold;
		color: $color-heading-sub;
		text-transform: uppercase;
		@include rtl-margin-right(15px);
		margin-top: 15px;
		min-width: 55px;
	}
	label {
		@include border-radius(0);
		margin: 0;
		text-align: center;
		@include rtl-float-left();
		font-size: 12px;
		text-transform: uppercase;
		white-space: nowrap;
		cursor: pointer;
		font-family: $font-family-default;
	}
	input:checked + label, label:hover {
		border-color: #343434;
		border-width: 1px;
		@include transition(all 0.35s ease);
	}
	.crossed-out {
		position: absolute;
		@include square(100%);
		@include rtl-left(0);
		top: 0;
	}
	.tooltip {
		display: none;
	}
	@media (max-width: 375px) {
		.swatch-element:not(.color) label {
			margin-top: 0;
		}
		.header {
			margin-top: 0;
		}
	}
}
.product-swatch-color {
	margin-bottom: 25px;
	@include align-items(center);
	.swatch-element {
		@include rtl-float-left();
		position: relative;
		&:not(:last-child) {
			@include rtl-margin-right(10px);
		}
		a {
			@include square(20px);
			@include border-radius(2px);
			@include transition(all 0.2s linear);
			@include display(inline-block);
			position: relative;
			border: 2px solid $color-white;
			@include box-shadow(0 0 0 1px #d8d8d8);
			&:before {
				content: "\f26b";
				position: absolute;
				font-family: "Material-Design-Iconic-Font";
				font-size: 11px;
				@include rtl-left(50%);
				top: 50%;
				@include translate(-50%, -50%);
				color: $color-white;
				@include opacity(0);
			}
			&.active, &:hover {
				&:before {
					@include opacity(1);
					@include transition(all 0.35s ease);
				}
			}
		}
		&.white {
			a:after {
				content: "";
				position: absolute;
				@include square(18px);
				@include border-radius(50%);
				border: 1px solid #d8d8d8;
				top: 50%;
				@include rtl-left(50%);
				@include translate(-50%, -50%);
			}
			a.active:before {
				color: #ccc;
			}
		}
	}
	input {
		@include display(none);
	}
	.header {
		font-size: 12px;
		margin-bottom: 15px;
		font-weight: bold;
		color: $color-heading-second;
	}
	label {
		@include border-radius(50%);
		margin: 0;
		text-align: center;
		@include rtl-float-left();
		font-size: 12px;
		text-transform: uppercase;
		white-space: nowrap;
		cursor: pointer;
		padding: 0 5px;
		font-family: $font-family-default;
	}
	input:checked + label, label:hover {
		border-color: #343434;
		border-width: 2px;
		line-height: 28px;
		@include transition(all 0.35s ease);
	}
	.crossed-out {
		position: absolute;
		@include square(100%);
		@include rtl-left(0);
		top: 0;
	}
}
