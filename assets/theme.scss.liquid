	}
	@media (max-width: 991px) {
		.blog--list-view {
			.article--listing {
				display: block;
			}
			.media-image {
				@include flex(0 0 100%);
				@include rtl-margin-right(0);
				margin-bottom: 15px;
			}
			.media-body {

			}
		}
	}
	@media (max-width: 375px) {
