}

.list-filter-selected {
	margin: 41px 0 0 ;
	@include rtl-margin-lr(0,10px);
	.filter-item_title {
		a {
			padding: 7.5px 9.04px;
			background: #c4c4c4;
			@include border-radius(4px);
			display: inline-block;
			font-family: $font-family-default;
			font-size: 11px;
			font-weight: bold;
			color: $color-white;
			&:hover {
				background: $theme-color-primary;
			}
		}
	}
}
.list-filter {
	margin-top: 28px;
	.filter-item {
		&:not(:last-child) {
			margin-bottom: 25px;
		}
		.filter-item_title {
			font-family: $font-family-primary;
			color: $color-heading;
			font-size: 12px;
			font-weight: bold;
			text-transform: uppercase;
			position: relative;
			span {
				display: block;
				padding: 10px 0 14px;
				@include rtl-padding-lr(0,10px);
			}
		}
		.custom-checkbox {
			background: $color-white;
			@include border-radius(1px);
			@include square(16px);
			border: 1px solid #dbdbdb;
			position: relative;
			@include display(inline-block);
			vertical-align: middle;
			@include rtl-margin-right(15px);
		}
		.filter-item_content {
			padding: 8px 0 0;
			@include rtl-padding-lr(0,10px);
			.list-inline {
				padding: 0;
			}
			.list-unstyled {
				&.facet-hasscroll {
					overflow-y: scroll;
					max-height: 140px;
					&::-webkit-scrollbar-track{
						background-color: $color-white;
						@include border-radius(20px);
					}
					&::-webkit-scrollbar {
						width: 8px;
						background-color: $color-white;
						@include border-radius(20px);
					}
					&::-webkit-scrollbar-thumb {
						@include border-radius(20px);
						background-color: #cadae2;
					}
				}
				li {
					cursor: pointer;
					font-size: 13px;
					color: $color-heading-sub;
					font-family: $font-family-default;
					font-weight: 400;
					&:hover {
						color: $theme-color-hover;
					}
					&:not(:last-child) {
						margin-bottom: 11px;
					}
					&.active {
						.custom-checkbox {
							@include border-radius(2px);
							border: 1px solid $theme-color-primary;
							background: $theme-color-primary;
						}
					}
				}
			}
		}
		&.filter-price {
			margin-bottom: 21px;
			.filter-item_title {
				margin-bottom: 9px;
			}
			.filter-item_content {
				@include rtl-padding-lr(0,25px);
			}
			.ui-slider-horizontal {
				height: 8px;
				border: none;
				background: #e1e1e1;
				@include border-radius(4px);
				.ui-slider-range {
					background: $theme-color-primary;
					border-color: $theme-color-primary;
					@include border-radius(4px);
				}
				.ui-slider-handle {
					@include border-radius(50%);
					@include square(19px);
					background: $color-white;
					border: 6px solid $theme-color-primary;
					top: -6px;
					border-color: $theme-color-primary;
					cursor: grab;
					@include rtl-margin-left(-3px);
				}
			}
			.price-input {
				font-family: $font-family-default;
				font-weight: 400;
				font-size: 12px;
				color: $color-heading-sub;
				margin: 21px 0 0;
			}
		}
		&.filter-color {
			margin-bottom: 12px;
			.filter-item_title {
				span {
					padding: 10px 21px;
					@include rtl-padding-lr(0,10px);
				}
			}
			.list-inline-item {
				@include rtl-margin-right(0);
				margin-bottom: 5px;
				cursor: pointer;
				&[data-value="white"] {
					.custom-checkbox {
						border: 1px solid #d7d7d7;
					}
				}
				.custom-checkbox {
					@include square(26px);
					@include border-radius(100%);
					@include rtl-margin-right(6px);
					border: none;
					&:before {
						@include display(none);
					}
					&:hover {
						border: 1px solid $color-white;
						@include box-shadow(0 0 0 1px #d8d8d8);
					}
				}
				&.active .custom-checkbox {
					@include box-shadow(0 0 0 1px #d8d8d8);
				}
			}
		}
		&.filter-size {
			.list-inline {
				li {
					min-width: 55px;
					height: 34px;
					line-height: 34px;
					@include border-radius(0);
					text-align: center;
					border: 1px solid #d7d7d7;
					cursor: pointer;
					font-family: $font-family-default;
					font-size: 13px;
					font-weight: 400;
					color: $color-heading-sub;
					@include rtl-margin-right(10px);
					margin-bottom: 10px;
					background: $color-white;
					&:hover, &.active {
						background: #424242;
						color: $color-white;
						border-color: transparent;
					}
					.filter-option-value {
						@include display(inline-block);
					}
				}
			}
			.filter-item_content {
				padding: 15px 0 0;
				@include rtl-padding-lr(0,10px);

			}
		}
	}
}

@media (max-width: 1199px) {
	.sidebar .sidebar-block {
		margin-bottom: 25px;
	}
	.categories__sidebar .block__content {
		margin-top: 15px;
	}
	.list-filter {
		margin-top: 15px;
		.filter-item {
			&.filter-color .list-inline-item .custom-checkbox {
				@include square(20px);
			}
			&.filter-size .list-inline li {
				@include square(35px);
				line-height: 35px;
			}
		}
	}
}
/* sortPagiBar =============================================================================================================*/
.collection_vn {
	margin-bottom: 50px;
	@media (max-width: 767px) {
		margin-bottom: 0;
	}
}
.collection_title {
	font-family: $font-family-primary;
	font-weight: 600;
	color: $color-heading;
	font-size: 2.4rem;
	margin: 0 0 35px;
}
.collection_description {
	background: #f3f3f3;
	padding: 30px 30px 7px;
	@include border-radius(4px);
	margin-top: 36px;
	strong {
		font-family: $font-family-primary;
		font-size: 1.4rem;
		font-weight: 600;
		color: $color-heading;
		margin-bottom: 6px;
		display: block;
	}
	p {
		font-family: $font-family-default;
		font-size: 13px;
		font-weight: 400;
