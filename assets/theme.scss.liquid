/* Page Gallery ===========================================================================================================*/
.page-gallery {
	margin-bottom: 50px;
	.block-gallery {
		margin-bottom: 44px;
	}
	.title_block {
		font-family: $font-family-primary;
		font-weight: 600;
		font-size: 2.4rem;
		color: $color-heading;
		text-transform: none;
		margin: -9px 0 12px;
	}
	.sub_title {
		font-family: $font-family-default;
		font-weight: 400;
		font-size: 13px;
		color: $color-heading-sub;
	}
	
	#gallery {
		.img-wrapper {
			position: relative;
			cursor: pointer;
			@include scale(1, 1);
			@include transition(all 0.4s ease);
			img {
				width: 100%;
			}
			&:hover {
				@include scale(1.15, 1.15);
				@include transition(all 0.4s ease);
			}
		}
		.img-overlay {
			background: rgba(0,0,0,0.7);
			@include square(100%);
			position: absolute;
			top: 0;
			@include rtl-left(0);
			@include flexbox();
			@include justify-content(center);
			@include align-items(center);
			@include opacity(0);
			.icon-link {
				position: absolute;
				top: 0;
				bottom: 0;
				display: block;
				@include transition(all 0.4s ease);
				margin: auto;
				@include square(40px);
				background: $color-white;
				@include border-radius(100%);
				@include box-shadow(0 0 0 5px rgba(255,255,255,0.3));
				text-align: center;
				line-height: 40px;
				@include opacity(0);
				z-index: 1;
				font-size: 1.4rem;
				font-weight: 400;
				color: $theme-color-primary;
				@include scale(0, 0);
				&:hover {
					background: $theme-color-hover;
					color: $color-white;
				}
				&:before {
					content: "\F07B";
					font-family: "fontello";
					@include rtl-margin-left(0);
				}
			}
			&:hover {
				@include opacity(1);
				@include transition(all 0.3s ease);
				.icon-link {
					@include opacity(1);
					@include scale(1, 1);
				}
			}
		}
		#overlay {
			background: rgba(0,0,0,0.8);
			@include square(100%);
			position: fixed;
			top: 0;
			@include rtl-left(0);
			@include flexbox();
			@include justify-content(center);
			@include align-items(center);
			z-index: 999;
			// Removes blue highlight
			-webkit-user-select: none;
			-moz-user-select: none;    
			-ms-user-select: none; 
			user-select: none; 
			img {
				margin: 0;
				width: 80%;
				height: auto;
				object-fit: contain;
				padding: 5%;
				@media screen and (min-width:768px) {
					width: 60%;
				}
				@media screen and (min-width:1200px) {
					width: 50%;
				}
			}
		}
		#exitButton {
			color: $color-white;
			font-size: 2rem;
			transition: opacity 0.8s;
			position: absolute;
			top: 0;
			@include rtl-right(15px);
			&:hover {
				cursor: pointer;
				color: $theme-color-hover;
			}
			@media screen and (min-width:768px) {
				font-size: 3rem;
			}
		}
	}
}
/*========================================== End Templates | Gallery ======================================================*/

