.sidebarmenu_content {
	width: 284px;
	position: fixed;
	z-index: 9999;
	top: 0;
	@include rtl-left(-360px);      
	@include box-shadow(5px 0 12px rgba(0,0,0,.25));
	@include transition(all 0.3s ease 0.15s);
	a:hover {
		text-decoration: none;
		@include transition(all 0.35s ease);
	}
	.sidebarmenu_list_content {
		padding: 115px 30px 40px;
