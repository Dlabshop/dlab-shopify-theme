			width: 100%;
			bottom: 50px;
			@include opacity(0);
			.formAddToCart {
				@include transition(all 0.3s ease);
				@include translateY(40px);
			}
			.productWishList {
				@include transition(all 0.3s ease 0.15s);
				@include translateY(40px);
			}
			.productQuickView {
				@include transition(all 0.3s ease 0.25s);
				@include translateY(40px);
			}
		}
		&:hover {
			.group-buttons {
				@include opacity(1);
				.formAddToCart, .productWishList, .productQuickView {
					@include translateY(0);
				}
			}
			.countdownfree {
				@include translateX(50px);
				@include opacity(0);
			}
			.thumbnail-container.has-multiimage img:not(.product__thumbnail-second) {
				@include opacity(1);
			}
		}
	}
	.owl-theme .owl-nav {
		position: absolute;
		bottom: 0;
		@include rtl-right(0);
		margin-top: 0;
		background: #ffcd35;
		@include border-radius(10px 0 10px 0);
		line-height: 1;
		[class*='owl-'] {
			font-size: 30px;
			background: transparent;
			padding: 0 20px;
			margin: 0;
			&.owl-prev {
				position: relative;
				&:before {
					content: "";
					position: absolute;
					width: 1px;
					height: 16px;
					top: 50%;
					@include translateY(-50%);
					@include rtl-right(0);
					background: $color-white;
				}
			}
			&:hover {
				color: $theme-color-hover;
			}
		}
	}
	@media(min-width: 992px) {
		.slider-nav {
			width: 80px;
			min-width: 80px;
			.thumbItem {
				margin: 5px 0;
			}
		}
		.slider-for {
			width: calc(100% - 80px);
		}
	}
	@media(max-width: 991px) {
		.slider-nav .thumbItem {
			margin: 0 5px;
		}
	}	
}

// Product Deals ==================================================================================================== */
.section-product-deal {
	.distance {
		overflow: hidden;
	}
	.title_block {
		font-family: $font-family-primary;
		font-size: 1.6rem;
		font-weight: 800;
		color: $color-heading;
		text-transform: uppercase;
		background: $theme-color-primary;
		@include border-radius(9px 9px 0 0);
		@include flexbox();
    	@include align-items(center);
	    margin: 0;
		padding: 21px 0 17px;
		i {
			font-size: 2.4rem;
			color: $color-heading;
			padding: 0 34px 0 21px;
		}
	}
	.sub_title {
		display: block;
		font-family: $font-family-default;
		font-weight: 400;
		font-size: 13px;
		line-height: 20px;
		color: $color-heading-sub;
		width: 44%;
		margin: 0 auto;
	}
	.nov-slick-carousel {
		.slick-arrow {
			@include square(32px);
			line-height: 32px;
			top: 12px;
			@include translateY(0);
			@include border-radius(2px);
			border: 1px solid #eee;
			background: #eee;
			text-align: center;
			i {
				font-size: 1.8rem;
				font-weight: 400;
			}
			&.arrow-prev {
				@include rtl-right(37px);
			}
			&.arrow-next {
				@include rtl-right(0);
			}
			&:hover {
				@include box-shadow(none);
				border: 1px solid $theme-color-primary;
				background: $theme-color-primary;
				i {
					color: $color-white;
				}
			}
		}
		.slick-dots {
			position: absolute;
			bottom: 28px;
			@include rtl-left(50%);
			@include translateX(-50%);
			li {
				@include square(12px);
			    margin: 0 2.5px;
				button {
					@include square(12px);
					&:before {
						@include square(12px);
					}
				}
			}
		}
	}
	.grid--view-items {
		margin: 0 -15px;
		position: relative;
		.item {
			padding: 0 15px;
		}
		.slick-list {
			overflow: initial;
		}
		.item-product {
			margin: 0;
		    border: 1px solid $theme-color-primary;
		    border-top: none;
		    @include border-radius(0 0 9px 9px);
			&:before {
				display: none;
			}
			.thumbnail-container {
				display: block;
				position: relative;
				.countdownfree {
					position: absolute;
					bottom: 12px;
					@include rtl-left(50%);
					@include translateX(-50%);
					@include flexbox();
					@include align-items(center);
					.item-time {
						text-align: center;
						@include square(50px);
						background: $color-white;
						@include border-radius(4px);
						@include flexbox();
						@include align-items(center);
						@include justify-content(center);
						@include box-shadow(2px 2px 0px 0px #ffd700);
						.data-time span:not(.name-time) {
							font-family: $font-family-primary;
							color: #000;
							font-size: 13px;
							font-weight: 900;
							display: inline-block;
							margin: 0;
							&:after {
								content: '';
								display: block;
								background: #f0ca00;
								width: 100%;
								height: 1px;
							}
						}
						.name-time {
							font-family: $font-family-default;
							font-size: 10px;
							color: #909090;
							line-height: 1;
							font-weight: 400;
							margin: 5px 0 0 0;
						}
						&:last-child {
							margin-bottom: 0;
						}
					}
				}
			}
			.product__info {
				position: relative;
				margin-bottom: 0;
		    	padding: 15px 0 66px;
				.product__review {
				    margin: 0;
			        padding-bottom: 9px;
				}
				.product__title {
				    margin: 0;
				   	padding: 0 0 2px;
				}
				.product__price {
				    margin-bottom: 0;
				    padding-bottom: 25px;
				    color: #e85b40;
				    s.product-price__price {
			    	    @include rtl-margin-left(22px);
				    }
				}
			}
			.formAddToCart {
				margin: 0;
				.btnAddToCart {
					background: #f0f0f0;
					padding: 11.5px 35px;
					&:hover {
						background: $theme-color-primary;
						@include box-shadow(0 0 5px 0 rgba(0,0,0,.2));
					}
				}
			}
			.group-buttons {
				@include justify-content(center !important);
			}
			&:hover {
				@include box-shadow(none);
				border-color: $theme-color-primary !important;
			}
		}
	}
	@media (max-width: 1199px) {
		.grid--view-items {
			.item-product {
				.thumbnail-container {
					.countdownfree .item-time {
						@include square(40px);
					}
				}
				.product__info {
					padding: 15px 0 50px;
					.product__price {
					    padding-bottom: 12px;
					}
				}
			}
		}
		.nov-slick-carousel .slick-dots {
		    bottom: 20px;
		}
	}
	@media (max-width: 991px) {
		.grid--view-items {
		    margin-top: 15px;
			.item-product {
				border: 1px solid $theme-color-primary;
				@include border-radius(9px);
				.thumbnail-container {
					.countdownfree {
						.item-time {
							@include square(40px);
							@include align-items(initial);
						}
					}
				}
				.product__info {
				    padding: 15px 0;
				}
				.formAddToCart .btnAddToCart {
					padding: 11.5px 0;
				    min-width: 170px;
				}
			}
		}
		.nov-slick-carousel .slick-dots {
	    	bottom: -40px;
		}
	}
	@media (max-width: 767px) {
		.nov-slick-carousel .slick-dots {
		    bottom: -25px;
		}
	}
	@media (max-width: 575px) {
		.grid--view-items {
			.item-product {
				.productWishList {
					@include translateY(0);
				    @include opacity(1);
				    visibility: initial;
				    display: block !important;
				}
				.product__info {
				    padding: 15px 0 40px;
				}
			}
		}
		.nov-slick-carousel .slick-dots {
		    bottom: 15px;
		}
	}
}

