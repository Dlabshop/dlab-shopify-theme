	        		border: none;
	        		min-width: 18px;
	        		@include flexbox();
	        		@include align-items(center);
	        		@include justify-content(center);
	        		&.cart__popup-qty--minus {
	        			@include rtl-border-right(1px solid #ebebeb);
	        		}
	        		&.cart__popup-qty--plus {
	        			@include rtl-border-left(1px solid #ebebeb);
	        		}
	        		&:hover {
	        			color: $theme-color-hover;
	        		}
        		}
        		.quantity {
        			border: 1px solid #e0e0e0;
        			max-width: 89px;
        		}
        	}
        	.cart__popup-total {
        		min-width: 115px;
        		@include rtl-text-align-right();
        		font-family: $font-family-primary;
        		font-weight: 800;
        		font-size: 1.4rem;
        		color: $color-heading;
        	}
        }
        .cart-notice-total {
    	    padding: 35px 0 2px;
        	.col-left {
        		font-family: $font-family-primary;
        		font-weight: 800;
        		font-size: 12px;
        		color: $color-heading;
        		text-transform: uppercase;
        		i {
        			font-size: 1.5rem;
        			color: #30b94d;
        			@include rtl-margin-right(9px);
        		}
        		.money {
        			color: #30b94d;
        		}
        	}
        	.col-right {
        		font-family: $font-family-primary;
        		font-weight: 800;
        		font-size: 1.4rem;
        		color: $color-heading;
        		text-transform: uppercase;
        		.cart__popup-stotal {
        			.money {
        				font-size: 1.8rem;
        				color: $theme-color-hover;
        				@include rtl-margin-left(24px);
        			}
        		}
        	}
        }
        .cart__popup-action {
        	margin-bottom: 47px;
        	.button {
        		border: 1px solid $color-heading;
        		width: 100%;
        		min-height: 46px;
        		@include flexbox();
        		@include align-items(center);
        		@include justify-content(center);
        		text-align: center;
        		position: relative;
        		overflow: hidden;
        		&:after {
        			content: '';
        			position: absolute;
        			z-index: 1;
        			width: 0%;
        			height: 100%;
        			top: 0;
        			@include rtl-left(0);
        			background: $color-heading;
        			@include transition(all 0.5s ease);
        		}
        		span {
        			z-index: 10;
        			position: relative;
        			font-family: $font-family-default;
        			font-weight: bold;
        			font-size: 10px;
        			color: $color-heading;
        			text-transform: uppercase;
        			letter-spacing: 0.2px;
        		}
        		&:hover {
        			background: $color-heading;
        			border: 1px solid $color-heading;
        			@include transition(all 0.5s ease);
        			span {
        				color: $color-white;
        			}
        			&:after {
        				width: 100%;
        				@include transition(all 0.5s ease);
        			}
        		}
        	}
        	.class_none_bundle {
        		background: $color-heading;
        		@include rtl-margin-right(30px);
        		span {
        			color: $color-white;
        		}
        		&:after {
        			background: $theme-color-primary;
        		}
        		&:hover {
        			background: $theme-color-hover;
        			border: 1px solid $theme-color-primary;
        			span {
        				color: $color-heading;
        			}
        		}
        	}
        }
    }
    .loading {
		position: relative;
		&:before {
			content: '';
			display: block;
			width: 54px;
			height: 54px;
			background-image: url({{ 'ajax_load.gif' | asset_url }});
			background-repeat: no-repeat;
			@include display(inline-block);
			position: absolute;
			top: 50%;
			@include rtl-left(50%);
			transform: translate(-50%,-50%);
			z-index: 99;
		}
		&:after {
			content: "";
			background: rgba(255,255,255 ,.8);
			width: 100%;
			height: 100%;
			left: 0;
			top: 0;
			z-index: 98;
			position: absolute;
		}
    }
    @media (max-width: 768px) {
    	.nov-content {
    		.cart__popup-item {
			    display: block !important;
			    .cart__popup-thumb {
		    	    display: inline-block;
		    	    min-width: 95px;
			    }
			    .cart__popup-remove {
			    	text-align: center;
			    	margin: 0 0 5px;
	    	        @include rtl-margin-lr(0,0);
			    }
			    .cart__popup-thumb, .cart__popup-price, .cart__popup-quantity, .cart__popup-total {
			    	margin: 0 0 15px;
	    	        @include rtl-margin-lr(0,0);
			    	@include rtl-text-align-left();
			    }
			}
    	}
    }
    @media (max-width: 575px) {
    	.nov-content {
	    	.cart-notice-total {
	    		display: block !important;
	    		.col-left {
	    			font-size: 10px;
	    		}
	    		.col-right {
	    			margin: 10px 0;
	    		}
	    	}
	    	.spacing-xs-10 {
	    		margin: 0 -5px !important;
	    		&.row [class^="col-"], &.row [class*=" col-"], &.row [class^="col"], &.row [class*=" col"] {
	    			padding: 0 5px !important;
	    		}
	    	}
    		.related_product .popup__cart-product .formAddToCart .btnAddToCart {
			    padding: 10px 0;
	    	}
	    	.cart__popup-action .class_none_bundle {
	    		@include rtl-margin-right(10px);
	    	}
	    	.content_threshold.threshold_congrats {
	    		margin-top: 0;
	    	}
	    }
    }
}
