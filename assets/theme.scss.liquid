		letter-spacing: 1px;
		font-family: $font-family-primary;
		.text-link {
			font-size: 16px;
			color: #3d4246;
			letter-spacing: 1px;
			font-family: $font-family-primary;
			&:hover {
				color: $theme-color-primary;
			}
		}
	}
}
.template-password {
	margin: 0;
	.modal {
		@include translateY(-20px);
		background-color: $color-white;
		bottom: 0;
		color: #3d4246;
		@include display(none);
		@include rtl-left(0);
		@include opacity(0);
		overflow: hidden;
		position: fixed;
		@include rtl-right(0);
		top: 0;
	}
	&.modal--is-active {
		.password-page {
			@include display(none);
		}
		#LoginModal.modal {
			&.modal--is-active {
				.modal__close {
					border: 0;
					margin: 55px;
					position: fixed;
					top: 0;
					@include rtl-right(0);
					z-index: 2;
					background: transparent;
					&:hover {
						color: $theme-color-hover;
					}
				}
			}
		}
	}
	.modal--is-active {
		@include translateY(0);
		@include display(block);
		@include opacity(1);
		overflow: hidden;
	}
	.modal__centered {
		@include translateY(-50%);
		position: relative;
		top: 50%;
	}
	.modal__inner {
		-moz-transform-style: preserve-3d;
		-webkit-transform-style: preserve-3d;
		transform-style: preserve-3d;
		height: 100%;
		input {
			&:hover, &:focus {
				outline: 0;
				box-shadow: none;
			}
		}
	}
}
.site-header__logo-link {
	@include display(inline-block);
	word-break: break-word;
	margin-top: 0;
	color: #69727b;
	font-family: $font-family-primary;
