/* Image Bar ======================================================================================================== */
.section-gallery-image {
	.gallery-image__item {
		position: relative;
		@include display(block);
		color: $color-white;
		width: 100%;
		overflow:hidden;
		text-align: center;
		&:after {
			content: "";
			display: inline-block;
			width: 150%;
			height: 80%;
			position: absolute;
			top: -75%;
			@include rtl-right(32%);
			background: rgba(255,255,255,0.15);
			@include skewY(-50deg);
			@include transition(all 0.35s ease);
		}
		&:hover {
			&:after {
				top: 120%;
				@include rtl-right(-75%);
				@include transition(all 0.35s ease);
			}
		}
	}
	.gallery-image__link {
		display: block;
	}
	.gallery-image__caption {
		position: absolute;
		top: 50%;
		@include translateY(-50%);
		transition: $transition-link-hover;
		width: 100%;
		text-align: center;
	}
