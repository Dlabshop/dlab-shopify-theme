.product-single__tabs {
	.nav-tabs {
		margin: 50px 0 44px;
		> li {
			@include rtl-margin-right(60px);
			a {
				font-size: 1.8rem;
				font-family: $font-family-primary;
				font-weight: bold;
				color: #bfbfbf;
				@include display(block);
				text-transform: uppercase;
				padding: 13px 0;
				position: relative;
				&:after {
					content: '';
					display: block;
					width: 100%;
					height: 3px;
					background: transparent;
					position: absolute;
					bottom: -2px;
					@include rtl-left(0);
				}
				&.active, &:hover {
					color: $color-heading;
					&:after {
						background: $theme-color-hover;
					}
				}
			}
		}
	}
	#proTabs1 {
		font-size: 1.4rem;
		font-family: $font-family-default;
		font-weight: 400;
		color: $color-heading-sub;
		line-height: 24px;
		img {
			margin: 40px 0;
		}
	}
	.spr-form-input {
		a {
			color: #fddc43;
			&:hover,&:focus {
				color: #fddc43;
			}
		}
	}
}
.product-single__shortdes {
	margin-bottom: 22px;
	line-height: 20px;
}
.product_option_sub {
    @include flexbox();
}
.product-form__item--quantity {
	@include rtl-margin-right(20px);
	.js-qty {
		width: 110px;
		border: 1px solid #ebebeb;
		position: relative;
		@include border-radius(3px);
		font-family: $font-family-primary;
		font-weight: 400;
		font-size: 1.4rem;
		color: $color-heading-second;
		.js-qty__num {
			height: 48px;
			font-size: 13px;
			font-family: $font-family-primary;
			font-weight: 400;
			color: $color-heading;
			text-align: center;
			border: none;
			background-color: $color-white;
			padding: 0;
		}
		.js-qty__adjust {
			position: absolute;
			padding: 0;
			text-align: center;
			width: 26px;
			height: 48px;
			line-height: 48px;
			color: #bfbfbf;
			font-size: 1.6rem;
			background: $color-white;
			border: none;
			@include appearance(none);
			@include align-items(none);
			cursor: pointer;
			&:hover {
				outline: none;
				color: $theme-color-hover;
			}
			.icon {
				background: transparent;
				@include display(none);
			}
			&.js-qty__adjust--plus {
				@include rtl-right(0);
				top: 50%;
				@include translateY(-50%);
				@include rtl-border-left(1px solid #ebebeb);
			}
			&.js-qty__adjust--minus {
				@include rtl-left(0);
				top: 50%;
				@include translateY(-50%);
				@include rtl-border-right(1px solid #ebebeb);
			}
		}
	}
	.quick_view_qty {
		width: 110px;
		border: 1px solid #ebebeb;
		position: relative;
		font-family: $font-family-primary;
		font-weight: 400;
		font-size: 1.4rem;
		color: $color-heading-second;
		margin: 0;
		@include border-radius(0);
		.quantity-selector {
			height: 50px;
			font-size: 13px;
			font-family: $font-family-primary;
			font-weight: 400;
			color: $color-heading;
			text-align: center;
			border: none;
			background-color: $color-white;
			padding: 0;
			/* Chrome, Safari, Edge, Opera */
			&::-webkit-outer-spin-button,
			&::-webkit-inner-spin-button {
				-webkit-appearance: none;
				margin: 0;
			}
			/* Firefox */
			&[type=number] {
				-moz-appearance: textfield;
			}
		}
		.quick_view-qty {
			position: absolute;
			padding: 0;
			text-align: center;
			width: 26px;
			height: 50px;
			line-height: 50px;
			color: #b4b4b4;
			font-size: 1.6rem;
			background: $color-white;
			border: none;
			@include appearance(none);
			@include align-items(none);
			cursor: pointer;
			&:hover {
				outline: none;
				color: $theme-color-hover;
			}
			.icon {
				background: transparent;
				@include display(none);
			}
			.fallback-text {
				color: #b4b4b4;
			}
			&.quick_view-qty-plus {
				@include rtl-right(0);
				top: 50%;
				@include translateY(-50%);
				@include rtl-border-left(1px solid #ebebeb);
			}
			&.quick_view-qty-minus {
				@include rtl-left(0);
				top: 50%;
				@include translateY(-50%);
				@include rtl-border-right(1px solid #ebebeb);
			}
		}
	}
	@media (max-width: 375px) {
		.js-qty {
			.js-qty__adjust {
				height: 40px;
				line-height: 40px;
			}
			.js-qty__num {
				height: 40px;
			}
		}
	}
}
#shopify-section-nov-sidebar-detail {
	.productlist__sidebar {
		.title-block {
			margin-bottom: 17px;
		}
		.item-product {
			margin-bottom: 17px;
			.product__info {
				@include rtl-text-align-left();
				.detail-reviews {
					.spr-badge-caption {
						@include display(none);
						margin-top: 5px;
						@include rtl-margin-left(10px);
						font-size: 10px;
						color: #dbdbdb;
					}
					.spr-starrating {
						@include rtl-margin-right(0);
						.spr-icon {
							@include opacity(1);
						}
						.spr-icon:before {
							@include display(inline-block);
							font: normal normal normal 14px/1 FontAwesome;
							font-size: inherit;
							text-rendering: auto;
							-webkit-font-smoothing: antialiased;
							-moz-osx-font-smoothing: grayscale;
							color: #dbdbdb;
							font-size: 10px;
						}
						.spr-icon-star:before {
							content: "\f005";
							color: #ffd201;
						}
						.spr-icon-star-empty:before {
							content: "\f006";
						}
					}
				}
				.product__title {
					margin: 0 0 3px;
				}
			}
		}
	}
}
#shopify-product-reviews {
	.spr-review-header {
		.spr-icon-star:before {
			color: #ffd201;
		}
	}
}
