/*============================================================================
	Skip to content button
		- Overrides .visually-hidden when focused
		==============================================================================*/
		.skip-link:focus {
			clip: auto;
			@include square(auto);
			margin: 0;
			color: $color-body-text;
			background-color: $color-white;
			padding: 10px;
			@include opacity(1);
			z-index: $z-index-skip-to-content;
			transition: none;
		}

		/*=============== Lazy loading ===================*/
		.process-loading {
			height: 0;
			@include display(none);
			&:before {
				content: "";
				background: rgba(#fff,0.6);
				top: 70px;
				@include rtl-left(0);
				@include rtl-right(0);
				bottom: 0;
				position: absolute;
				z-index: 1;
			}
			.loader {
				position: absolute;
				@include rtl-left(50%);
				@include translateX(-50%);
				z-index: 2;
				.dot {
					@include square(20px);
					background: $theme-color-primary;
					border-radius: 100%;
					@include display(inline-block);
					animation: nov-slide 1s infinite;
					&:nth-child(1) {
						animation-delay: 0.1s;
						background: rgba($theme-color-primary, 0.2);
					}
					&:nth-child(2) {
						animation-delay: 0.2s;
						background: rgba($theme-color-primary, 0.4);
					}
					&:nth-child(3) {
						animation-delay: 0.3s;
						background: rgba($theme-color-primary, 0.6);
					}
					&:nth-child(4) {
						animation-delay: 0.4s;
						background: rgba($theme-color-primary, 0.8);
					}
					&:nth-child(5) {
						animation-delay: 0.5s;
						background: $theme-color-primary;
					}
				}
			}
			&.active {
				height: 60px;
				@include display(block);
			}
		}

		.box {
			background: no-repeat;
			background-color: #f7f7f7;
			background-size: contain;
		}
		.ratio-container {
			position: relative;
		}
		.ratio-container:after {
			content:'';
			@include display(block);
			height: 0;
			width: 100%;
			padding-bottom: 50%;
			content:"";
		}
		.ratio-container > * {
			position: absolute;
			top: 0;
			@include rtl-left(0);
			@include square(100%);
		}

