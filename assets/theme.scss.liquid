	}
	.owl-stage-outer {
		border: 4px solid #ffcd35;
		@include border-radius(10px);
	}
	.item-product {
		padding: 7px 30px;
		.product__info {
			padding-bottom: 30px;
		}
		.type_product a {
			color: #d0d0d0;
			font-size: 11px;
			font-weight: bold;
			text-transform: uppercase;
		}
		.product__title a {
			font-size: 1.6rem;
			color: $color-heading;
