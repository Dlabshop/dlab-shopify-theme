// Currency
#_desktop_currency_selector {
	min-width: 60px;
	border: none;
	@include border-radius(0);
	padding: 0;
	@include transform(none !important);
	top: 40px !important;
	left: -29px !important;
	-webkit-transform: translate(0) !important;
	-moz-transform: translate(0) !important;
	-ms-transform: translate(0) !important;
	-o-transform: translate(0) !important;
	transform: translate(0) !important;
	@include box-shadow(0 0 7px rgba(0,0,0,0.15));
	@include transition(all 0.35s linear);
	&.show {
		max-height: 120px;
		@include transition(all 0.35s linear);
	}
	span {
		@include display(block);
		font-size: 10px;
		font-family: $font-family-default;
		font-weight: bold;
		color: $color-heading-sub;
		padding: 11.3px 15px;
		cursor: pointer;
		@include transition(all 0.35s linear);
		text-transform: uppercase;
		text-align: center;
		&:not(:last-child) {
			border-bottom: 1px solid #ececec;
		}
		&:hover, &.selected {
			color: $theme-color-primary;
			@include transition(all 0.35s linear);
		}
	}
	#currencies.list-inline {
		padding: 12px 0;
		.list-inline-item:not(:last-child){
			@include rtl-margin-right(17px);
		}
		span {
			padding: 0;
			&:hover, &.selected {
				color: $theme-color-hover;
				@include transition(all 0.35s ease);
			}
		}
	}
}

/*================ Button variations ================*/
.btn--link {
	background-color: transparent;
	border: 0;
	margin: 0;
	color: $color-body-text;
	@include rtl-text-align-left();
	&:hover,
	&:focus {
		opacity: $opacity-link-hover;
		@include transition(all 0.35s ease);
	}
	.icon {
		vertical-align: middle;
	}
}

.btn--disabled {
	@include opacity(0.5);
	cursor: default;

	&:hover,
	&:focus {
		@include opacity(0.5);
	}
}

/*================ #Images and Iframes ================*/
svg:not(:root) {
	overflow: hidden;
}

/* Block ===================================================== */
.title_block {
	font-size: 2.4rem;
	color: $theme-color-default;
	margin: 21px 0 30px 0;
	font-family: $font-family-primary;
	font-weight: 600;
	text-transform: uppercase;
	.sub_title {
		@include display(block);
		font-size: 1.6rem;
		color: $color-body-text;
		font-weight: normal;
		text-transform: none;
		margin-top: 5px;
		&.d-inline {
			margin-top: 0;
			vertical-align: middle;
			@include rtl-margin-left(20px);
			@media(max-width: 991px) {
				@include display(block !important);
				@include rtl-margin-left(0 !important);
			}
		}
	}
}

