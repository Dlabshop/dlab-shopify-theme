.nosidebar {
	.product__description {
		font-family: $font-family-primary;
		color: #6e6e6e;
		font-size: 13px;
		font-weight: 400;
		margin-bottom: 5px;
	}
	.product-single__photos .proFeaturedImage img {
		max-width: 100%;
	}
	.product-form__item--submit {
		.product-form__cart-submit {
			padding: 0 50px;
		}
	}
	@media (max-width: 1199px) {
		.product-single__photos .proFeaturedImage img {
			max-width: 100%;
		}
		.product-form__item--submit .product-form__cart-submit {
			padding: 0;
		}
	}
	@media (max-width: 767px) {
		.product-single__photos .proFeaturedImage img {
			min-height: 100%;
		}
	}
}
.zoomContainer {
	overflow: hidden;
	@include border-radius(10px);
	@media(max-width: 767px) {
		@include display(none);
	}
}
/*========================================== End Templates | Detail =======================================================*/

/* productThumbs*/
#productThumbs {
	.thumblist {
		margin: 0 -10px;
		overflow: hidden;
		.owl-carousel {
			padding: 10px 10px;
			.owl-stage-outer {
				overflow: inherit;
				.owl-item:not(.active) {
					@include opacity(0);
				}
			}
		}
	}
	.thumbItem {
		position: relative;
	}
	.owl-nav {
		margin-top: 0;
		.owl-prev, .owl-next {
			margin: 0;
			background-color: $theme-color-default;
			color: $color-white;
			position: absolute;
			top: 50%;
			@include translateY(-50%);
			@include transition(all 0.35s ease);
			&:not(.disabled) {
				&:hover {
					background-color: $theme-color-hover;
				}
			}
		}
		.owl-next {@include rtl-right(-30px);}
		.owl-prev {@include rtl-left(-30px);}
	}
	&:hover {
		.owl-next {@include rtl-right(0);}
		.owl-prev {@include rtl-left(0);}
	}
	@media (max-width: 1199px) {
		.thumbItem img {
			width: 100%;
		}
	}
}
.thumb-vertical {
	#productThumbs {
		.thumblist {
			.thumbItem {
				// max-width: 86px;
				a {
					@include display(block);
					position: relative;
				}	
			}
		}
		.nov-thumb_vertical {
			.slick-arrow {
				position: absolute;
				@include square(28px);
				line-height: 32px;
				@include rtl-left(50%);
				@include translateX(-50%);
				@include border-radius(50%);
				text-align: center;
				background: $theme_color_default;
				font-size: 18px;
				color: $color-white;
				&.arrow-prev {
					top: -35px;
				}
				&.arrow-next {
					bottom: -35px;
				}
				&:hover {
					background: $theme-color-hover;
				}
			}
		}
	}
	@media (max-width: 767px) {
		#productThumbs .thumblist .thumbItem {
			max-width: 95px;
		}
	}
}

/*================ Add to cart form =======================================================================================*/
.product-form__item {
	label {
		font-size: 12px;
		font-family: $font-family-primary;
		font-weight: 700;
		color: #666766;
		margin-bottom: 0;
		text-transform: uppercase;
		.product-form--hide-variant-labels & {
			@include display(none);
		}
	}
}

.selectorVariants {
	label {
		font-size: 12px;
		font-family: $font-family-primary;
		margin-bottom: 0;
		@include rtl-margin-right(16px);
		font-weight: 700;
		color: #666766;
	}
	.selector-wrapper {
		@include rtl-margin-right(30px);
		@include display(none);
	}
	.watch_availabel {
		display: block;
	}
	.swatch_fiiter {
		@include flexbox();
		@include align-items(center);
		@include flex-wrap(wrap);
	}
	.swatch {
		display: block;
		margin-bottom: 25px;
		.header {
			font-family: $font-family-default;
			font-size: 10px;
			color: $color-heading-second;
			font-weight: bold;
			text-transform: uppercase;
			line-height: 20px;
			margin: 0 0 9px;
		}
		.swatch-element.color {
			label {
				@include square(34px);
				@include border-radius(0);
				&:hover {
					border: 1px solid $color-white;
					@include box-shadow(0 0 0 1px $color-black);
				}
			}
			input {display: none;}
			input:checked+label {
				border: 1px solid $color-white;
				@include box-shadow(0 0 0 1px $color-black);
			}
		}
		.swatch-element:not(.color) {
			label {
				min-width: 50px;
				height: 34px;
				@include border-radius(0);
				font-family: $font-family-default;
				font-weight: 400;
				font-size: 10px;
				color: $color-heading-sub;
				text-transform: uppercase;
				@include flexbox();
				@include align-items(center);
				@include justify-content(center);
				margin: 0;
				padding: 0 5px;
				&:hover {
					background: transparent;
					border: 3px solid $color-black;
					color: $color-heading;
					@include box-shadow(0 0 0 1px $color-black);
				}
			}
			input:checked+label {
				border: 3px solid $color-black;
				background: transparent;
				color: $color-heading;
				@include box-shadow(0 0 0 1px $color-black);
			}
		}
	}
	.single-option-selector {
		min-width: 145px;
		height: 35px;
		border: 1px solid #dfdfdf;
		@include border-radius(3px);
		padding: 0 11px;
		&:focus {
			border-color: #dfdfdf;
			outline: none;
		}
	}
	@media (max-width: 1199px) {
		.single-option-selector {
			min-width: 80px;
		}    
	}
	@media (max-width: 375px) {
		@include display(block !important);
		&>.swatch {
			margin-top: 15px;
			.swatch-element {
				&:not(:last-child) {
					@include rtl-margin-right(10px);
				}
				&.color label {
					@include square(25px);
					min-width: 25px;
				}
			}
		}
	}
}

.group-quantity {
	margin-top: 38px;
	@include flexbox();
	.productWishList {
		.btnProductWishlist {
			@include square(50px);
			line-height: 50px;
			@include border-radius(4px);
			box-shadow: none;
			padding: 0;
		}
		.fa_wishlist {
			@include display(inline-block);
			margin: auto;
			width: 16px;
			height: 14px;
			background: url({{ 'icon-autodaily.png' | asset_url }}) no-repeat;
			background-position: -20px -115px;
			vertical-align: sub;
		}
	}
}

.product-form__variants {
	@include display(none);
}

.product-form__input {
	@include display(block);
	width: 100%;
}

.product-form__item--submit {
	.product-form__cart-submit {
		@include flexbox();
		@include align-items(center);
		@include justify-content(center);
		padding: 0 88px;
		white-space: normal;
		@include rtl-margin-right(10px);
		height: 50px;
		line-height: 50px;
		min-width: 220px;
		@include border-radius(3px);
		background: $color-heading;
		i {
			@include rtl-margin-right(10px);
		}
		&:hover {
			background: $theme-color-hover;
		}
		@media(max-width: 991px) {
			padding: 0 40px;
		}
	}
	.icon_cart {
		@include display(inline-block);
		width: 10px;
		height: 12px;
		background: url({{ 'icon-autodaily.png' | asset_url }}) no-repeat;
		background-position: -19px -99px;
	}
	#AddToCartText {
		font-family: $font-family-default;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		color: $color-white;
	}
}
.product-form__item--checkout {
    @include rtl-margin-right(10px);
	.shopify-payment-button__button {
		@include flexbox();
		@include align-items(center);
		@include justify-content(center);
		white-space: normal;
		height: 50px;
		line-height: 50px;
		min-width: 220px;
		@include border-radius(3px);
		background-color: $color-heading;
		padding: 0;
		text-transform: uppercase;
		font-size: 11px;
		font-weight: 700;
		&:hover {
			background-color: $theme-color-hover !important;
		}
	}
}
.product-single__description {
	margin-top: 20px;
}

@media (max-width: 1199px) {
	.group-reviews, .has-shareling, .group-quantity {
		margin-top: 25px;
	}
	.product-form__item--quantity {
		width: 100px;
		@include rtl-margin-right(10px);
	}
	.product-form__item--submit .product-form__cart-submit {
		min-width: 145px;
		padding: 0;
	}
	.product-form__item--checkout {
		.shopify-payment-button__button {
			min-width: 145px;
		}
	}
}
@media (max-width: 991px) {
	.group-reviews, .has-shareling, .group-quantity {
	    display: block;
	}
	.product_option_sub {
		@include flexbox();
		margin-top: 25px;
	}
	.product-form__item--submit .product-form__cart-submit {
		min-width: 130px;
	}
	.product-form__item--checkout {
		.shopify-payment-button__button {
			min-width: 130px;
		}
	}
}
@media (max-width: 575px) {
	.product-single__tabs {
		.nav-tabs>li {
			@include rtl-margin-right(45px);
		}
	}
}
@media (max-width: 375px) {
	.product_option_sub {
		display: block;
	}
	.product-form__item--submit {
		.product-form__cart-submit {
			min-width: 100%;
			height: 50px;
			line-height: 50px;
			margin-bottom: 10px;
		}
	}
	.product-form__item--checkout {
		@include rtl-margin-right(0);
		.shopify-payment-button__button {
			min-width: 100%;
			height: 50px;
			line-height: 50px;
			margin-bottom: 10px;
		}
	}
	.product-form__item--quantity {
		.js-qty {
			.js-qty__adjust {
				height: 38px;
				line-height: 38px;
			}
			.js-qty__num {
				height: 38px;
			}
		}
	}
}

/*================ Product Images =========================================================================================*/
.thumbItem {
	a {
		border: 1px solid #e6e6e6;
		@include display(block);
	}
	&:hover, &.active {
		a {
			border: 1px solid $theme-color-primary;
		}
	}
}

.product-single__thumbnail-image {
	max-width: 100%;
	@include display(block);
}

.product-featured-img {
	@include display(block);
	margin: 0 auto;
	position: absolute;
	top: 0;
	width: 100%;
	.no-js & {
		position: relative;
	}
}

// sass-lint:disable class-name-format
.zoomImg {
	background-color: $color-white;
}
.product-single__photo-wrapper {
	margin: 0 auto;
	width: 100%;
}

// Prevent reflow when image loads
.product-single__photo {
	margin: 0 auto;
	min-height: 1px;
	@include square(100%);
	position: relative;
}

/* Related Product ========================================================================================================*/
.ProductRelated {
	padding: 40px 0 56px;
	.title_block {
		border-bottom: 1px solid #eeeeee;
		margin: 24px 0 0;
		padding-bottom: 10px;
		span {
			font-family: $font-family-primary;
			font-size: 2.4rem;
			font-weight: 600;
			color: $color-heading;
			margin-bottom: 40px;
			padding-bottom: 10px;
			text-transform: none;
			position: relative;
			&:after {
				content: '';
				display: block;
				width: 100%;
				height: 3px;
				background: $theme-color-primary;
				position: absolute;
				@include rtl-left(0);
				bottom: -4px;
			}
		}
	}
	.owl-nav {
		.owl-prev, .owl-next {
			@include square(32px);
			line-height: 32px;
			@include border-radius(2px);
			font-size: 1.8rem;
			position: absolute;
			cursor: pointer;
			color: #797979;
			text-align: center;
			z-index: 9;
			top: -8%;
			background: #eeeeee;
			&:hover {
				background: $theme-color-hover;
				color: $color-white;
			}
		}
		.owl-prev {
			@include rtl-right(37px);
		}
		.owl-next {
			@include rtl-right(0);
		}
	}
	.owl-dots {
		text-align: center;
		.owl-dot {
			@include display(inline-block);
			@include square(20px);
			@include rtl-margin-lr(5px,5px);
			@include border-radius(50%);
			background: rgba($color-default,0.1);
			vertical-align: top;
			&.active, &:hover {
				background: rgba($color-default,0.2);
			}
		}
	}
	.block__content {
		padding-top: 35px;
		position: relative;
		.grid--view-items {
			margin: 0 -15px;
		}
		.owl-relatedproduct {
			position: initial;
			.owl-item {
				padding: 15px;
			}
		}
		.item {
			.item-product {
				// &:before {
				// 	display: none;
				// }
				.product__info {
					position: relative;
					@include opacity(1);
					visibility: initial;
				}
			}
		}
	}
	@media (max-width: 1199px) {
		.owl-nav {
			.owl-prev, .owl-next {
				top: -9%;
			}
		}
