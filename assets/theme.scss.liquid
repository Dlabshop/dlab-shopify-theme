		position: relative;
		padding: 0;
		&>li, &>li.site-nav--has-dropdown {
			list-style-type: none;
			&>a {
			    position: relative;
			    padding: 18px 25px;
			    &:before {
					content: "";
				    position: absolute;
				    width: 1px;
				    height: 100%;
				    top: 0;
				    @include rtl-right(-1px);
					background: #f4f4f4; /* Old browsers */
					background: -moz-linear-gradient(top,  #f4f4f4 0%, #cdcdcd 100%); /* FF3.6-15 */
					background: -webkit-linear-gradient(top,  #f4f4f4 0%,#cdcdcd 100%); /* Chrome10-25,Safari5.1-6 */
					background: linear-gradient(to bottom,  #f4f4f4 0%,#cdcdcd 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
					filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#f4f4f4', endColorstr='#cdcdcd',GradientType=0 ); /* IE6-9 */
				}
				&:after {
					content: "";
				    position: absolute;
				    width: 1px;
				    height: 100%;
				    top: 0;
				    @include rtl-right(-2px);
					background: $color-white; /* Old browsers */
					background: -moz-linear-gradient(top,  $color-white 0%, #f4f4f4 100%); /* FF3.6-15 */
					background: -webkit-linear-gradient(top,  $color-white 0%,#f4f4f4 100%); /* Chrome10-25,Safari5.1-6 */
					background: linear-gradient(to bottom,  $color-white 0%,#f4f4f4 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
					filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#f4f4f4',GradientType=0 ); /* IE6-9 */
			    }
				font-family: $font-family-primary;
				font-size: 12px;
				line-height: 20px;
				color: $color-heading;
				font-weight: 600;
				text-transform: uppercase;
			}
			&.site-nav--active {
				@include bg-gradient-hover();
				&>a {
					color: $color-heading;
				}
			}
			&.site-nav--has-dropdown {
				// &.hasMegaMenu.center {
				// 	position: relative;
				// }
				// &>a {
				// 	@media (min-width: 768px) {
				// 		&:after {
				// 			content: "\f2f9";
				// 		    @include rtl-margin-left(4px);
				// 		    font-family: "Material-Design-Iconic-Font";
				// 		    font-size: 1.5rem;
				// 		    font-weight: 400;
				// 		    vertical-align: middle;
				// 		    display: inline-block;
				// 		}
				// 	}
				// }
			}
			&:hover {
				@include bg-gradient-hover();
				&>a {
					color: $color-heading;
				}
			}
		}
		a {
			color: $color-white;
			&:hover {
				color: $theme-color-primary;
			}
		}
		@media (max-width: 991px) {
			&>li, &>li.site-nav--has-dropdown {
				&>a {
			    	padding: 15px 21px;
				    font-size: 11px;
				}
			}
		}
	}
}

/*================ Site Nav Links ================*/
.site-nav__link {
	@include display(block);
	white-space: nowrap;
	.site-nav--centered & {
		padding-top: 0;
	}

	.zmdi-chevron-down {
		@include square(8px);
		@include rtl-margin-left(2px);
	}

	&.site-nav--active-dropdown {
		border: 1px solid $color-border;
		border-bottom: 1px solid transparent;
		z-index: 2;
	}
}
.site-nav--active-dropdown {
	.zmdi-chevron-down {
		&:before {
			content: '\f2fc';
		}
	}
}

/*================ Dropdowns ================*/
.site-nav__dropdown {
	@include opacity(0);
	visibility: hidden;
	position: absolute;
	margin: 0;
	z-index: 7;
	background: $color-white;
	@include rtl-text-align-left();
	top: 100%;
	@include rtl-left(0);
	@include box-shadow(0 0 15px rgba(#000, 0.1));
	@include border-radius(0 0 8px 8px);
	@include transition(all 0.35s linear);
	padding: 5.5px 40px;
	min-width: 270px;
	.site-nav__link {
		padding: 11px 0;
		@include transition(all 0.1s linear);
		font-family: $font-family-default;
		font-size: 1.3rem;
		color: $color-heading-sub;
		font-weight: 400;
		&:hover {
			color: $theme-color-primary;
		}
	}
	>li {
		&:hover {
			.site-nav__link {
				background: $theme-color-primary;
				color: $color-white;
			}
		}
	}
	.site-nav--active-dropdown {
		@include opacity(1);
		visibility: visible;
		top: 100%;
	}
	ul {
		li {
			@include display(block);
			&:last-child {
				a {
					border-bottom: none;
				}
			}
		}
	}
	@media (max-width: 1199px) {
		@include translateX(0);
		padding: 5.5px 20px;
    	min-width: 230px;
	}
	@media (max-width: 991px) {
		padding: 5px 20px;
		min-width: 223px;
		.site-nav__link {
		    border-bottom: 1px solid #ededed;
		}
	}
}

//Megamenu
.site-nav--has-dropdown {
	position: relative;
	&.hasMegaMenu {
		@include display(inline-flex);
		&.center {
			position: static;
			@media(max-width: 767px) {
				position: relative;
			}
		}
		.megaMenu {
			top: 100%;
			padding: 0;
			@include rtl-left(50%);
			@include translateX(-50%);
			.novMenuLinks {
			    padding: 45px 0 0 0;
			    @include rtl-padding-left(40px);
				.menuTitle {
					a {
						padding: 0 0 6px 0;
					}
				}
				li:not(.menuTitle) {
					a {
						padding: 10px 0;
						border-bottom: 1px solid #ededed;
					}
					&:last-child {
						a {
							padding: 10px 0 0 0;
							border-bottom: none;
						}
					}
				}
			}
			.novMenuLinks {
				a {
					padding: 7px 0;
					@include display(block);
					font-size: 13px;
					font-family: $font-family-default;
					font-weight: 400;
					color: $color-heading-sub;
					span {
						font-size: 1.2rem;
					}
				}
				.menuTitle {
					@include display(block);
					margin-bottom: 1px;
					a {
						cursor: text;
						padding: 0;
						color: $color-heading;
						font-size: 1.4rem;
						font-weight: bold;
						font-family: $font-family-primary;
						text-transform: uppercase;
					}
					&:not(.has_child) {
						font-weight: normal;
						font-size: 1.3rem;
						text-transform: none;
					}
				}
				li:not(.menuTitle) a:hover {
					color: $theme-color-primary;
				}
			}
			.novMenuBanner {
				&.has_shadow {
					box-shadow: 0 0 15px rgba(#000, 0.2);
				}
				a {
					padding: 0;
				}
			}
		}
	}
	&:not(.hasMegaMenu) {
		.site-nav__dropdown-children {
			width: 100%;
			position: absolute;
			@include rtl-left(100%);
			top: -10px;
			@include opacity(0);
			visibility: hidden;
			@include box-shadow(0 0 10px rgba(#000, 0.1));
			min-width: 140px;
			@include border-radius(10px);
			>ul {
				background: $color-white;
				padding: 10px 0;
				@include border-radius(10px);
			}
			@media (min-width: 768px) {
				&:before {
					content: '';
					@include display(inline-block);
					width: 8px;
					height: 14px;
					background: url({{ 'icon-autodaily.png' | asset_url }}) no-repeat;
					background-position: -85px -23px;
					position: absolute;
					top: 33px;
					@include rtl-left(-37px);
					font-size: 1.6rem;
					color: $theme-color-default;
				}
			}
		}
		.site-nav__childlist-item {
			position: relative;
			&:hover {
				.site-nav__dropdown-children {
					@include opacity(1);
					visibility: visible;
					&:before {
						color: $theme-color-primary;
					}
				}
			}
		}
		.site-nav__dropdown {
			ul li {
				&:not(:last-child) {
					a {
						border-bottom: 1px solid #ededed;
					}
				}
			}
		}
	}
	li {
		position: relative;
		&.site-nav--active {
			a {
				color: $theme-color-primary !important;
			}
		}
	}
	.menuGroup {
		.menuCol {
			margin: 45px 0;
			.novMenuLinks {
				margin: 0 70px 0 0;
			}
			&:first-child {
				.novMenuLinks {
					margin: 0 30px 0 40px;
				}
			}
			&:last-child {
				.novMenuLinks {
					margin: 0 40px 0 0;
				}
			}
		}
		.row.spacing-30 {
			margin: 0;
			[class*="col-"] {
				padding: 0 0 45px 0;
			}
		}
	}
	.site-nav__dropdown {
		ul {
			padding: 0;
		}
	}
	&:hover {
		.site-nav__dropdown {
			@include opacity(1);
			visibility: visible;
			top: 100%;
			z-index: 999;
		}
	}
	@media (max-width: 1199px) {
		&.hasMegaMenu .megaMenu {
			width: 930px !important;
			margin: 0;
			.novMenuLinks {
			    padding: 30px 0 0 0;
				@include rtl-padding-left(15px);
				li:not(.menuTitle) a {
				    padding: 7px 0;
				}
			}
		}
		.menuGroup .menuCol {
			&:first-child {
				.novMenuLinks {
					margin: 0;
					@include rtl-margin-left(20px);
				}
			}
			.novMenuLinks {
				margin: 0;
			}
		}
	}
	@media (max-width: 991px) {
		&.hasMegaMenu .megaMenu {
			width: 690px !important;
		}
		.menuGroup {
			.row.spacing-30 {
				margin: 0;
			}
			.menuCol {
				.novMenuLinks {
					margin: 0;
				}
				&:first-child .novMenuLinks {
				    margin: 0;
	    			@include rtl-margin-left(5px);
					@include rtl-margin-right(0);
					@include rtl-padding-left(5px);
				}
				&:last-child .novMenuLinks {
					margin: 0;
				}
			}
		}
	}
}

