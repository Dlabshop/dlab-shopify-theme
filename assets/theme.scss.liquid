				font-weight: 700;
				text-transform: uppercase;
				@include display(block);
				padding: 10px 0;
				&:hover {
					color: $theme-color-hover;
					@include transition(all 0.35s ease);
				}
			}
			.show-sub {
				@include square(15px);
				line-height: 15px;
				text-align: center;
				background: #cfcfcf;
				@include border-radius(3px);
				@include display(inline-block);
				color: $color_button_text;
				font-size: 15px;
				position: absolute;
				@include rtl-right(0);
				top: 17px;
				cursor: pointer;
				i {
					vertical-align: bottom;
				}
				.zmdi-minus {
					@include display(none);
				}
				&.active {
					background: $theme-color-default;
					.zmdi-minus {
						@include display(block);
					}
					.zmdi-plus {
						@include display(none);
					}
				}
			}
			.site-nav__dropdown {
				position: static;
				box-shadow: none;
				visibility: visible;
				@include opacity(1);
				border: none;
				@include display(none);
				@include transition(none);
				ul {
					list-style-type: none;
				}
				li {
					border: none;
				}
				.site-nav__link {
					font-size: 11px;
					font-weight: 500;
					padding: 10px 0;
					@include display(block);
					color: $color-text;
					text-transform: uppercase;
					&:hover {
						color: $theme-color-hover;
						background: none;
						@include transition(all 0.35s ease);
					}
				}
			}
			&.site-nav--has-dropdown:first-child {
				> .site-nav__dropdown {
					@include display(block);
				}
			}
		}
	}
	&.active {
		@include rtl-left(0);
		.btn_close_sidebar {
			@include opacity(1);
			visibility: visible;
		}
	}
}


