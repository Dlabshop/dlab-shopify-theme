			text-align: center;
		}
		.sub_title {
			font-family: $font-family-default;
			font-weight: 400;
			font-size: 13px;
			color: $color-heading-sub;
		}
	}
	.stepbuy {
		margin-bottom: 80px;
		position: relative;
		&:after {
			content: '';
			display: block;
			width: 100%;
			border-bottom: 1px dashed #dcdcdc;
			position: absolute;
			bottom: 23px;
