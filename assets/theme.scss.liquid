	width: 13px;
	height: 1px;
	background: #383838;
	cursor: pointer;
	margin-bottom: 3px;
	@include transition(all 0.3s ease);
	&:before,&:after {
		content: '';
		@include display(inline-block);
		position: absolute;
		@include rtl-left(0);
		width: 13px;
		height: 1px;
		background: #383838;
		@include transition(all .3s ease);
	}
	&:before {
		top: 4px;
