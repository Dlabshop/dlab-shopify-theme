	@media (max-width: 1199px) {
		.nav-tab {
			overflow-x: scroll;
			white-space: nowrap;
		}
	}
	@media (max-width: 991px) {
		.nav-tab {
			@include justify-content(center);
		}
	}
	@media (max-width: 767px) {
		.nav-tab {
			@include justify-content(inherit);
		}
	}
}

// Product Slider ===================================================================================================
.section-product-slider {
	.title_block {
		font-size: 1.8rem;
		margin: -7px 0 0;
		font-family: $font-family-primary;
		font-weight: 800;
		color: $color-heading;
		text-transform: uppercase;
		border-bottom: 1px solid #f2f3f7;
		span {
		    position: relative;
		    display: inline-block;
	        padding: 0 0 14px;
			&:after {
			    content: "";
			    position: absolute;
			    width: 100%;
			    height: 3px;
			    background: $theme-color-primary;
			    @include rtl-left(0);
			    bottom: -2px;
			}
		}
	}
	.sub_title {
		display: block;
		font-family: $font-family-default;
		font-size: 13px;
		color: #909090;
		font-weight: 400;
		line-height: 20px;
	}
	.block_content {
		position: relative;
	}
	.grid--view-items {
		padding-top: 36px;
		position: initial;
	    .item {
	    	padding: 15px;
	    }
	}
	.nov-slick-carousel {
		.slick-dots {
			position: absolute;
			bottom: 0;
			@include rtl-left(50%);
			@include translateX(-50%);
			line-height: 0;
			li {
				@include square(12px);
				button {
					@include square(12px);
					&:before {
						@include square(12px);
					}
				}
			}
		}
		.slick-arrow {
			@include square(32px);
			line-height: 32px;
			top: -38px;
			@include translateY(0);
			@include border-radius(2px);
			border: 1px solid #eee;
			background: #eee;
			text-align: center;
			i {
				font-size: 1.8rem;
				font-weight: 400;
			}
			&.arrow-prev {
				@include rtl-right(37px);
			}
			&.arrow-next {
				@include rtl-right(0);
			}
			&:hover {
				@include box-shadow(none);
				border: 1px solid $theme-color-primary;
				background: $theme-color-primary;
				i {
					color: $color-white;
				}
			}
		}
	}
	.show_all {
		margin-top: 20px;
		a {
			@include border-radius(0);
			font-family: $font-family-primary;
			font-size: 1.4rem;
			font-weight: 700;
			min-width: 160px;
			color: #444545;
			border: 1px solid #f3f3f3;
			background: $color-white;
			text-transform: initial;
			&:hover {
				background: $theme-color-primary;
				color: $color-white;
			}
		}
	}
	@media (max-width: 1199px) {
		.distance {
		    padding-bottom: 46px !important;
		}
	}
	@media (max-width: 991px) {
		.distance {
		    padding-top: 10px !important;
		    padding-bottom: 30px !important;
		}
		.grid--view-items {
			padding-top: 0;
			.item-product .formAddToCart .btnAddToCart {
			    min-width: 170px;
			}
		}
	}
	@media (max-width: 575px) {
		.grid--view-items {
			margin: 0 -5px;
			.item {
				padding: 15px 5px;
			}
		}
		.nov-slick-carousel .slick-arrow {
			display: block !important;
		}
	}
	@media (max-width: 424px) {
		.grid--view-items {
			.item-product {
				.formAddToCart .btnAddToCart {
				    min-width: 125px;
				}
			}
		}
	}
}

// Product Product Thumb ===================================================================================================
.section-product-thumb {
	.block_title {
		margin-bottom: 1px;
		.title_block {
			font-size: 1.8rem;
			margin: 0;
			font-family: $font-family-primary;
			font-weight: 800;
			line-height: 22px;
			text-transform: uppercase;
			background: $theme-color-primary;
			min-width: 194px;
			min-height: 59px;
			text-align: center;
			line-height: 59px;
			@include border-radius(10px 10px 0 0);
			@include rtl-margin-right(30px);
		}
		.sub_title {
			display: block;
			font-family: $font-family-default;
			font-size: 11px;
			font-weight: bold;
			line-height: 22px;
			text-transform: uppercase;
		}
	}
	.grid--view-items {
		.item {
			padding: 0 15px 5px;
		}
		.item-product {
			border: 1px solid $theme-color-primary;
			@include border-radius(0);
		    @include box-shadow(5px 5px 0 0 #f7af24);
			padding: 13px 13px 7px;
			.item {
				padding: 0;
			}
			.thumbnail-container {
				@include border-radius(0);
			}
			.productThumbs {
				.thumnailslider-nav {
					.slick-list {
						margin: 0 -5px;
					}
					.thumbItem {
						padding: 10px 5px;
						a {
							border: none;
							&:hover {
								border: none;
							}
						}
						&.slick-current, &:hover {
							a {
								@include box-shadow(2px 3px 8px rgba(0,0,0,0.15));
							}
						}
					}
				}
			}
			.product__info {
				@include rtl-text-align-left();
				.product__title {
				    margin: 23px 0 4px;
					a {
						font-size: 1.4rem;
						font-weight: bold;
						color: $color-heading;
						&:hover {
							color: $theme-color-hover;
						}
					}
				}
				.product__review {
					margin-bottom: 13px;
					.spr-starrating .spr-icon {
						&:before {
							color: $theme-color-primary;
						}
					}
				}
				.product__price {
					font-weight: 900;
					font-size: 1.8rem;
					margin-bottom: 35px;
				}
			}
			.formAddToCart {
				@include rtl-margin-right(5px);
				.btnAddToCart {
					min-width: 150px;
					min-height: 38px;
					@include border-radius(4px);
					padding: 0;
					&:hover {
						@include box-shadow(none);
						background: $theme-color-hover;
					}
				}
			}
			.productWishList, .productQuickView {
				@include opacity(1);
				transform: scale(1);
				visibility: initial;
				.btn {
					@include square(38px);
					@include border-radius(4px);
					background: #f0f0f0;
					@include box-shadow(none);
					&.whislist-added, &:hover {
						background: $theme-color-hover;
					}
				}
			}
			&:hover {
				border: 1px solid $theme-color-primary;
				@include border-radius(0);
				border-color: $theme-color-primary !important;
			    @include box-shadow(5px 5px 0 0 #f7af24);
			}
		}
	}
	.countdownfree {
		@include flexbox();
		@include align-items(center);
		margin-bottom: 42px;
		.item-time {
			text-align: center;
			@include square(50px);
			background: #ffea78;
			@include border-radius(4px);
			@include flexbox();
			@include align-items(center);
			@include justify-content(center);
			@include box-shadow(2px 2px 0px 0px #ffd700);
			.data-time span:not(.name-time) {
				font-family: $font-family-primary;
				color: #000;
				font-size: 13px;
				font-weight: 800;
				display: inline-block;
				margin: 0;
				&:after {
					content: '';
					display: block;
					background: #f0ca00;
					width: 100%;
					height: 1px;
				}
			}
			.name-time {
				font-family: $font-family-default;
				font-size: 10px;
				color: #454545;
				line-height: 1;
				font-weight: 400;
				text-transform: uppercase;
				margin: 5px 0 0 0;
			}
			&:last-child {
				margin-bottom: 0;
			}
		}
	}
	.nov-slick-carousel {
		.slick-dots {
			position: absolute;
			top: -44px;
			bottom: initial;
			@include rtl-right(10px);
			li {
				@include square(17px);
				button {
					@include square(17px);
					&:before {
						@include square(17px);
						background: #e8e8e8;
					}
				}
				&.slick-active, &:hover {
					button::before {
						background: $theme-color-hover;
					}
				}
			}
		}
		.slick-arrow {
			@include square(32px);
			line-height: 32px;
			top: -38px;
			@include translateY(0);
			@include border-radius(2px);
			border: 1px solid #eee;
			background: #eee;
			text-align: center;
			i {
				font-size: 1.8rem;
				font-weight: 400;
			}
			&.arrow-prev {
				@include rtl-right(52px);
			}
			&.arrow-next {
				@include rtl-right(15px);
			}
			&:hover {
				@include box-shadow(none);
				border: 1px solid $theme-color-hover;
				background: $theme-color-hover;
				i {
					color: $color-white;
				}
			}
		}
	}
	.nov-owl-carousel {
		.owl-nav {
			.owl-next, .owl-prev {
				@include square(32px);
				line-height: 32px;
				top: -50px;
				@include translateY(0);
				@include border-radius(2px);
				border: 1px solid #eee;
				background: #eee;
				text-align: center;
				i {
					font-size: 1.8rem;
					font-weight: 400;
				}
				&:hover {
					@include box-shadow(none);
					border: 1px solid $theme-color-hover;
					background: $theme-color-hover;
					i {
						color: $color-white;
					}
				}
			}
			.owl-next {
				@include rtl-right(15px);
			}
			.owl-prev {
				@include rtl-right(50px);
				@include rtl-left(initial);
			}
		}
		.owl-dots {
			position: absolute;
			top: -50px;
			@include rtl-right(15px);
			.owl-dot {
				&:not(:last-child) {
					span {
						@include rtl-margin-lr(0,10px);
					}
				}
				span {
					@include square(19px);
					margin: 0;
					background: #e8e8e8;
				}
				&:hover, &.active {
					span {
						background: $theme-color-hover;
					}
				}
			}
		}
	}
	@media (max-width: 1199px) {
		.thumb_info {
			@include rtl-padding-lr(0,15px);
		}
		.countdownfree .item-time {
			@include square(45px);
		}
		.grid--view-items {
			.item-product {
				.formAddToCart {
					.btnAddToCart {
					    min-width: 130px;
					}
				}
			}
		}
	}
	@media (max-width: 991px) {
		.distance {
			padding-bottom: 50px !important;
		}
	}
	@media (max-width: 767px) {
		.block_title .title_block {
		    min-width: 150px;
		}
		.nov-slick-carousel .slick-dots {
			display: none !important;
		}
		.grid--view-items .item-product .product__info .product__title {
		    margin: 10px 0 4px;
		}
	}
	@media (max-width: 575px) {
		.block_title .title_block {
			min-width: 100%;
			min-height: 40px;
			line-height: 40px;
			margin: 0 0 15px; 
		}
		.thumb_image {
			max-width: 100%;
		}
		.grid--view-items .item-product {
			.product__info {
				margin: 20px 15px 0;
				.product__price {
				    margin-bottom: 15px;
				}
			}
			.countdownfree, .group-buttons {
				margin-bottom: 20px;
			}
			.productWishList {
				display: block !important;
			}
			.group-buttons {
				@include justify-content(end !important);
			}
		}
	}
