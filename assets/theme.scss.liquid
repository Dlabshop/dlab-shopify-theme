			    	width: 45px;
			    	height: 38px;
			    	background-image: url({{ 'before_tes.png' | asset_url }});
			    	background-repeat: no-repeat;
			    	@include display(inline-block);
			    	position: absolute;
			    	top: 0;
			    	@include rtl-left(0);
			    }
			}
			.slick-arrow {
				@include display(inline-block !important);
				@include square(48px);
				line-height: 50px;
				@include border-radius(100%);
				background: $color-white;
				font-size: 9px;
				color: #444545;
				text-align: center;
				position: absolute;
				bottom: 0px;
				z-index: 1;
				cursor: pointer;
				&.arrow-prev {
					@include rtl-right(-63px); 
				}
				&.arrow-next {
					@include rtl-right(-123px); 
				}
				.owl-prev, .owl-next {
					border: 1px solid #f3f3f3;
					font-size: 20px;
					font-weight: 900;
					color: $color-heading;
					@include border-radius(0);
					padding: 8.5px 16px;
					max-width: 40px;
					&:hover {
						color: $theme-color-hover;
					}
				}
				&:hover {
					color: $color-white;
					background: $theme-color-hover;
					@include box-shadow(0 0 5px rgba(0,0,0,0.2));
				}
			}
			.slick-dots {
				position: relative;
				bottom: -25px;
				li {
					display: inline-block;
					@include square(16px);
					margin: 0 2.5px;
					@include border-radius(100%);
					background: #abc4ba;
					&:hover {
						background: $theme-color-hover;
					}
					&.slick-active {
						background: $theme-color-hover;
						@include square(16px);
						button {
							@include square(16px);
						}
					}
					button {
						@include square(16px);
						&:before {
							display: none;
						}
					}
				}
			}
		}
	}
	.owl-carousel.owl-drag .owl-item {
		@include rtl-padding-right(4px);
	}
	@media (max-width: 1199px) {
		.testimonial-wrapper {
			.owl-theme .owl-nav {
				display: none;
			}
			.testimonials-slider {
				.testimonial-item {
					.testimonial_part {
						margin-bottom: 12px;
					}
				}
				.slick-dots {
					bottom: 10px;
				}
				.testimonial-item__text {
				    margin: 0 35px;
				}
			}
		}
	}
	@media (max-width: 991px) {
		.testimonial-wrapper .testimonials-slider {
			margin: 0;
			.content-info {
				padding: 20px 19px 0;
			}
			.testimonial-slide {
				margin: 0;
			}
			.slick-dots {
				bottom: -25px;
				@include rtl-right(0);
			}
			.testimonial-item {
				margin: 0;
				.testimonial_part {
					margin: 0;
				}
			}
			.testimonial-item__text {
				margin: 0;
			    padding: 0 15px;

			    &:before {
			    	@include rtl-left(-19px);
			    }
			}
		}
	}
	@media (max-width: 767px) {
		.distance {
			padding: 60px 0 40px !important;
		}
		.title_block {
			margin: 0 0 15px 0;
		}
		.testimonial-wrapper .testimonials-slider {
			.slick-arrow {
				@include display(none !important);
			}
			.testimonial-item__text {
				margin: 0 0 13px;
			}
			.testimonial-item {
				display: block;
			}
			.testimonial-title_item {
				padding: 20px 0 13px 0;
			}
			.slick-dots {
				display: none !important;
			}
			.content-info {
				padding: 20px;
			}
		}
	}
	@media (max-width: 525px) {
