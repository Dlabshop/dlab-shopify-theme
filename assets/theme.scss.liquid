/* Templates | Pricing Table ==============================================================================================*/
.wishlist-page {
	padding-bottom: 40px;
	.title_block {
		font-family: $font-family-primary;
		font-weight: bold;
		font-size: 2.2rem;
		line-height: 30px;
		color: $color-heading;
		text-transform: none;
	}
	.wrapper-wishlist {
		.grid-item {
			margin-bottom: 30px;
			&:not(:last-child) {
				border-bottom: 1px solid #ededed;
				padding-bottom: 30px;
			}
		}
		.wishlist-header {
			border-top: 1px solid #ededed;
			border-bottom: 1px solid #ededed;
		    padding: 11px 0;
		    margin-bottom: 30px;
			.column {
				.column_title {
					font-family: $font-family-primary;
					font-weight: bold;
					font-size: 10px;
					line-height: 22px;
					color: $color-heading-sub;
					text-transform: uppercase;
					display: inline-block;
				}
				.column_icon {
					background: #c2c2c2;
					@include square(25px);
					line-height: 25px;
					text-align: center;
					@include border-radius(100%);
					display: inline-block;
					@include rtl-margin-right(7px);
					i {
						font-size: 1.4rem;
						color: $color-white;
					}
				}
			}
		}
		.wishlist-content {
			.item-product {
				border: none;
				padding: 0;
				.column_content {
					@include flexbox();
					@include align-items(center);
				}
				.product-image {
					max-width: 170px;
					border: 1px solid #eaeaea;
					@include rtl-margin-right(30px);
				}
				.product-info {
					.product-title {
						a {
							font-family: $font-family-primary;
							font-weight: 600;
							font-size: 12px;
							line-height: 20px;
							color: $color-heading;
							&:hover {
								color: $theme-color-hover;
							}
						}
					}
					.product-review {
						.spr-starrating {
							.spr-icon {
								font-size: 11px;
								&.spr-icon-star-empty {
									&:before {
										color: #dbdbdb;
									}
								}
							}
						}
						.spr-badge-caption {
							font-family: $font-family-default;
							font-weight: 400;
							font-size: 11px;
							line-height: 22px;
							color: #c6c6c6;
						    @include rtl-margin-left(3px);
						}
						.spr-icon-star:before {
							color: $theme-color-hover;
						}
					}
				}
				.price-box {
					font-family: $font-family-primary;
					font-weight: 800;
					font-size: 1.6rem;
					color: #ff7038;
				}
				.whislist-added {
					width: 100%;
					height: 40px;
					line-height: 40px;
					border: 1px solid #eaeaea;
					font-family: $font-family-default;
					font-weight: bold;
					font-size: 10px;
					line-height: 22px;
					color: $color-text;
					background: transparent;
					@include border-radius(0);
					i {
						font-size: 1.4rem;
						font-weight: 400;
						@include rtl-margin-right(11px);
					}
					&:hover {
						background: $theme-color-hover;
						color: $color-white;
						border: 1px solid $theme-color-hover;
					}
				}
				.formAddToCart {
					width: 100%;
					.btnAddToCart {
						width: 100%;
						height: 40px;
						line-height: 40px !important;
						padding: 0;
						border: 1px solid #252525;
						@include border-radius(0);
						background: #252525;
						span {
							font-family: $font-family-default;
							font-weight: bold;
							font-size: 10px;
							line-height: 22px;
							color: $color-white;
						}
						i {
							color: $color-white;
							font-size: 1.4rem;
							font-weight: 400;
							@include rtl-margin-right(11px);
						}
						&:hover {
							background: $theme-color-hover;
							border: 1px solid $theme-color-hover;
						}
					}
				}
				&:hover {
					@include box-shadow(none);
					// border-color: transparent !important;
				}
			}
		}
	}
	@media (max-width: 991px) {
		.wrapper-wishlist .wishlist-content .item-product .product-image {
			max-width: 80px;
			@include rtl-margin-right(15px);
		}
	}
	@media (max-width: 767px) {
		.wrapper-wishlist .wishlist-content .item-product {
			.product-image {
				max-width: 150px;
			}
			.price-box {
			    margin: 25px 0;
			}
			.whislist-added {
    			margin-bottom: 10px;
			}
		}
	}
	@media (max-width: 575px) {
		.wrapper-wishlist .wishlist-content .item-product {
			.product-image {
				max-width: 100px;
			}
		}
	}
}
