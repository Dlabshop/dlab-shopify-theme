					&:before {
						display: none;
					}
				}
			}
		}
	}
	@media (max-width: 575px) {
		.list-filter .filter-item {
			.filter-item_title:not(:last-child) {
				@include rtl-margin-right(7px);
				@include rtl-padding-right(7px);
			} 
