	margin: 1px 0;
	a {
		cursor: pointer;
		font-family: $font-family-primary;
		i {
			@include rtl-margin-right(15px);
			color: $theme-color-hover;
			font-size: 1.5rem;
		}
		span {
			font-size: 11px;
			font-family: $font-family-default;
			color: $color-heading-sub;
			font-weight: bold;
			text-transform: uppercase;
			&:hover {
				color: $theme-color-hover;
			}
		}
	}
	.dropdown-toggle::after {
		@include display(none);
	}
	&:hover {
		background: #eee;
	}
	@media (max-width: 375px) {
		padding: 10px 15px;
	}
}
.icon-facebook {
	fill: #3b5998;
}
.icon-twitter {
	fill: #00aced;
}
.icon-pinterest {
	fill: #cb2027;
}

.share-title {
	@include display(inline-block);
	vertical-align: middle;
	font-family: $font-family-primary;
	font-size: 12px;
	color: #666766;
	font-weight: 700;
	&:hover {
		color: $theme-color-hover;
	}
}

/* Search Bar ==============================================================================================================*/
.search-toggle {
	cursor: pointer;
}
.overlay{
	position: fixed;
	@include square(100%);
	top: 0;
	@include rtl-left(0);
	z-index: 10000;
	@include opacity(0);
	visibility: hidden;
	@include transition(opacity 0 0.5s,visibility 0 0.5s);
	&.style-dark-bg {
		background-color: rgba($color-default, 0.6) !important;
	}
	&.style-light-bg {
		background-color: $color-white !important;
	}

	&.overlay-search {
		@include display(table);
		table-layout: fixed;
		@include square(100%);
		text-align: center;
		.search-container form{
			@include opacity(1);
			@include translate(-50%,-50%);
			-webkit-transition: -webkit-transform 0.2s,opacity 0.2s;
			transition: transform 0.2s,opacity 0.2s;
			@include display(inline-block);
			width: 100%;
			max-width: 600px;
			max-width: 60vw;
			position: absolute;
			top: 50%;
			@include rtl-left(50%);
			input {
				@include display(inline-block);
				margin: 0px;
				width: 100%;
				font-size: 28px;
				font-size: 3vh;
				padding: .8em 0;
				@include rtl-padding-lr(1.5em,3em);
				border: none;
				border-bottom: 1px solid #d0d0d0;
				color: $color-heading-sub;
				background-color: transparent;
				border-radius: $border-radius;
				outline: none;
				@include placeholder {
					color: #cfcfcf;
				}
			}
			.search__des {
				color: #343434;
				@include opacity(0);
				@include translateY(-40px);
				@include transition(transform 0.5s,opacity 0.5s);
				-webkit-transition-delay: 0.1s;
				-moz-transition-delay: 0.1s;
				-ms-transition-delay: 0.1s;
				-o-transition-delay: 0.1s;
				transition-delay: 0.1s;
				i {
					font-size: 72px;
				}
				h2 {
					font-size: 36px;
					margin-top: 25px;
					margin-bottom: 20px;
					font-family: $font-family-primary;
					font-weight: bold;
				}
				div {
					font-size: 11px;
					font-weight: 500;
					text-transform: uppercase;
					width: 100%;
					max-width: 440px;
					margin: 0 auto;
					margin-bottom: 85px;
				}
			}
			.search-container-inner {
				position: relative;
				@include opacity(0);
				@include translateY(-40px);
				@include transition(transform 0.3s,opacity 0.3s);
				-webkit-transition-delay: 0.5s;
				-moz-transition-delay: 0.5s;
				-ms-transition-delay: 0.5s;
				-o-transition-delay: 0.5s;
				transition-delay: 0.5s;
			}
		}
		.close-search {
			color: #343434;
			position: absolute;
			top: 50px;
			@include rtl-right(50px);
			font-size: 36px;
			cursor: pointer;
		}
		.search-bar__submit {
			font-size: 28px;
			color: #dfdfdf;
			position: absolute;
			top: 50%;
			@include rtl-right(0.8em);
			@include translateY(-50%);
		}
	}
	&.open {
		@include opacity(1);
		visibility: visible;
		@include transition(opacity 0.5s);
		.search-container form {
			.search__des, .search-container-inner {
				@include opacity(1);
				@include translateY(0);
			}
		}
	}
}

/*============================================================================
The search submit button has pointer-events: none which also
effects the :hover style. This forces the style to be applied.
==============================================================================*/
.search-header__input:hover + .btn--link {
	opacity: $opacity-link-hover;
}

/*================ Header Search ================*/
.site_search {
	@media (max-width: 1199px) {
		justify-content: initial !important;
	}
}
.site-header__search {
	position: relative;
	.site-header__search-icon i {
		&.icon-search {
			@include display(block);
			@include square(15px);
			background: url({{ 'icon-autodaily.png' | asset_url }}) no-repeat;
			background-position: -18px -133px;
		}
	}
	.site_header__search {
		position: relative;
		.search-header__input {
			position: relative;
			padding: 0;
			@include placeholder{
				font-size: 10px;
				color: #252424;
				font-family: $font-family-default;
				font-weight: 400;
				text-transform: uppercase;
			}
			min-width: 284px;
			min-height: 46px;
			@include border-radius(40px);
			border: 1px solid #0f0f0f;
			background: #000;
			padding: 0;
			font-size: 12px;
			color: $color-white;
			font-family: $font-family-default;
			font-weight: 400;
			@include rtl-padding-lr(15px,60px);
		    @include box-shadow(0 0 10px rgba(0,0,0,0.15));
			&:-webkit-autofill, &:-webkit-autofill:hover, &:-webkit-autofill:focus {
				-webkit-box-shadow: 0 0 0px 1000px #f2f2f2 inset;
				transition: background-color 5000s ease-in-out 0s;
			}
		}
		&:hover, &:focus {
			.search-header__input {
				border: 1px solid $color-white;
			}
		}
		.search-header__submit {
			position: absolute;
			top: 3px;
			@include rtl-right(3px);
			padding: 12.5px;
			@include border-radius(40px);
			display: block;
			&:hover {
				background: $theme-color-hover;
				.site-header__search-icon i.icon-search {
					background-position: -18px -133px;
				}
			}
		}
	}
	@media (max-width: 991px) {
		.site_header__search {
			.search-header__input {
				min-width: 210px;
			    min-height: 40px;
		        @include rtl-padding-lr(15px,42px);
			}
			.search-header__submit {
			    top: 2px;
			    @include rtl-right(2px);
			    padding: 10.5px;
			}
		}
	}
}
.search-header {
	@include display(none);
	position: absolute;
	width: 100%;
	max-width: 30px;
	vertical-align: middle;

	&.search--focus {
		max-width: 250px;
	}
}
.search--focus {
	.search-header__input {
		outline: none;
		border-color: $color-border;
	}
	.search-header__submit {
		@include rtl-padding-left(10px);
	}
}
.search-header__submit {
	cursor: pointer;
	&:focus, &:hover {
		outline: none;
	}
}

.search-header,
.search-header__submit {
	transition: all 0.35s cubic-bezier(0.29, 0.63, 0.44, 1);
}

$return-button-width: 55px;
$nav-button-padding: 15px;

/* Mobile Site Nav =========================================================================================================*/
.mobile-nav {
	@include display(block);
	@include transform(translate3d(0, 0, 0));
	transition: $transition-drawer;

	.sub-nav--is-open & {
		@include transform(translate3d(-100%, 0, 0));
	}

	.third-nav--is-open & {
		@include transform(translate3d(-200%, 0, 0));
	}
}

.mobile-nav__link,
.mobile-nav__sublist-link {
	@include display(block);
	width: 100%;
	padding: $nav-button-padding ($nav-button-padding * 2);
	font-size: $font-size-mobile-input;
}

.mobile-nav__link {
	position: relative;
}

.mobile-nav__sublist-link:not(.mobile-nav__sublist-header) {
	@include rtl-padding-lr($return-button-width + $nav-button-padding,($nav-button-padding * 2));
}

.mobile-nav__item {
	@include display(block);
	width: 100%;

	.icon {
		position: absolute;
		top: 50%;
		@include rtl-left(50%);
		height: 12px;
		width: 10px;
		margin: -6px 0;
		@include rtl-margin-lr(-5px,0);
	}
}

.mobile-nav__return {
	@include rtl-border-right(1px solid $color-border);
}

.mobile-nav__return-btn {
	position: relative;
	padding: 24px 0;
	width: $return-button-width;
}

.mobile-nav__icon {
	position: absolute;
	@include rtl-right(0);
	top: 0;
	bottom: 0;
	@include rtl-padding-lr($gutter-site-mobile,$gutter-site-mobile);
	pointer-events: none;
	overflow: hidden;
}

.mobile-nav__table {
	@include display(table);
	width: 100%;
}

.mobile-nav__table-cell {
	@include display(table-cell);
	vertical-align: middle;
	width: 1%;
	@include rtl-text-align-left();
	white-space: normal;
}

.mobile-nav__toggle-button {
	padding: 20px 15px;
}

.mobile-nav__dropdown {
	position: absolute;
	background-color: $color-white;
	z-index: $z-index-sub-nav;
	width: 100%;
	top: 0;
	@include rtl-right(-100%);
	@include display(none);

	.is-active + & {
		@include display(block);
		@include opacity(1);
	}

	// Need the transition so `prepareTransition` removes class
	&.is-closing {
		transition: $transition-drawer;
		@include opacity(0.99);
	}

	.mobile-nav__sublist-header {
		font-family: $font-stack-header;
		font-weight: $font-weight-header;
		@include display(table-cell);
		vertical-align: middle;
		@include rtl-padding-left($nav-button-padding);
	}
}

/* Mobile nav wrapper =======================================================================================*/
.mobile-nav-wrapper {
	@include transform(translate3d(0, -100%, 0));
	position: absolute;
	background-color: $color-white;
	transition: $transition-drawer;
	@include display(none);
	overflow: hidden;
	width: 100%;

	&::after {
		content: '';
		position: absolute;
		bottom: 0;
		@include rtl-left(0);
		@include rtl-right(0);
		border-bottom: 1px solid $color-border;
	}

	&.js-menu--is-open {
		@include display(block);
	}
}

.mobile-nav--open {
	.icon-close {
		@include display(none);
	}
}

.mobile-nav--close {
	.icon-hamburger {
		@include display(none);
	}
}

// Nov Slick ====================================================================================
.nv-slick-slider {
	.slick-arrow {
		font-size: 30px;
		position: absolute;
		cursor: pointer;
		color: #a1a1a1;
		text-align: center;
		top: -70px;
		z-index: 9;
		&.slick-disabled {
			@include opacity(0.6);
		}
		&:hover {
			color: $theme-color-hover;
		}
		&.arrow-prev {
			@include rtl-right(54px);
			&:before {
				content: "";
				position: absolute;
				width: 1px;
				height: 16px;
				background: #e0e0e0;
				top: 14px;
				@include rtl-right(-15px);
			}
		}
		&.arrow-next {
			@include rtl-right(15px);
		}
	}
}
.nov-slick-carousel {
	.item img {
		margin: auto;
	}
	.slick-arrow {
		cursor: pointer;
		position: absolute;
		top: 0;
		@include translateY(0);
		z-index: 9;
		color: $theme-color-default;
		i {
			font-size: 4.5rem;
			font-weight: 400;
		}
		&.arrow-next {
			@include rtl-right(0);
		}
		&.arrow-prev {
			@include rtl-right(0);
		}
		&.slick-disabled {
			@include opacity(0.5);
		}
		&:hover {
			color: $theme-color-hover;
		}
	}
	@media (max-width: 767px) {
		.slick-arrow {
			@include display(none !important);
		}
	}
}

// Nov Carousel  ====================================================================================
.nov-owl-carousel {
	.owl-nav {
		[class*='owl-'] {
			background: none;
			padding: 0;
			margin: 0;
			color: $theme-color-default;
			&:hover {
				background: none;
			}
			&.owl-prev {
				@include rtl-left(-59px);
			}
			&.owl-next {
				@include rtl-right(-59px);
			}
		}
		.owl-prev, .owl-next {
			cursor: pointer;
			position: absolute;
			top: 50%;
			@include translateY(-50%);
			z-index: 9;
			i {
				font-size: 4.5rem;
				font-weight: 400;
				color: $theme-color-default;
			}
			&:hover {
				i {
					color: $theme-color-hover;
				}
			}
		}
	}
	@media(max-width: 767px) {
		.owl-nav {
			@include display(none);
		}
	}
}

/* Product Item ===========================================================================================================*/
.block_margin {
	margin: -30px -30px -60px;
	.block_padding {
		position: static;
		padding: 30px 30px 60px;
		overflow: hidden;
	}
	.slick-list {
		overflow: initial;
		position: relative;
		z-index: 9;
		.slick-slide{
			@include opacity(0);
			visibility: hidden;
			&.slick-active{
				@include opacity(1);
				visibility: visible;
			}
		} 
	}
	.owl-carousel .owl-stage-outer {
		overflow: initial;
	}
	@media (max-width: 575px) {
		margin: -15px;
		.block_padding {
			padding: 15px;
		}
	}
}

.item-product {
	position: relative;
	border: 1px solid #eaeaea;
	@include border-radius(8px);
	padding: 4px;
	@include transition(all 0.3s linear);
	background: $color-white;
	.thumbnail-container {
		position: relative;
		overflow: hidden;
		@include flexbox();
		@include border-radius(8px);
		img {
			margin: 0 auto;
		}
		&.has-multiimage {
			img:not(.product__thumbnail-second) {
				@include opacity(1);
				visibility: initial;
				@include transition(all 0.6s linear);
			}
		}
		.product__thumbnail-second {
			position: absolute;
			top: 0;
			@include rtl-left(0);
			@include opacity(0);
			visibility: hidden;
			@include transition(all 500ms);
			@include translateY(20px);
		}
		.group-buttons {
			position: absolute;
			bottom: 16px;
			@include rtl-left(50%);
			@include translateX(-50%);
		}
		.badge_sale {
			position: absolute;
			top: 10px;
			@include rtl-left(10px);
			.badge {
				display: block;
			}
			.badge--sale-rt {
				font-family: $font-family-default;
				font-weight: bold;
				font-size: 9px;
				text-transform: uppercase;
				color: $color-white;
				background: #56cb82;
				@include border-radius(0 6px 0 6px);
				padding: 5.5px 15px;
				max-width: 48px;
				margin-bottom: 5px;
			}
			.badge--sale-pt {
				font-family: $font-family-default;
				font-weight: bold;
				font-size: 11px;
				text-transform: uppercase;
				color: $color-white;
				background: #e85b40;
				@include border-radius(0 6px 0 6px);
				min-width: 48px;
				min-height: 20px;
				@include flexbox();
				@include align-items(center);
				@include justify-content(center);
			}
		}
	}
	.product__info {
		text-align: center;
		overflow: hidden;
		margin-bottom: 26px;
		.product__title {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			overflow: hidden;
			margin: 20px 0 2px 0;
			a {
				font-size: 13px;
				font-weight: 500;
				font-family: $font-family-primary;
				color: $color-heading-second;
				&:hover {
					color: $theme-color-hover;
				}
			}
		}
		.product__price {
			color: $color-heading;
			font-size: 13px;
			font-weight: bold;
			font-family: $font-family-primary;
			margin-bottom: 25px;
			s.product-price__price {
				color: #d5d5d5;
				font-size: 13px;
				font-weight: bold;
				@include rtl-margin-left(10px);
			}
		}
		.product__review {
			margin-bottom: 10px;
			.spr-badge-caption {
				@include display(none);
				margin-top: 5px;
				@include rtl-margin-left(10px);
				font-size: 12px;
				color: #dbdbdb;
			}
			.spr-starrating {
				@include rtl-margin-right(0);
				.spr-icon {
					@include opacity(1);
				}
				.spr-icon:before {
					@include display(inline-block);
					font: normal normal normal 14px/1 FontAwesome;
					font-size: inherit;
					text-rendering: auto;
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					color: #dbdbdb;
					font-size: 12px;
				}
				.spr-icon-star:before {
					content: "\f005";
					color: #ffd201;
				}
				.spr-icon-star-empty:before {
					content: "\f006";
				}
			}
		}
	}
	.product-swatch-color {
		@include opacity(0);
		visibility: hidden;
		margin-bottom: 7px;
		@include rtl-padding-left(1px);
	}
	.product__available {
		text-transform: uppercase;
		font-size: 11px;
		font-weight: 500;
		i {
			@include rtl-margin-right(10px);
			font-size: 1.4rem;
		}
		&.sold-out {
		}
		&.in-stock {
			color: #5fbb52;
		}
	}
	.formAddToCart {
		@include transition(all 0.3s linear);
		position: relative;
		display: inline-block;
		.btnAddToCart {
			background: #f0f0f0;
			padding: 11.5px 35px;
			min-width: 210px;
			min-height: 40px;
			@include flexbox();
			@include align-items(center);
			@include justify-content(center);
			@include border-radius(40px);
			border: none;
			i {
				color: $color-heading;
				font-size: 17px;
			}
			span {
				font-size: 10px;
				font-family: $font-family-default;
				font-weight: 900;
				text-transform: uppercase;
				@include rtl-margin-left(7px);
				color: $color-heading;
			}
			.icon_cart {
				@include display(inline-block);
				margin: auto;
				width: 10px;
				height: 12px;
				background: url({{ 'icon-autodaily.png' | asset_url }});
				background-position: 0 -99px;
				vertical-align: sub;
				margin: 0 0 2px;
			}
			i.zmdi-check {
				color: $color-heading;
			}
			&:hover {
				background: $theme-color-hover;
				@include box-shadow(0 0 5px 0 rgba(0,0,0,.2));
				span {
					color: $color-white;
				}
				.icon_cart {
					background-position: -19px -99px;
				}
				i.zmdi-check {
					color: $color-white;
				}
			}
		}
	}
	.productQuickView {
		@include transition(all 0.3s linear);
		.fa_quickview {
			@include display(inline-block);
			margin: auto;
			@include square(15px);
			background: url({{ 'icon-autodaily.png' | asset_url }});
			background-position: 0 -133px;
			vertical-align: sub;
		}
		&:hover {
			.fa_quickview {
				background-position: -19px -133px;
			}
			.btnProductQuickview {
				background: $theme-color-hover;
				@include box-shadow(0 0 5px 0 rgba(0,0,0,0.2));
			}
		}
	}
	.productWishList {
		@include transition(all 0.3s linear);
		.fa_wishlist {
			@include display(inline-block);
			margin: auto;
			width: 15px;
			height: 15px;
			background: url({{ 'icon-autodaily.png' | asset_url }});
			background-position: 0 -115px;
			vertical-align: sub;
		}
		&:hover {
			.fa_wishlist {
				background-position: -20px -115px;
			}
			.btnProductWishlist {
				background: $theme-color-hover;
				@include box-shadow(0 0 5px 0 rgba(0,0,0,0.2));
			}
		}
	}
	.productWishList, .productQuickView {
		margin: 0;
		@include rtl-margin-right(5px);
		@include translateY(60px);
		@include opacity(0);
		transform: scale(0);
		visibility: hidden;
		.btn {
			background: $color-white;
			padding: 0;
			@include square(40px);
			line-height: 40px;
			@include border-radius(40px);
			border: none;
			@include box-shadow(0 0 8px rgba(0, 0, 0, 0.25));
			i {
				font-size: 1.4rem;
			}
		}
	}
	.productWishList .btnProductWishlist {
		&.whislist-added {
			background: $theme-color-hover;
			@include box-shadow(0 0 5px 0 rgba(0,0,0,0.2));
			.fa_wishlist {
				background-position: -20px -115px;
			}
