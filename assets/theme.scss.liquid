		margin-bottom: 18px;
	}
	@media (max-width: 991px) {
		padding: 20px 20px 7px;
		margin: 20px 0 40px;
	}
}

/* sortPagiBar =============================================================================================================*/
.sortPagiBar {
	position: relative;
	margin-bottom: 40px;
	&:before {
		content: "";
		width: 100%;
		height: 1px;
		background: #e7e7e7;
		position: absolute;
		top: 50%;
		@include rtl-left(0);
	}
	.gridlist-toggle {
		background: $color-white;
		z-index: 1;
		@include rtl-padding-right(14px);
		a {
			@include display(inline-block);
			@include square(35px);
			line-height: 37px;
			background: #c4c4c4;
			color: $color-white;
			font-size: 14px;
			text-align: center;
			@include border-radius(2px);
			&.active,&:hover {
				background: $theme-color-hover;
				color: $color-white;
			}
			&:not(:last-child) {
				@include rtl-margin-right(2px);
			}
		}
	}
	.showing-total {
		font-size: 11px;
		font-weight: 400;
		font-family: $font-family-default;
		color: $color-text;
		text-transform: uppercase;
		background: $color-white;
		z-index: 1;
		@include rtl-padding-right(10px);
	}
	.filters-toolbar__item {
		@include rtl-padding-left(7px);
		z-index: 9;
		background: $color-white;
		position: relative;
		@include rtl-margin-left(auto);
		.btn {
			font-family: $font-family-default;
			font-size: 11px;
			font-weight: 400;
			color: $color-text;
			text-transform: uppercase;
			padding: 9px 0 10px;
			@include rtl-padding-lr(9px,67px);
			height: 35px;
			border: none;
			background: $color-white;
			border: 1px solid #dfdfdf;
			@include border-radius(3px);
			&:hover {
				color: $theme-color-hover;
				border: 1px solid $theme-color-hover;
			}
		}
		.dropdown-toggle {
			&:after {
				@include display(none);
			}
			&:before {
				content: "\f2f9";
				font-family: 'Material-Design-Iconic-Font';
				line-height: 0;
				font-size: 13px;
				font-weight: bold;
				position: absolute;
				top: 50%;
				@include rtl-right(9px);
			}
		}
		.dropdown-menu {
			min-width: 200px;
			padding: 5px 0;
			z-index: 999;
			.dropdown-item {
				font-size: 13px;
				color: #878787;
				font-family: $font-family-primary;
				font-weight: 400;
				&:hover,&.active {
					cursor: pointer;
					color: $color-heading;
					background: $color-white;
				}
			}
		}
	}
	@media (max-width: 1199px) {
		margin: 0 0 40px 0;
	}
	@media (max-width: 767px) {
		margin: 25px 0 30px;
	}
}

/* Pagination ==============================================================================================================*/
.nov-pagination {
	margin: 16px 0 80px;
	position: relative;
	&:before {
		content: "";
		position: absolute;
		width: 100%;
		height: 1px;
		background: #e7e7e7;
		top: 50%;
		@include rtl-left(0);
		z-index: 2;
	}
	@media (max-width: 767px) {
		margin: 16px 0 40px;
	}
	@media (max-width: 575px) {
		@include justify-content(center);
	}
}
.pagination__viewing {
	font-size: 11px;
	font-family: $font-family-default;
	font-weight: 400;
	color: $color-text;
	text-transform: uppercase;
	background: $color-white;
	z-index: 2;
	@include rtl-padding-right(8px);
	@include rtl-margin-right(auto);
	@media (max-width: 991px) {
		@include rtl-padding-right(15px);
	}
	@media(max-width: 480px) {
		@include display(none);
	}
}

.pagination {
	background: $color-white;
	text-align: center;
	list-style: none;
	z-index: 2;
	@include rtl-padding-left(10px);
	li {
		@include display(inline-block);
		&:not(:last-child) {
			@include rtl-margin-right(5px);
		}
	}
}

.pagination__text {
	>a, >span {
		@include square(35px);
		line-height: 35px;
		background: $color-heading;
		@include border-radius(2px);
		color: $color-white;
		font-size: 13px;
		font-weight: bold;
		font-family: $font-family-default;
		display: inline-block;
	}
	&.active, &:hover {
		>a, >span {
			background: $theme-color-hover;
			color: $color-white;
		}
	}
	&.active {
		&:hover {
			cursor: not-allowed;
		}
	}
}

.pagination__btn {
	font-family: $font-family-default;
	color: $color-text;
	font-weight: bold;
	font-size: 10px;
	text-transform: uppercase;
	padding: 8.5px 31.3px;
	background: $color-white;
	border: 1px solid #dfdfdf;
	&:hover {
		background: $theme-color-hover;
		border: 1px solid $theme-color-hover;
		color: $color-white;
	}
	&.disabled {
		&:hover {
			cursor: not-allowed;
		}
	}
	@media (max-width: 991px) {
		padding: 10px 15px;
	}
}

