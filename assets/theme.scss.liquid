					background: -webkit-linear-gradient(top,  #105caa 0%,#1fb7f0 100%);
					background: linear-gradient(to bottom,  #105caa 0%,#1fb7f0 100%);
					filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#105caa', endColorstr='#1fb7f0',GradientType=0 );
					.pricing-title {
						color: $color-white;
					}
					.pricing-info {
						.desc-pricing {
							color: $color-white;
						}
