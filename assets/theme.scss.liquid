	@include align-items(center);
	@include flex-wrap(wrap);
	@include flex-direction(row);
}
.map-section--load-error {
	height: auto;
}
.map-section__wrapper {
	height: 100%;
	flex-shrink: 0;
	flex-grow: 1;
	@include flex-basis(100%);
	@include flex-wrap(wrap);
	@include flex-direction(row);
}
.map-section__overlay {
	position: absolute;
	top: 0;
	@include rtl-right(0);
	bottom: 0;
	@include rtl-left(0);
	@include opacity(0);
	z-index: 2;
}
.map-section__error {
	position: relative;
	z-index: 3;

	@media (min-width: 768px) {
		position: absolute;
		margin: 0 2rem;
		top: 50%;
		@include translateY(-50%);
	}
}
.map-section__content-wrapper {
	position: relative;
	text-align: center;
	height: 100%;
	@include flexbox();
	@include flex-basis(100%);
	flex-grow: 0;

	@media (min-width: 768px) {
		@include flex-basis(50%);
	}

	@media (min-width: 1200px) {
		@include flex-basis(33%);
	}
}
.map-section__content {
	position: relative;
	@include display(inline-block);
	background-color: $color-white;
	padding: 50px 0;
	width: 100%;
	text-align: center;
	z-index: 3;
	@include flexbox();
	@include align-items(center);
	@include flex-wrap(wrap);
	@include align-content(center);

	// Make sure every children is on one line
	& > * {
		width: 100%;
	}

	@media (min-width: 768px) {
		background-color: $color-white;
		min-height: 382px;

		.ie9 & {
			top: 10%;
		}
	}
	.map-section--load-error & {
		position: static;
		@include translateY(0);
	}
	.map_section__directions-btn {
		padding: 10px 50px;
		@include border-radius(0);
		font-family: $font-family-primary;
		font-weight: bold;
		font-size: 12px;
		&:hover, &:focus {
			color: $color-white;
			@include transition(all 0.35s ease);
		}
	}
}
.map-section__link {
	@include display(block);
	position: absolute;
	top: 0;
	@include rtl-left(50%);
	max-width: none;
	@include square(100%);
	z-index: 2;
	@include translateX(-50%);
}
// Optically center map in visible area with
// extended height/widths and negative margins
.map-section__container {
	max-width: none;
	width: 100%;
	height: 55vh;
	@include rtl-left(0);
	z-index: 3;
	@media (min-width: 768px) {
		position: absolute;
		height: 100%;
		top: 0;
		// map is centered on resize, larger widths allow pin to be off-center
		width: 100%;
	}
}
.map-section__background-wrapper {
	overflow: hidden;
	position: relative;
	@include flex-basis(100%);
	position: absolute;
	@include rtl-left(0);
	top: 0;
	@include square(100%);
	.ie9 & {
		width: 100%;
		height: 500px;
	}

	.map-section--onboarding & {
		min-height: 55vh;
	}
}
.map-section__image {
	@include square(100%);
	position:relative;
	top: 0;
	@include rtl-left(0);
	background-size: cover;
	background-position: center;

	@media (min-width: 768px) {
		position: absolute;
	}

	// Only show the background image if map fails to load
	.map-section--display-map & {
		@include display(none !important);
	}

	.map-section--load-error & {
		@include display(block !important);
	}
}

// Vertical menu ============================================================================================= */
// Vertical menu
#_desktop_vertical_menu {
	border: 1px solid $theme-color-hover;
	border-top: none;
	@include border-radius(0 0 10px 10px);
    @include box-shadow(2px 10px 10px rgba(0,0,0,.55));
	.site-nav>li {
		&:before, &:after {
			display: none !important;
		}
		&.site-nav--active a:before {
			display: none;
		}
		&.site-nav--has-dropdown.icon_menu {
			&:not(.megaMenu) .site-nav__dropdown {
				ul li:not(:last-child) a {
					border-bottom: 1px solid #ededed;
				}
			} 
		}
		&:hover {
			background: transparent;
		}
	}
}
.vertical_menu {
	position: absolute;
	top: 100%;
	background: #0d0d0d;
	z-index: 99;
	cursor: pointer;
	min-width: 270px;
	.site-nav {
		&>li {
			padding: 0;
			position: static;
			@include display(block);
			list-style-type: none;
			margin: 0;
			&:not(:last-child) {
				border-bottom: 1px solid #191919;
			}
			&>a {
				font-family: $font-family-primary;
				color: $color-white;
				font-size: 13px;
				font-weight: 500;
				@include transition(all 0.3s linear);
				@include display(block);
				text-transform: none;
				@include display(flex);
				@include align-items(center !important);
				padding: 21px 11px 22px;
				&:hover {
					color: $theme-color-hover;
					@include transition(all 0.35s ease);
				}
			}
			&.icon_menu {
				&>a:before, &>a:after {
					display: none !important;
				}
			}
			&.site-nav--has-dropdown {
				&.icon_menu {
					&>a:after {
						display: block !important;
					}
				}
				&>a:before {
					display: none;
				}
				.menuGroup {
					.menuCol {
					    margin: 28px 0 0;
					}
					.novMenuLinks {
						padding-top: 30px;
					    @include rtl-padding-left(0);
						margin: 0;
					    @include rtl-margin-left(15px);
					}
				}
				&>a {
					&:after {
						content: "";
					    @include rtl-left(100%);
					    border-style: solid;
					    border-width: 20px 0 20px 15px;
					    border-color: transparent transparent transparent $theme-color-hover;
					    @include square(0);
					    position: absolute;
					    pointer-events: none;
					    top: 50%;
					    @include translateY(-50%);
					    @include rtl-margin-left(0);
					    @include opacity(0);
					    visibility: hidden;
					}
				}
				&:hover {
					&>a {
						&:after {
							@include opacity(1);
							visibility: initial;
						}
					}
				}
			}
			.megaMenu, .site-nav__dropdown {
				@include rtl-left(100% !important);
				top: 0;
				height: 100%;
				z-index: 99;
				@include rtl-margin-left(16px);
				overflow: hidden;
				@include border-radius(0);
				-webkit-transform: translateX(0) !important;
				-moz-transform: translateX(0) !important;
				-ms-transform: translateX(0) !important;
				-o-transform: translateX(0) !important;
				transform: translateX(0) !important;
			}
			.site-nav__dropdown:not(.megaMenu) {
				padding: 5px 20px 15px;
				a {
					padding: 10px 0;
					&:hover {
						background-color: transparent;
						color: $theme_color_primary;
						@include transition(all 0.35s ease);
					}
				}
			}
		}
		.icon_nav {
			min-width: 31px;
			text-align: center;
			@include rtl-margin-right(23px);
		}
		.site-nav--has-dropdown {
			&.hasMegaMenu {
				.menuGroup .row.spacing-30 [class*="col-"] {
					padding: 0;
				}
			}
		}
	}
	.show_more {
		cursor: pointer;
		line-height: 74px;
		@include rtl-padding-left(5px);
		border-top: 1px solid #e6e6e6;
		i {
			font-size: 22px;
			color: $theme_color_primary;
			@include rtl-margin-right(17px);
			vertical-align: middle;
		}
		span {
			color: #b2b2b2;
			font-weight: bold;
		}
		&.active, &:hover {
			span {
				color: $theme-color-primary;
				@include transition(all 0.35s ease);
			}
		}
		&.active {
			i {
				@include rotate(180deg);
			}
		}
	}
	@media(max-width: 1199px) {
		min-width: 210px;
		.site-nav {
			>li {
				&>a {
					font-size: 11px;
				    padding: 15.5px 10px;
			        min-height: 40px;
				}
				&.site-nav--has-dropdown {
					.menuGroup {
						.menuCol {
						    margin: 10px 0 0;
						}
						.novMenuLinks {
							padding-top: 15px;
						}
					}
					&.hasMegaMenu .megaMenu {
					    width: 710px !important;
					    @include rtl-margin-left(15px);
					}
					&:hover {
						&>a {
							&:after {
								border-width: 20px 0 20px 15px;
							}
						}
					}
				}
				.site-nav__dropdown {
					@include rtl-margin-left(15px);
				}
			}
		}
		.sub_title_nav {
			font-size: 10px;
		}
		.site-nav--has-dropdown {
			&.hasMegaMenu .megaMenu .novMenuLinks {
				li:not(.menuTitle) a, .site-nav__dropdown {
					.site-nav__link {
						font-size: 11px;
					}
				}
			}
			&.hasMegaMenu .megaMenu {
				.novMenuLinks {
					.menuTitle a {
						font-size: 13px;
						padding: 0;
					}
				}
			}
		}
	}
	@media(max-width: 991px) {
		&:not(#_mobile_vertical_menu) {
			position: fixed;
			height: 100vh;
			overflow: auto;
			text-align: center;
			top: 0;
			@include rtl-left(-270px);
			z-index: 999;
			padding: 0 20px 70px;
			width: 270px;
			@include border-radius(0);
			border: none;
			@include transition(all 0.4s linear);
			.site-nav {
				padding: 0;
			}
			li {
				.site-nav__dropdown {
					position: static;
					width: 100% !important;
					@include opacity(1);
					visibility: visible;
					@include border-radius(0);
					@include box-shadow(none);
					padding: 0;
					background: none !important;
					@include display(none);
					@include transition(none);
				}
			}
			>li>a {
				padding: 0 !important;
			}
			.show_sub i {
				font-size: 19px;
			}
			.site-nav>li .megaMenu, .site-nav>li .site-nav__dropdown {
				@include rtl-margin-left(0);
			}
			&.active {
				@include rtl-left(0);
				@include opacity(1);
			}
		}
		.site-nav {
			&>li {
				&>a {
					font-size: 13px;
					padding: 16.6px 0;
				}
				&:first-child {
					border-top: none;
				}
				&.site-nav--has-dropdown.icon_menu>a:after {
				    display: none !important;
				}
			}
			&>.site-nav--has-dropdown {
				&>a:before {
					@include display(none);
				}
				&:not(.hasMegaMenu) {
					.site-nav__dropdown {
						ul {
							@include rtl-margin-left(25px);
						}
					}
				}
				&.hasMegaMenu {
					.site-nav__dropdown {
						.menuGroup {
							.novMenuLinks {
								padding-bottom: 10px;
								li {
									&:not(.menuTitle) {
										@include rtl-margin-left(20px);
										a {
										    color: $color-white;
				    						border-bottom: 1px solid #ededed;
										}
									}
								}
								.menuTitle a {
								    color: $color-white;
								}
							}
						}
					}
				}
				&:hover {
					&>a:after {
						display: none;
					}
				}
			}
			.site-nav__dropdown .site-nav__link {
				font-size: 13px;
				color: $color-white;
			}
		}
	}
	@media(max-width: 767px) {
		.site-nav {
			&>.site-nav--has-dropdown {
				&>a {
					&:before {
						@include display(none);
					}
				}
				&.hasMegaMenu .site-nav__dropdown {
					.menuGroup .novMenuLinks {
						padding-top: 0;
					}
				}
			}
		}
	}
}
// Countdown Free
.countdownfree {
	@include transition(all 0.3s linear);
	.item-time {
		@include display(inline-block);
		text-align: center;
		&:not(:last-child) {
			@include rtl-margin-right(10px);
		}
		.data-time {
			span:not(.name-time) {
				@include border-radius(50%);
				color: $color-white;
				@include display(block);
				margin: auto;
				margin-top: 7px;
				font-size: 14px;
				font-weight: bold;
			}
		}
		.name-time {
			color: #888;
			@include display(block);
			font-size: 11px;
			font-weight: bold;
			margin-bottom: 7px;
		}
	}
}

/* Modals ============================================================================================*/
.modal-dialog-centered {
	@include flexbox();
	@include align-items(center);
	min-height: calc(100% - (2.5rem * 2));
}
.modal-backdrop {
	background: rgba(0,0,0,0);
	&.show {
		@include opacity(0);
	}
}
.modal {
	.modal-header {
		padding: 0;
		border-bottom: none;
		position: relative;
		z-index: 9;
		button {
			@include square(22px);
			background: $theme-color-primary;
			@include border-radius(50%);
			position: absolute;
			@include rtl-right(0);
			top: 0px;
			line-height: 22px;
			z-index: 99;
			padding: 0;
			@include transition(all 0.35s linear);
			i {
				color: $color-white;
				font-size: 13px;
				font-weight: 500;
				width: 22px;
			}
			&:hover {
				outline: none;
				@include rotate(180deg);
				@include transition(all 0.35s linear);
			}
		}
		.close {
			@include opacity(1);
			&:not(:disabled):not(.disabled) {
				&:focus, &:hover {
					@include opacity(1);
				}
			}
		}
	}
}
.modal-open {
	padding: 0 !important;
	overflow: inherit;
	.modal {
		overflow-y: hidden;
		padding: 0 !important;
	}
}

// Vinova Newsletter Popup  popup-subscribe ================================================================================================================
#popup-subscribe {
