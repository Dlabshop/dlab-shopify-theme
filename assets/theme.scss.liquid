// Category ========================================================================================================= */
.section_category {
	position: relative;
    z-index: 9;
	.block_heading {
		.title_block {
			font-size: 2.4rem;
			margin: 0;
			font-family: $font-family-primary;
			font-weight: 600;
			color: $color-heading;
			text-transform: capitalize;
			border-bottom: 1px solid #eeeeee;
			span {
				position: relative;
				display: inline-block;
				padding-bottom: 10px;
				&:after {
					content: "";
					position: absolute;
					width: 100%;
					height: 3px;
					background: $theme-color-primary;
					@include rtl-left(0);
					bottom: -2px;
				}
			}
		}
	}
	.block_category_grid {
		.category_image {
			min-width: 204px;
			max-width: 204px;
		    @include rtl-margin-right(18px);
		}
		.category_item {
			&:not(:nth-child(3n+0)) {
				.block_content {
					@include rtl-border-right(1px solid #ececec);
				}
			}
			&:nth-child(1),&:nth-child(2),&:nth-child(3) {
				border-bottom: 1px solid #ececec;
				padding-bottom: 30px;
				margin-bottom: 30px;
			}
		}
		.block_info {
			@include rtl-margin-right(10px);
			.category-subtitle {
				font-family: $font-family-default;
				font-weight: bold;
				font-size: 10px;
				text-transform: uppercase;
				letter-spacing: 2px;
				margin-bottom: 7px;
			}
			.category-title {
				font-family: $font-family-primary;
				font-weight: 800;
				font-size: 2rem;
				line-height: 24px;
				text-transform: uppercase;
				font-style: italic;
				margin-bottom: 10px;
				letter-spacing: 0.25px;
			}
			.category-desc {
				font-family: $font-family-default;
				font-weight: 500;
				font-size: 12px;
				line-height: 21px;
			    margin-bottom: 13px;
			}
			.category_button {
				a {
					font-family: $font-family-default;
					font-weight: 900;
					font-size: 10px;
					line-height: 20px;
					text-transform: uppercase;
					background: $theme-color-primary;
					min-width: 100px;
					min-height: 30px;
					display: inline-block;
					text-align: center;
					line-height: 30px;
					&:hover {
						background: #b7821c;
					}
				}
			}
		}
	}
	@media (max-width: 1439px) and (min-width: 1200px) {
		.block_category_grid .category_image {
		    min-width: 140px;
		}
	}
	@media (max-width: 1199px) {
		.block_category_grid .category_item {
		    &:nth-child(2), &:nth-child(4) {
		    	.block_content {
		    		@include rtl-border-right(none);
		    	}
		    }
		    &:nth-child(3) {
		    	.block_content {
		    	    @include rtl-border-right(1px solid #ececec);
			    }
			}
			&:nth-child(4) {
	    	    border-bottom: 1px solid #ececec;
	    	    padding-bottom: 30px;
	    	    margin-bottom: 30px;
			}
 		}
	}
	@media (max-width: 991px) {
		.block_category_grid .category_image {
		    min-width: 120px;
		}
	}
	@media (max-width: 767px) {
		.block_category_grid .category_item {
			&:not(:nth-child(3n+0)), &:nth-child(3) {
				.block_content {
					@include rtl-border-right(none);
				}
			}
			&:not(:last-child) {
				padding-bottom: 30px;
				margin-bottom: 30px;
			    border-bottom: 1px solid #ececec;
			}
		}
	}
	@media (max-width: 575px) {
		.block_category_grid .category_image {
			min-width: 140px;
			max-width: 100px;
		}
	}
}

// Slideshow ======================================================================================================== */
.section-slideshow {
	.nov-slick-carousel {
		.item img {
			margin: 0;
		}
		.slick-list {
			overflow: hidden;
		}
	}
	.main-slider {
		position: relative;
		width: 100%;
		@include opacity(0);
		visibility: hidden;
		margin-bottom: 0;
		&.slick-initialized {
			@include opacity(1);
			visibility: visible;
		}
	}
	.slick-slide {
		position: relative;
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		>a {
			cursor: default;
		}
		video {
			@include display(block);
			position: absolute;
			top: 50%;
			@include rtl-left(50%);
			min-width: 100%;
			min-height: 100%;
			@include square(auto);
			transform:translate(-50%, -50%);
		}
		iframe {
			position: relative;
			pointer-events: none;
		}
		figure {
			position: relative;
			height: 100%;
			margin: 0;
		}
		.slide-image {
			height: 100%;
			background-size: cover;
			background-position: center;
			@include transition(all .8s ease);
		}
		.image-entity {
			width: 100%;
			height: 100%;
			visibility: hidden;
		}
		&.slick-active {
			z-index: 1;
			.content-caption {
				@include opacity(1);
				@include transition(all .7s cubic-bezier(0.32, 0.34, 0, 1.62) .6s);
				margin-top: 0;
			}
		}
	}
	.content-caption {
		position: absolute;
		width: 100%;
		z-index: 1;
		@include opacity(0);
		@include transition(all .3s ease);
		padding: 0 20px;
		.img_caption {
			@include display(inline-block);
			margin-bottom: 20px;
			padding: 0 15px;
		}
		.img_caption_2 {
			margin-bottom: 20px;
			padding: 0 15px;
		}
		.caption-1 {
			font-family: $font-family-primary;
			padding: 0 0 13px;
			font-weight: 900;
			line-height: 40px;
			text-transform: uppercase;
			strong {
				font-family: $font-family-primary;
				font-size: 2.4rem;
				font-weight: 300;
				color: $color-white;
			}
			&.s {
				font-size: 3.8rem;
			}
			&.m {
				font-size: 4rem;
			}
			&.l {
				font-size: 4.5rem;
			}
			&.xl {
				font-size: 6rem;
			    padding: 0 0 14px;
			    line-height: 50px;
			    font-style: italic;
			}
		}
		.caption-2 {
			padding: 0 0 7px;
			font-weight: 800;
			font-family: $font-family-primary;
			display: inline-block;
			text-transform: uppercase;
			p {
				@include rtl-padding-right(16px);
				display: inline-block;
			}
			strong {
				font-size: 1.7rem;
				position: absolute;
				top: 3px;
				@include rtl-left(107px);
			}
			&.s {
				font-size: 1.8rem;
			}
			&.m {
				font-size: 3rem;
			}
			&.l {
				font-size: 3rem;
				font-weight: 200;
				text-transform: none;
			}
		}
		.caption-3 {
			font-family: $font-family-primary;
			font-weight: 400;
			text-transform: none;
			line-height: 24px;
			margin-bottom: 22px;
		    letter-spacing: 0.5px;
	        margin-right: 195px;
			&.s {
				font-size: 1.4rem;
			}
			&.m {
				font-size: 1.8rem;
			}
			&.l {
				font-size: 2rem;
			}
		}
		.cap_link {
			display: inline-block;
			a {
				font-family: $font-family-default;
				font-size: 11px;
				font-weight: 900;
			}
			&.style_1 {
				background: #ff1f1f;
				padding: 11px 0;
			    min-width: 170px;
	    		text-align: center;
	    		a {
					text-transform: uppercase;
					.icon_link_slide {
						@include display(inline-block);
						width: 10px;
						height: 12px;
						background: url({{ 'icon-autodaily.png' | asset_url }}) no-repeat;
						background-position: -19px -99px;
						@include rtl-margin-right(12px);
					}
	    		}
				&:hover {
					background: $theme-color-hover;
				}
			}
			&.style_2 {
			    padding: 0 15px;
				a {
					font-size: 1.8rem;
					font-weight: 800;
					font-variant: small-caps;
	    		}
				&:hover {
					a {
						color: $color-white !important;
					}
				}
			}
		}
		.content-2 {
			.caption-3.s {
			    max-width: 65%;
    			margin: 0 auto 22px;
			}
		}
	}
	.slick-dots {
		bottom: 31px;
		@include rtl-left(50%);
		@include translateX(-50%);
		width: inherit;
		li {
			margin: 0 5px;
			@include square(14px);
			button {
				@include square(14px);
				background-color: transparent;
				cursor: pointer;
				@include display(inline-block);
				padding: 0;
				position: relative;
				outline:none;
				&:before {
					@include square(14px);
					content: "";
					position: absolute;
					@include rtl-left(50%);
					top: 50%;
					@include translate(-50%,-50%);
					@include opacity(1);
					z-index: -1;
					background: $color-white;
				}
			}
			&.slick-active {
				button::before {
					background: $theme-color-primary;
				}
			}
		}
	}
	.slick-arrow {
		text-align: center;
		position: absolute;
		top: 50%;
		@include translateY(-50%);
		z-index: 1;
		cursor: pointer;
		background: rgba(0, 0, 0, 0.3);
		padding: 20.5px 19.8px;
		&:hover {
			background: #444343;
			@include transition(all 0.35s ease);
		}
		&.arrow-prev {
			@include rtl-left(0);
		}
		&.arrow-next {
			@include rtl-right(0);
		}
		i {
			font-size: 2.4rem;
			color: $color-white;
		}
	}
	&.style_1 {
		.slick-dots li {
			@include square(14px);
			button {
				@include square(14px);
				color: $color-white;
				&:before {
					@include square(14px);
					background: #8c8c8c;
				}
			}
			&.slick-active, &:hover {
				button:before {
					background: $theme-color-primary;
					@include transition(all 0.35s ease);
				}
			}
		}
	}
	&.style_2 {
		.slick-dots li {
			width: 40px;
			height: 5px;
			button {
				width: 40px;
				height: 5px;
				color: transparent;
				&:before {
					width: 40px;
					height: 5px;
					background: $color-white;
				}
			}
			&.slick-active, &:hover {
				button:before {
					background: $theme-color-primary;
					@include transition(all 0.35s ease);
				}
			}
		}
	}
	&.style_3 {
		.slick-dots li {
			@include square(12px);
			button {
				@include square(12px);
				color: transparent;
				&:before {
					@include square(12px);
					background: $color-white;
					@include border-radius(100%);
				}
			}
			&.slick-active, &:hover {
				button:before {
					background: $theme-color-hover;
					@include transition(all 0.35s ease);
				}
			}
		}
	}
	@media (max-width: 1199px) {
		.content-caption {
			top: 40% !important;
			.caption-1 {
				&.m {
					font-size: 3.5rem;
				}
				&.xl {
				    font-size: 4rem;
				    line-height: 40px;
				}
			}
			.caption-3 {
				margin-bottom: 35px;
				&.m {
					font-size: 1.4rem;
				}
			}
		}
	}
	@media (max-width: 991px) {
		.slick-arrow {
			@include opacity(0);
			visibility: hidden;
			@include transition(all 0.3s linear);
		}
		.content-caption {
			.content {
				padding: 0 15px;
			}
			.caption-1 {
				&.s {
				    font-size: 2.4rem;
			        line-height: 20px;
				}
				&.m {
					font-size: 3rem;
					padding: 0 15px 15px;
				    line-height: 35px;
				}
				&.l {
				    font-size: 3rem;
			        line-height: 30px;
				}
			}
			.caption-2 {
				&.l {
				    font-size: 2rem;
				    padding: 0 0 8px;
				}
				&.m {
					font-size: 2.1rem;
					padding: 0 0 10px;
				}
			}
			.caption-3 {
				margin-bottom: 15px;
			    line-height: 20px;
			    @include rtl-margin-right(0);
				&.l {
				    font-size: 1.3rem;
				}
			}
			.cap_link.style_1 {
			    padding: 5px 0;
    			min-width: 140px;
			}
			.content-2 .caption-3.s {
			    max-width: 100%;
			}
		}
		&:hover {
			.slick-arrow {
				@include opacity(1);
				visibility: initial;
				@include transition(all 0.3s linear);
			}
		}
	}
	@media (max-width: 767px) {
		.content-caption {
		    top: 20% !important;
			.caption-1.m {
				font-size: 3rem;
				line-height: 25px;
				padding-bottom: 10px;
			}
			.caption-2 strong {
				@include rtl-left(90px);
			}
			.caption-3 {
				margin-bottom: 10px;
			}
			.content-2 .caption-3 {
				font-weight: 500;
				line-height: 20px;
				margin-bottom: 25px;
			}
			.cap_link {
			    padding: 10px 0;
			    min-width: 140px;
			}
		}
	}
	@media (max-width: 575px) {
		.content-caption {
	        top: 8% !important;
			.caption-1 {
				&.s {
				    font-size: 2rem;
					line-height: 20px;
    				padding: 0;
				}
				&.l {
				    font-size: 2.5rem;
				    line-height: 20px;
				    padding: 0 0 5px;
				}
				&.xl {
				    font-size: 3rem;
					line-height: 30px;
					padding: 0;
				}
			}
			.caption-2 {
				&.l {
				    font-size: 1.6rem;
    				padding: 0 0 5px;
				}
				&.m {
					padding: 0;
				}
			}
			.caption-3 {
				&.l {
				    line-height: 17px;
				}
				&.s {
				    line-height: 18px;
				}
			}
			.content-2 .caption-3 {
				&.s {
					margin-bottom: 5px;
				}
			}
		}
		.slick-dots {
			display: none !important;
		}
		.slick-arrow {
			padding: 7px;
		}
	}
}

