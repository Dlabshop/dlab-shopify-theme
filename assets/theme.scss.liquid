					background: -webkit-linear-gradient(top,  #00d2f3 0%,#0090c5 100%);
					background: linear-gradient(to bottom,  #00d2f3 0%,#0090c5 100%);
					filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#00d2f3', endColorstr='#0090c5',GradientType=0 );
				}
			}
			.stepbuy-number {
				background: #00c9ec;
			}
		}
		&.stepbuy--4 {
