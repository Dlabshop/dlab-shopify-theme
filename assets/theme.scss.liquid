/* Cart page ============================================================================================================== */
.cart-section {
	.title-block {
		font-family: $font-family-default;
		position: relative;
	    font-size: 1.6rem;
	    font-weight: 900;
	    color: $color-heading;
	    margin-bottom: 30px;
	    text-transform: uppercase;
	}
	.cart {
		margin-bottom: 100px;
		.cart__layout_left {
			margin-bottom: 96px;
			.cart__header {
				font-family: $font-family-default;
				font-size: 10px;
				font-weight: bold;
				color: $color-heading;
				text-transform: uppercase;
				padding: 15.5px 0;
				border: 1px solid #eaeaea;
				background: #f2f2f2;
			}
			.cart__body {
				border: 1px solid #eaeaea;
				.cart-flex {
					padding: 30px 0;
					&:not(:last-child) {
						border-bottom: 1px solid #eaeaea;
					}
				}
				.cart__remove-wrapper {
					.cart__remove {
						i {
							font-size: 14px;
							font-weight: 400;
						}
						&:hover, &:focus {
							i {
								color: $theme-color-hover;
							}
						}
					}
				}
				.cart__image-wrapper {
					.cart__image {
						border: 1px solid #eaeaea;
					}
					.cart__meta {
						@include rtl-padding-left(20px);
						.list-view-item__title {
							margin-bottom: 5px;
							a {
								font-family: $font-family-primary;			
								font-size: 11px;
								font-weight: 600;
								color: $color-heading-sub;
								&:hover {
									color: $theme-color-hover;
								}
							}
						}
						.cart__meta-text {
							font-family: $font-family-default;			
							font-size: 10px;
							font-weight: bold;
							color: $color-text;
							text-transform: uppercase;
						}
					}
				}
				.cart__update-wrapper {
	        		.cart__qty-input {
	        			min-width: 49px !important;
	        			height: 36px !important;
	        			font-family: $font-family-default;
	        			font-weight: bold;
	        			font-size: 13px;
	        			color: $color-heading-second;
	        			text-align: center;
	        			background-color: #f9f9f9;
	        			padding: 0;
	        			border: none;
	        			/* Chrome, Safari, Edge, Opera */
	        			&::-webkit-outer-spin-button,
	        			&::-webkit-inner-spin-button {
	        				-webkit-appearance: none;
	        				margin: 0;
	        			}
	        			/* Firefox */
	        			&[type=number] {
	        				-moz-appearance: textfield;
	        			}
	        		}
	        		.js-qty__adjust {
		        		font-weight: 400;
		        		color: #b4b4b4;
		        		font-size: 1.6rem;
		        		border: none;
		        		min-width: 18px;
		        		@include flexbox();
		        		@include align-items(center);
		        		@include justify-content(center);
		        		background: $color-white;
		        		padding: 0;
		        		cursor: pointer;
		        		.icon-minus, .icon-plus {
		        			display: none;
		        		}
		        		&.js-qty__adjust--minus {
		        			@include rtl-border-right(1px solid #ebebeb);
		        		}
		        		&.js-qty__adjust--plus {
		        			@include rtl-border-left(1px solid #ebebeb);
		        		}
		        		&:hover {
		        			color: $theme-color-hover;
		        		}
	        		}
	        		.cart__qty {
	        			border: 1px solid #e0e0e0;
	        			max-width: 89px;
	        			@include flexbox();
	        		}
				}
				.cart__price-wrapper {
					font-family: $font-family-default;			
					font-size: 12px;
					font-weight: 800;
					color: $color-heading-sub;
				}
				.total {
					.money {
						font-family: $font-family-primary;
						font-size: 1.4rem;
						font-weight: 800;
						color: $color-heading;
					}
				}
			}
			.button_cart {
				margin-top: 30px;
				@include flexbox();
				@include align-items(center);
				@include justify-content(space-between);
				.btn {
					width: 100%;
					height: 46px;
					line-height: 46px;
					padding: 0;
					@include border-radius(0);
					font-family: $font-family-default;
					font-weight: bold;
					font-size: 10px;
					letter-spacing: 0.2px;
					color: $color-heading;
				}
				.btn--small-wide {
					@include rtl-margin-right(30px);
					background: $color-heading;
					color: $color-white;
					border: 1px solid $color-heading;
					&:hover {
						background: $theme-color-hover;
						color: $color-heading;
						border: 1px solid $theme-color-hover;
					}
				}
				.cart__continue--large {
					background: $color-white;
					border: 1px solid $color-heading;
					&:hover {
						background: $color-heading;
						color: $color-white;
						border: 1px solid $color-heading;
					}
				}
			}
		}
		.cart__layout_right {
			border: 1px solid #eaeaea;
			.cart__heading {
				font-family: $font-family-default;
				font-size: 10px;
				font-weight: bold;
				color: $color-heading-sub;
				text-transform: uppercase;
				padding: 16px 20px;
				border-bottom: 1px solid #eaeaea;
			}
			.grid_cart {
				padding: 20px;
				background: #f2f2f2;
				.grid__item {
					.cart__total {
						margin-top: 3px;
						.cart__subtotal-title {
							font-family: $font-family-primary;
							font-size: 1.4rem;
							font-weight: bold;
							color: $color-heading;
							text-transform: uppercase;
						}
						.cart__subtotal {
							span {
								font-family: $font-family-primary;
								font-size: 2.2rem;
								font-weight: 800;
								color: $color-heading;
							}
						}
					}
					.cart__shipping {
					    padding: 13px 0 44px;
						.cart__shipping-title {
							font-family: $font-family-primary;
							font-size: 1.4rem;
							font-weight: bold;
							color: $color-heading;
							text-transform: uppercase;
						}
						.cart__shipping-sub {
							font-family: $font-family-default;
							font-size: 11px;
							font-weight: 500;
							color: $color-heading-sub;
						}
					}
					#threshold_bar_popup {
						margin-bottom: 0;
						.threshold_bar {
						    margin-bottom: 27px;
					        @include rtl-margin-left(38px);
						    @include border-radius(0 20px 20px 0);
						    &>span {
						    	height: 15px;
						    }
						}
						.threshold_spend {
							font-family: $font-family-default;
							font-weight: 900;
							font-size: 12px;
							color: $color-heading-sub;
							text-transform: uppercase;
							letter-spacing: 0.25px;
							margin-bottom: 2px;
						}
						.threshold_it {
							position: relative;
							.ic_threshold_bar {
								display: inline-block;
								background: #30b94d;
								@include border-radius(100%);
								// padding: 10px;
								width: 40px;
								height: 40px;
								position: absolute;
								top: -12px;
								@include rtl-left(0);
								@include flexbox();
								@include align-items(center);
								@include justify-content(center);
								i {
									font-size: 2.3rem;
									font-weight: 400;
									color: $color-white;
								}
							}
						}
					}
					.cart-notice-total {
						font-family: $font-family-default;
						font-size: 12px;
						font-weight: 400;
						color: $color-heading-sub;
						line-height: 22px;
						span.money {
							font-weight: 900;
							color: #30b94d;
						}
					}
				}
				.cart-note {
					.cart-note_label {
						font-family: $font-family-primary;
						font-weight: bold;
						font-size: 12px;
						color: $color-heading;
						text-transform: uppercase;
						margin: 30px 0 15px;
					}
					textarea {
						@include placeholder {
							font-family: $font-family-default;
							font-weight: 400;
							font-size: 10px;
							color: #c4c4c4;
							text-transform: uppercase;
						}
					}
				}
			}
			.content_threshold.threshold_congrats {
			    margin: 0 0 31px;
			}
		}
		.cart__layout_related {
			.product-related {
				.cart__popup-related-title {
					font-size: 2.2rem;
					margin-bottom: 34px;
				}
			}
		}
	}
	@media (max-width: 991px) {
		.spacing-md-20 {
			margin: 0 -10px;
			[class*="col-"] {
				padding: 0 10px;
			}
		}
	}
	@media (max-width: 767px) {
		.total {
			padding: 0 40px !important;
			@include flexbox();
			margin-top: 20px;
		}
		.d-sm-title {
			font-family: $font-family-default;
			font-size: 1.6rem;
			font-weight: 900;
			color: $color-heading;
			text-transform: uppercase;
		}
		.product-subtotal {
			width: 100%;
			text-align: center;
		}
	}
	@media (max-width: 575px) {
		.cart__remove-wrapper, .cart__image-wrapper {
		    margin-bottom: 15px;
		}
		.cart {
			.cart__layout_left {
				margin-bottom: 45px;
				.cart__body {
				    padding: 0 15px;
				}
				.button_cart .btn--small-wide {
				    @include rtl-margin-right(15px);
				}
			}
			.cart__layout_related {
				.related_product, .product-related {
					.popup__cart-product .btnAddToCart {
						padding: 10px 0;
					}
				}
			}
			.cart__layout_right {
				.cart__heading {
				    padding: 16px 10px;
				}
				.grid_cart {
				    padding: 10px;
				}
			}
		}
		.total {
			padding: 0 !important;
		}
		.spacing-xs-5 {
			margin: 0 -5px;
			[class*="col-"] {
				padding: 0 5px;
			}
		}
	}
}
.cart__footer {
	.cart-note__input {
		font-family: $font-family-default;
		font-size: 1.4rem;
		color: $color-heading-sub;
		font-weight: 400;
		@include placeholder {
			font-family: $font-family-default;
			font-size: 1.4rem;
			color: $color-heading-sub;
			font-weight: 400;
		}
	}
	.cart__subtotal-title {
		font-family: $font-family-primary;
		font-size: 1.6rem;
		color: $color-heading-second;
		font-weight: 700;
	}
	.cart__subtotal {
		font-size: 22px;
