// Vinova Collection Tabs 	 =========================================================================================================== 
.section-collection-tabs {
	.nov-collection-tabs {
		.grid--view-items>[class*='col-'] {
			@include animation(fadeInUp 1s ease both 0s);
		}
		.title_block {
			font-size: 2.4rem;
			margin: 0;
			font-family: $font-family-primary;
			font-weight: 600;
			color: $color-heading;
			text-transform: capitalize;
		}
		.sub_title {
			display: block;
			font-family: $font-family-default;
			font-size: 13px;
			color: $color-heading-sub;
			font-weight: 400;
			margin: 0 auto;
			line-height: 20px;
			margin-top: 6px;
		}
		.box-tab {
			margin-bottom: 36px;
			.list-menu {
			    border-bottom: 1px solid #eee;
	  			@include flexbox();
	  			@include align-items(center);
			}
			.nav-tabs {
				border: none;
				.nav-item {
					cursor: pointer;
					white-space: nowrap;
					&:not(:last-child) {
						@include rtl-margin-right(50px);
					}
					.nav-link {
						position: relative;
						font-size: 1.4rem;
						font-family: $font-family-primary;
						font-weight: 600;
						text-transform: uppercase;
						border: none;
						padding: 0 0 15px;
						&:before {
							content: '';
						    display: block;
						    width: 0;
						    height: 3px;
						    background: $theme-color-primary;
						    position: absolute;
						    bottom: -1px;
						    @include rtl-left(50%);
						    @include translateX(-50%);
						    @include transition(all 0.3s linear);
						}
						&:hover, &.active {
							color: $color-heading !important;
							&:before {
								width: 100%;
								@include transition(all 0.3s linear);
							}
						}
					}
				}
			}
		}
		.block_margin {
		    margin: 0 -30px;
		}
	  	.collection-carousel {
	  		position: initial;
	  		.item {
	  			padding: 15px;
	  		}
			.slick-dots {
				position: absolute;
				bottom: 0;
				@include rtl-left(50%);
				@include translateX(-50%);
				line-height: 0;
				li {
					@include square(17px);
					button {
						@include square(17px);
						&:before {
							@include square(17px);
							background: $theme-color-hover;
						}
					}
					&.slick-active, &:hover {
						button::before {
							background: $theme-color-success;
						}
					}
				}
			}
			.slick-arrow {
				@include square(32px);
				line-height: 32px;
				position: absolute;
				top: -73px;
				@include translateY(0);
				@include border-radius(2px);
				border: 1px solid #eee;
				background: #eee;
				text-align: center;
				i {
					font-size: 1.8rem;
					font-weight: 400;
				}
				&.arrow-prev {
					@include rtl-right(37px);
				}
				&.arrow-next {
					@include rtl-right(0);
				}
				&:hover {
					@include box-shadow(none);
					border: 1px solid $theme-color-hover;
					background: $theme-color-hover;
					i {
						color: $color-white;
					}
				}
			}
		}
	    .tab-pane:not(:first-child) {
	    	position: absolute;
	    	@include square(100%);
	    	top: 0;
	    	@include rtl-left(0);
	    }
	  	.item-product {
	  		.formAddToCart {
	  			.btnAddToCart {
	  				background: #f2f2f2;
	  				padding: 11.5px 35px;
	  				&:hover {
	  					background: $theme-color-hover;
	  					@include box-shadow(0 0 5px 0 rgba(0,0,0,0.2));
	  				}
	  			}
	  		}
	  		&:hover {
	  			.product__info {
	  				@include opacity(1);
	  				visibility: visible;
	  				z-index: 9;
	  			}
	  		}
	  	}
	  	.loadmore {
	  		text-align: center;
	  		margin-top: 12px;
	  		span {
	  			@include display(inline-block);
	  			border: 1px solid #000;
	  			font-family: $font-family-primary;
	  			font-size: 12px;
	  			font-weight: bold;
	  			text-transform: uppercase;
	  			color: $color-heading;
	  			padding: 12px 62px 8px;
	  			cursor: pointer;
	  			@include transition(all 0.35s);
	  			@include box-shadow(0 -4px 5px rgba(#000, 0.15));
	  			&:hover {
	  				color: $color-white;
	  				background: $color-white;
	  			}
	  		}
	  	}
	  	.slick-dots {
	  		bottom: -62px;
	  		@include rtl-left(50%);
	  		@include translateX(-50%);
	  		z-index: 2;
	  	}
	  	&.nov-collection-tabs-slider {
			.product-tabs-content {
				position: relative;
              	.tab-content {
                  display: none;
                  &.active {
                    display: block;
                  }
                }
              	&>.tab-pane {
					display: block;
				}
			}
	        .show_all {
	        	margin: 40px 0 21px;
	        	a {
	        		font-family: $font-family-primary;
	        		font-size: 1.4rem;
	        		font-weight: 500;
	        		color: $color-heading;
	        		background: $color-white;
	        		@include border-radius(0);
	        		padding: 8.5px 0;
	        		min-width: 144px;
	        		border: 1px solid #f3f3f3;
	        		&:hover {
	        			background: $theme-color-primary;
	        			border: 1px solid $theme-color-primary;
	        			color: $color-white;
	        			@include box-shadow(0 2px 0 rgba(0,0,0,0.2));
	        		}
	        	}
	        }
      	}
	  	&.nov-collection-tabs-grid {
	  		.item-scale:hover {
	  			@include transition(all 0.3s linear);
	  			@include scale(1.06, 1.06);
	  		}
	  		.item-product {
	  			margin-bottom: 30px;
	  		}
	  	}
  	}
  	@media (max-width: 1599px) and (min-width: 1200px) {
		.nov-collection-tabs .item-product {
			.formAddToCart .btnAddToCart {
			    min-width: 180px;
			    padding: 0;
			}
			.product__info {
			    padding: 0 5px;
			}
		}
	}
  	@media (max-width: 1439px) and (min-width: 1200px) {
		.nov-collection-tabs .item-product {
			.formAddToCart .btnAddToCart {
			    min-width: 180px;
			    padding: 0;
			}
			.product__info {
			    padding: 0 5px;
			}
		}
	}
	@media (max-width: 991px) {
		.distance {
		    padding-bottom: 60px !important;
		}
		.nov-collection-tabs {
			.box-tab {
			    margin-bottom: 20px;
			}
			.collection-carousel .slick-arrow {
			    top: -60px;
			}
		}
	}
	@media (max-width: 767px) {
		.nov-collection-tabs {
			.nav-tabs {
				overflow-x: scroll;
				overflow-y: hidden;
				@include flex-wrap(inherit);
				@include justify-content(initial);
			}
			.list-menu {
			    margin-top: 10px;
			}
			.box-tab {
				margin-bottom: 0;
				.nav-tabs .nav-item .nav-link:before {
			    	bottom: 1px;
				}
			}
			.collection-carousel .slick-arrow {
		    	top: -40px;
			}
		}
	}
	@media (max-width: 575px) {
		.distance {
		    padding-bottom: 30px !important;
		}
		.nov-collection-tabs {
			.sub_title {
				width: 100%;
			}
			.box-tab {
				margin-bottom: 0;
				.nav-tabs .nav-item {
					&:not(:last-child) {
					    @include rtl-margin-right(30px);
					}
				}
			}
			.collection-carousel {
				margin: 0 -5px;
				.item {
				    padding: 15px 5px;
				}
			}
			.item-product {
				.product__info {
					margin-bottom: 10px;
					.product__price {
						margin-bottom: 10px;
					}
				}
				.formAddToCart .btnAddToCart {
					padding: 8px 0;
	    			min-height: 35px;
				    min-width: 125px;
				}
			}
			&.nov-collection-tabs-slider {
				.grid--view-items {
					margin: 0 -5px;
				}
				.tab-content>.tab-pane .item {
					padding: 5px;
				}
			}
			.slick-dots {
				display: none !important;
			}
		}
	}
}

@include keyframes(fadeInUp) {
	from {
		@include opacity(0);
		transform: translate3d(0, 100%, 0);
	}
	to {
		@include opacity(1);
		@include transform(none);
	}
}

// Collection group vertical nav
.nov-collection-group {
	.title_block {
		font-family: 'Playfair Display', serif;
		line-height: 20px;
		@include flexbox();
		font-weight: 500;
		margin: 21px 0 43px 0;
	}
	.block_tabs {
		@include flexbox();
		@include justify-content(space-between);
		.nav-tabs {
			border: none;
			margin-top: 26px;
			padding: 0;
			list-style-type: none;
			.nav-item {
				margin: 0;
				.nav-link {
					font-family: $font-family-primary;
					font-size: 1.8rem;
					font-weight: 500;
					color: $color-heading;
					background: $color-white;
					border: none;
					padding: 0;
					line-height: 13px;
					padding: 0 30px;
					&.active, &:hover {
						color: $theme-color-hover;
						background: $color-white;
						border: none;
					}
					&:last-child {
						@include rtl-padding-right(0);
					}
				}
				&:not(:last-child) {
					.nav-link {
						padding: 0 30px;
						@include rtl-border-right(1px solid #d7d7d7);
						&.active {
							@include rtl-border-right(1px solid #d7d7d7);
						}
					}
				}
			}
		}
	}
	.img_slider {
		.owl-dots {
			position: absolute;
			@include rtl-left(50%);
			@include translateX(-50%);
			margin: 0!important;
			bottom: 15px;
			.owl-dot {
				span {
					@include square(16px);
					background: rgba(255,255,255, 0.5);
					margin: 5px;
				}
				&.active {
					span {
						background: $color-white;
					}
				}
			}
		}
	}
	.banner-vertical {
		padding-top: 15px;
	}
	.product-tabs-vertical {
		.product_slider {
			position: relative;
			z-index: 9;
			.nov-slick-carousel {
				overflow: inherit;
				.slick-slide {
					&:not(.slick-active) {
						@include opacity(0);
					}
				}
				.slick-active:last-child {
					background: $color-white;
				}
				.item {
					padding: 15px;
					border: 1px solid $color-white;
					.item-product {
						background: $color-white;
						border: none;
					}
					&:hover {
						position: relative;
						z-index: 9;
						border: 1px solid $theme-color-hover;
					}
				}
			}
			.item-product {
				.thumbnail-container {
					img {
						margin: auto;
					}
				}
				.product__info {
					.product__title {
						margin-bottom: 3px;
						margin-top: 0;
						padding-top: 14px;
					}
					.product__review {
						margin-bottom: 2px;
					}
				}
				&:hover {
					.group-buttons {
						bottom: 74px;
					}
				}
			}
			&.tab-content {
				position: relative;
				&>.tab-pane {
					@include display(block);
					visibility: hidden;
					&:not(:first-child) {
						position: absolute;
						width: 100%;
						height: 100%;
						top: 30px;
						@include rtl-left(0);
					}
					&.active {
						visibility: visible;
					}
				}
			}
		}
	}
	@media(max-width: 1199px) {
		.product-tabs-vertical {
			@include flex-wrap(wrap);
		}
		.img_slider {
			width: 36%;
			@include flex(0 0 36%);
			position: relative;
			z-index: 99;
		}
		.product_slider {
			.item-product {
				.thumbnail-container img {
					max-width: 100%;
				}
				.product__info {
					padding: 3px 0 15px;
				}
				&:hover {
					.group-buttons {
						bottom: 90px;
					}
				}
			}
		}
		.nav .block_banner {
			min-height: 424px;
		}
	}
	@media(max-width: 991px) {
		.block_tabs {
			@include display(block);
		}
		.title_block {
			margin: 21px 0 25px;
			@include rtl-margin-lr(30px,0);
		}
		.nav-tabs {
			margin-bottom: 15px;
		}
		.flex-row-reverse {
			.img_slider {
				position: relative;
				z-index: 99;
			}
		}
		.banner-vertical {
			@include flexbox();
			img {
				margin: 0 auto;
			}
		}
		.product_slider .item-product {
			.product__info {
				.product__review .spr-badge-caption {
					@include display(none);
				}
				.product__price {
					font-size: 14px;
					s.product-price__price {
						font-size: 12px;
					}
				}
			}
			.group-buttons {
				@include display(none);
			}
		}
		.nav .block_banner {
			min-height: 453px;
			margin-top: 82px;
		}
	}
	@media(max-width: 767px) {
		.product-tabs-vertical .title_block {
			margin: 30px 0;
		}
		.img_slider, .product_slider {
			width: 100%;
			@include flex(0 0 100%);
			padding: 0;
			.flex-row-reverse {
				-webkit-box-orient: vertical!important;
				-webkit-box-direction: normal!important;
				-webkit-flex-direction: column!important;
				-ms-flex-direction: column!important;
				flex-direction: column!important;
			}
		}
		.nav .block_banner {
			min-height: 529px;
			margin-top: 0px;
		}
		.product-tabs-vertical {
			.product_slider {
				.row {
					margin: 0 -7.5px;
				}
				.nov-slick-carousel .item {
					padding: 15px 7.5px;
				}
			}
		}
	}
	@media (max-width: 575px) {
		.title_block {
			font-size: 1.7rem;
			margin: 21px 0 25px 0;
			&:before {
				@include rtl-margin-right(20px);
			}
		}
		.block_tabs .nav-tabs {
			overflow-x: scroll;
		    // @include justify-content(inherit !important);
		    @include flex-wrap(inherit !important);
		    .nav-item {
		    	position: relative;
		    	cursor: pointer;
		    	white-space: nowrap;
		    }
		  }
		  .banner-vertical {
		  	@include display(block);
		  }
		}
		@media (max-width: 425px) {
			.nav .block_banner {
				min-height: 350px;
			}
		}
	}

// Collection link
.nov-group-collection-tabs {
	.title_block {
		font-size: 26px;
		margin-bottom: 5px;
	}
	.nav-tab {
		margin-bottom: 45px;
		li {
			position: relative;
			&:not(:last-child) {
				@include rtl-margin-right(20px);
				&:before {
					content: "";
					position: absolute;
					width: 1px;
					height: 70%;
